.community-page { padding-top: 0; }
.community-hero {
  position: relative;
  overflow: hidden;
  margin: 0 -28rpx 28rpx;
  padding: 28rpx 28rpx 44rpx;
  background:
    radial-gradient(circle at 90% 5%, rgba(198, 163, 105, 0.26), transparent 34%),
    linear-gradient(145deg, #0d1712, #234031 66%, #101512);
  color: #fff;
}
.community-hero::after {
  position: absolute;
  right: -100rpx;
  bottom: -180rpx;
  width: 360rpx;
  height: 360rpx;
  border: 1rpx solid rgba(210, 171, 115, 0.22);
  border-radius: 50%;
  content: "";
}
.community-hero__watermark {
  position: absolute;
  right: -28rpx;
  bottom: -36rpx;
  width: 260rpx;
  height: 260rpx;
  opacity: .12;
  pointer-events: none;
}
.community-hero__brand {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.community-hero__badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.community-hero__content {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  max-width: 640rpx;
}
.community-hero__logo {
  display: block;
  width: 78%;
  max-width: 460rpx;
  margin: 0 0 8rpx;
  background: transparent;
}
.community-hero__kicker {
  display: block;
  margin-top: 18rpx;
  color: #c8a675;
  font-size: 21rpx;
  letter-spacing: 4rpx;
}
.community-hero__title {
  display: block;
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.community-hero__copy {
  display: block;
  margin-top: 14rpx;
  max-width: 520rpx;
  color: #d2cec8;
  font-size: 24rpx;
  line-height: 1.55;
}


.activity-section-head {
  display: flex;
  margin: 0 2rpx 18rpx;
  align-items: flex-end;
  justify-content: space-between;
}
.activity-section-head view text { display: block; }
.activity-section-head view text:first-child {
  color: #203a2b;
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 650;
}
.activity-section-head view text:last-child {
  margin-top: 6rpx;
  color: #718176;
  font-size: 19rpx;
}
.activity-list { display: grid; gap: 22rpx; }
.activity-card {
  display: flex;
  overflow: hidden;
  width: 100%;
  min-height: 238rpx;
  margin: 0;
  padding: 0;
  flex-direction: row;
  align-items: stretch;
  border: 1rpx solid rgba(205, 177, 118, .34);
  border-radius: 24rpx;
  background: linear-gradient(145deg, #315d46, #214635 74%, #172c21);
  color: #fff;
  text-align: left;
  box-shadow: 0 14rpx 34rpx rgba(27, 65, 44, .16), inset 0 1rpx rgba(255, 255, 255, .09);
}
.activity-card::after { border: 0; }
.activity-card--hover { opacity: .92; transform: scale(.993); }

.community-member-mask { position: fixed; z-index: 100; inset: 0; display: flex; padding: 30rpx; align-items: flex-end; background: rgba(9, 19, 13, .66); backdrop-filter: blur(8rpx); }
.community-member-sheet { position: relative; width: 100%; padding: 46rpx 42rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #fffefb; box-shadow: 0 -18rpx 56rpx rgba(0, 0, 0, .22); text-align: center; }
.community-member-close { position: absolute; top: 20rpx; right: 24rpx; width: 58rpx; height: 58rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: rgba(43, 39, 34, .06); color: #79716a; font-size: 34rpx; line-height: 56rpx; }
.community-member-close::after, .community-member-authorize::after { border: 0; }
.community-member-kicker, .community-member-title, .community-member-copy, .community-member-note { display: block; }
.community-member-kicker { color: #5a806a; font-size: 17rpx; font-weight: 700; letter-spacing: 3.5rpx; }
.community-member-title { margin-top: 14rpx; color: #1e3829; font-family: "Songti SC", "STSong", serif; font-size: 42rpx; font-weight: 600; }
.community-member-copy { margin-top: 14rpx; color: #706860; font-size: 22rpx; line-height: 1.6; }
.community-member-logo { display: block; width: 108rpx; height: 108rpx; margin: 26rpx auto 20rpx; border: 1rpx solid rgba(49, 93, 70, .2); border-radius: 50%; background: #000; }
.community-member-agreement { display: flex; min-height: 62rpx; align-items: flex-start; color: #675f57; font-size: 21rpx; line-height: 1.55; text-align: left; gap: 10rpx; }
.community-member-agreement checkbox { flex: 0 0 auto; margin-top: 1rpx; transform: scale(.86); }
.community-member-agreement .wx-checkbox-input { width: 34rpx; height: 34rpx; border: 1rpx solid #bdb5ac; border-radius: 50%; }
.community-member-agreement .wx-checkbox-input.wx-checkbox-input-checked { border-color: #315d46; background: #315d46; }
.community-member-agreement view { flex: 1; min-width: 0; }
.community-member-terms { display: block; color: #315d46; }
.community-member-authorize { width: 100%; min-height: 88rpx; margin: 24rpx 0 0; border: 1rpx solid #315d46; border-radius: 44rpx; background: #315d46; color: #fff; font-size: 24rpx; font-weight: 700; line-height: 88rpx; }
.community-member-authorize--disabled { border-color: #c5c1ba; background: #c5c1ba; }
.community-member-note { margin-top: 16rpx; color: #90877e; font-size: 18rpx; line-height: 1.55; }

.activity-art {
  position: relative;
  overflow: hidden;
  flex: 0 0 236rpx;
  width: 236rpx;
  min-height: 238rpx;
  border-right: 1rpx solid rgba(234, 213, 171, .2);
  background: radial-gradient(circle at 74% 20%, rgba(223, 190, 126, .25), transparent 35%), linear-gradient(145deg, #294f3b, #152b20);
}
.activity-art > image:first-child,
.activity-placeholder,
.activity-art__shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.activity-placeholder {
  display: flex;
  padding: 22rpx;
  flex-direction: column;
  justify-content: flex-end;
  gap: 10rpx;
  background: radial-gradient(circle at 72% 18%, rgba(222, 190, 126, .24), transparent 34%), linear-gradient(145deg, #2a503b, #234433);
  color: #fffefa;
}
.activity-placeholder image {
  width: 72rpx;
  height: 72rpx;
  opacity: .78;
}
.activity-placeholder text {
  display: -webkit-box;
  overflow: hidden;
  font-family: "Songti SC", "STSong", serif;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.3;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.activity-art__shade {
  background: linear-gradient(to bottom, rgba(8, 24, 16, .05), rgba(8, 24, 16, .52));
}
.activity-art__top {
  position: absolute;
  z-index: 1;
  top: 18rpx;
  right: 18rpx;
  left: 18rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}
.activity-art__top text {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(234, 213, 171, .34);
  background: rgba(20, 49, 34, .78);
  color: #ead5a8;
  font-size: 16rpx;
  font-weight: 700;
}
.activity-art__top text:last-child {
  background: rgba(238, 224, 193, .94);
  border-color: rgba(238, 224, 193, .94);
  color: #234a36;
}

.activity-card__body {
  display: flex;
  min-width: 0;
  flex: 1;
  padding: 22rpx 22rpx 20rpx;
  flex-direction: column;
  justify-content: center;
}
.activity-card__body text { display: block; }
.activity-sequence {
  color: #ddc390;
  font-size: 15rpx;
  font-weight: 750;
  letter-spacing: 1.3rpx;
}
.activity-title {
  display: -webkit-box !important;
  overflow: hidden;
  margin-top: 7rpx;
  color: #fff;
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.28;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.activity-summary {
  display: -webkit-box !important;
  overflow: hidden;
  margin-top: 7rpx;
  color: rgba(255, 255, 255, .7);
  font-size: 19rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}
.activity-date {
  overflow: hidden;
  margin-top: 9rpx;
  color: rgba(255, 255, 255, .8);
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.activity-footer {
  display: flex;
  margin-top: 12rpx;
  padding-top: 11rpx;
  align-items: center;
  flex-wrap: wrap;
  justify-content: space-between;
  border-top: 1rpx solid rgba(255, 255, 255, .15);
  gap: 6rpx 10rpx;
}
.activity-fee {
  min-width: 0;
  flex: 1 1 auto;
  color: #f0d8a7;
  font-size: 24rpx;
  font-weight: 800;
}
.activity-payment-state {
  max-width: 100%;
  overflow: hidden;
  flex: 1 1 100%;
  color: rgba(255, 255, 255, .72);
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.activity-footer > text:last-child {
  flex: 0 0 auto;
  color: #f0d8a7;
  font-size: 18rpx;
  font-weight: 700;
}

@media (max-width: 390px) {
  .community-hero { padding: 28rpx 22rpx 30rpx; }
  .community-hero__logo { width: 78%; }
  .community-hero__title { font-size: 42rpx; }
  .activity-card { min-height: 216rpx; flex-direction: row; }
  .activity-art { flex: 0 0 204rpx; width: 204rpx; min-height: 216rpx; }
  .activity-card__body { padding: 18rpx 18rpx 16rpx; }
  .activity-title { font-size: 27rpx; }
  .activity-summary { display: none !important; }
  .activity-date { font-size: 17rpx; }
  .activity-fee { font-size: 22rpx; }
}
