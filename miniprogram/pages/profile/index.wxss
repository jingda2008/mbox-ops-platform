.profile-page {
  padding: 0 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #f7f4ef;
  min-height: 100vh;
  box-sizing: border-box;
}

.profile-hero {
  position: relative;
  overflow: hidden;
  margin: 0 -28rpx 24rpx;
  padding: 28rpx 28rpx 40rpx;
  background:
    radial-gradient(circle at 90% 5%, rgba(198, 163, 105, 0.26), transparent 34%),
    linear-gradient(145deg, #0d1712, #234031 66%, #101512);
  color: #fff;
}
.profile-hero::after {
  position: absolute;
  right: -100rpx;
  bottom: -180rpx;
  width: 360rpx;
  height: 360rpx;
  border: 1rpx solid rgba(210, 171, 115, 0.22);
  border-radius: 50%;
  content: "";
}
.profile-hero__brand {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.profile-hero__badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.profile-hero__content {
  position: relative;
  z-index: 1;
  margin-top: 36rpx;
  max-width: 620rpx;
}
.profile-hero__kicker {
  display: block;
  color: #c8a675;
  font-size: 21rpx;
  letter-spacing: 4rpx;
}
.profile-hero__title {
  display: block;
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.profile-hero__copy {
  display: block;
  margin-top: 14rpx;
  color: #d2cec8;
  font-size: 24rpx;
  line-height: 1.55;
}

.identity-card {
  display: flex;
  padding: 28rpx 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border: 1rpx solid #ddd6cb;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(33, 27, 22, 0.06);
}
.identity-main {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 18rpx;
}
.identity-avatar {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 50%;
  background: #efe8dc;
}
.identity-copy { min-width: 0; flex: 1; }
.identity-name-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}
.identity-name {
  color: #211e1a;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}
.identity-badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #efe6d6;
  color: #7a5a32;
  font-size: 18rpx;
  font-weight: 700;
}
.identity-sub {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #8a8278;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.identity-action {
  width: auto;
  min-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  flex: 0 0 auto;
  border-radius: 999rpx;
  background: #315d46;
  color: #fff;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 64rpx;
}
.identity-action::after { border: 0; }

.metric-card {
  display: flex;
  margin-top: 16rpx;
  padding: 22rpx 8rpx;
  border: 1rpx solid #ddd6cb;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(33, 27, 22, 0.06);
}
.metric-item {
  display: flex;
  width: auto;
  margin: 0;
  padding: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #211e1a;
  line-height: 1.2;
}
.metric-item::after { border: 0; }
.metric-value {
  font-size: 36rpx;
  font-weight: 750;
  color: #203a2b;
}
.metric-label {
  margin-top: 8rpx;
  color: #8a8278;
  font-size: 20rpx;
}

.benefit-tip {
  display: flex;
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #0d1712, #234031 70%);
  color: #fff;
}
.benefit-tip view text { display: block; }
.benefit-tip view text:first-child { font-size: 26rpx; font-weight: 700; }
.benefit-tip view text:last-child { margin-top: 6rpx; color: rgba(255,255,255,.82); font-size: 20rpx; }
.benefit-tip > text { flex: 0 0 auto; font-size: 22rpx; font-weight: 650; }

.module-card {
  margin-top: 16rpx;
  padding: 26rpx 22rpx 22rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid #ddd6cb;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(33, 27, 22, 0.06);
}
.module-eyebrow {
  display: block;
  color: #a78958;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}
.module-title {
  display: block;
  margin-top: 8rpx;
  color: #211e1a;
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 650;
}
.module-head {
  display: flex;
  margin-bottom: 4rpx;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}
.module-link {
  color: #315d46;
  font-size: 22rpx;
  font-weight: 650;
}

.service-module .module-title { margin-bottom: 16rpx; }
.service-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  box-sizing: border-box;
  padding: 4rpx;
  border-radius: 18rpx;
  background: #ebe6de;
}
.service-chip {
  box-sizing: border-box;
  width: 50%;
  max-width: 50%;
  min-width: 0;
  padding: 4rpx;
}
.service-chip__face {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #fff;
  color: #211e1a;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  box-shadow: 0 4rpx 14rpx rgba(36, 29, 22, 0.06);
}
.service-chip--hover {
  opacity: 0.82;
}

.join-module .join-summary {
  display: block;
  margin: 12rpx 0 18rpx;
  color: #6f675e;
  font-size: 22rpx;
  line-height: 1.5;
}
.join-agree-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #4a564f;
  font-size: 22rpx;
}
.join-agree-links {
  margin: 8rpx 0 18rpx 46rpx;
  color: #315d46;
  font-size: 22rpx;
}
.join-primary {
  width: 100%;
  min-height: 84rpx;
  margin: 0;
  border-radius: 42rpx;
  background: #315d46;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 84rpx;
}
.join-primary::after { border: 0; }
.join-secondary {
  width: 100%;
  min-height: 84rpx;
  margin: 14rpx 0 0;
  border: 1rpx solid #c5d4cb;
  border-radius: 42rpx;
  background: #fff;
  color: #315d46;
  font-size: 24rpx;
  line-height: 82rpx;
}
.join-secondary::after { border: 0; }
.recovery-result {
  display: block;
  margin-top: 12rpx;
  color: #6f675e;
  font-size: 20rpx;
}

.progress-line {
  display: block;
  margin-top: 12rpx;
  color: #55615a;
  font-size: 22rpx;
  line-height: 1.45;
}
.expiry-row {
  display: flex;
  margin-top: 14rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #8a6a3d;
  font-size: 22rpx;
}
.expiry-row button {
  width: auto;
  min-height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: #315d46;
  color: #fff;
  font-size: 20rpx;
  line-height: 56rpx;
}
.expiry-row button::after { border: 0; }
.progress-warn {
  display: block;
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: #f7f0e6;
  color: #8a6a3d;
  font-size: 20rpx;
  line-height: 1.4;
}

.list-row {
  display: flex;
  width: 100%;
  min-height: 96rpx;
  margin: 10rpx 0 0;
  padding: 16rpx 0;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid #ebe5dc;
  background: transparent;
  color: #2a3830;
  text-align: left;
}
.list-row::after { border: 0; }
.list-row view { min-width: 0; flex: 1; }
.list-row view text { display: block; }
.list-row view text:first-child { font-size: 26rpx; font-weight: 650; }
.list-row view text:last-child { margin-top: 6rpx; color: #8a8278; font-size: 20rpx; }
.list-row > text { flex: 0 0 auto; color: #315d46; font-size: 22rpx; }

.benefit-scroll,
.redemption-scroll,
.member-content-scroll { width: 100%; margin-top: 12rpx; }
.benefit-row,
.redemption-row,
.member-content-row {
  display: flex;
  padding-bottom: 6rpx;
  gap: 12rpx;
}
.benefit-card,
.redemption-card {
  display: flex;
  width: 400rpx;
  min-height: 280rpx;
  padding: 22rpx;
  flex: 0 0 auto;
  flex-direction: column;
  border: 1rpx solid #ebe5dc;
  border-radius: 18rpx;
  background: #fbf8f2;
}
.benefit-card__head,
.redemption-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}
.benefit-card__head text:first-child,
.redemption-card__head text:first-child {
  color: #315d46;
  font-size: 18rpx;
  font-weight: 750;
}
.benefit-card__head text:last-child,
.redemption-card__head text:last-child {
  color: #8a8278;
  font-size: 18rpx;
}
.benefit-title {
  margin-top: 8rpx;
  color: #211e1a;
  font-size: 28rpx;
  font-weight: 700;
}
.benefit-description,
.redemption-description {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #6f675e;
  font-size: 20rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.benefit-foot,
.redemption-meta {
  display: flex;
  margin-top: auto;
  padding-top: 14rpx;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10rpx;
}
.benefit-foot > view text,
.redemption-meta text {
  display: block;
  color: #8a8278;
  font-size: 18rpx;
}
.benefit-foot button,
.redemption-card button {
  width: auto;
  min-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 32rpx;
  background: #315d46;
  color: #fff;
  font-size: 20rpx;
  line-height: 64rpx;
}
.benefit-foot button::after,
.redemption-card button::after { border: 0; }
.redemption-card button[disabled] {
  background: #d5ddd8;
  color: #7a857e;
}
.redemption-history { margin-top: 12rpx; border-top: 1rpx solid #ebe5dc; }
.redemption-history__row {
  display: flex;
  min-height: 88rpx;
  padding: 12rpx 0;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #ebe5dc;
  gap: 12rpx;
}
.redemption-history__row view text { display: block; }
.redemption-history__row view text:first-child { font-size: 24rpx; font-weight: 650; }
.redemption-history__row view text:last-child { margin-top: 4rpx; color: #8a8278; font-size: 18rpx; }
.redemption-history__row button {
  width: auto;
  min-height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #c5d4cb;
  border-radius: 28rpx;
  background: #fff;
  color: #315d46;
  font-size: 20rpx;
  line-height: 54rpx;
}
.redemption-history__row button::after { border: 0; }

.restriction-list { margin-top: 8rpx; }
.restriction-row {
  display: flex;
  min-height: 88rpx;
  padding: 12rpx 0;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #ebe5dc;
  gap: 12rpx;
}
.restriction-row view text { display: block; }
.restriction-row view text:first-child { font-size: 24rpx; font-weight: 650; }
.restriction-row view text:last-child { margin-top: 4rpx; color: #8a8278; font-size: 18rpx; }
.restriction-row button {
  width: auto;
  min-height: 88rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid #c5d4cb;
  border-radius: 28rpx;
  background: #fff;
  color: #315d46;
  font-size: 20rpx;
  line-height: 86rpx;
}
.restriction-row button::after { border: 0; }
.restriction-note { display: block; margin-top: 12rpx; color: #8a8278; font-size: 18rpx; line-height: 1.5; }

.points-list { margin-top: 8rpx; }
.point-row {
  display: flex;
  min-height: 84rpx;
  padding: 12rpx 0;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #ebe5dc;
  gap: 12rpx;
}
.point-row view text { display: block; }
.point-row view text:first-child { font-size: 24rpx; }
.point-row view text:last-child { margin-top: 4rpx; color: #8a8278; font-size: 18rpx; }
.point-row > text { color: #55615a; font-size: 26rpx; font-weight: 700; }
.point-row > text.positive { color: #315d46; }

.member-content-card {
  width: 420rpx;
  flex: 0 0 auto;
  overflow: hidden;
  border: 1rpx solid #ebe5dc;
  border-radius: 18rpx;
  background: #fbf8f2;
}
.member-content-image { width: 100%; height: 150rpx; background: #efe8dc; }
.member-content-copy { padding: 18rpx 20rpx 20rpx; }
.member-content-type { color: #315d46; font-size: 18rpx; font-weight: 750; }
.member-content-title {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  color: #211e1a;
  font-size: 26rpx;
  font-weight: 700;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.member-content-summary {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  color: #6f675e;
  font-size: 20rpx;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.member-content-copy button {
  width: auto;
  min-height: 88rpx;
  margin-top: 12rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: #315d46;
  color: #fff;
  font-size: 20rpx;
  line-height: 88rpx;
}
.member-content-copy button::after { border: 0; }

.error-banner,
.warning {
  margin: 0 0 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
.error-banner { background: #fdeeee; color: #a14545; }
.warning { background: #f7f0e6; color: #8a6a3d; }

@media (max-width: 350px) {
  .profile-page { padding-right: 22rpx; padding-left: 22rpx; }
  .profile-hero__title { font-size: 40rpx; }
  .metric-value { font-size: 30rpx; }
  .service-chip__face { font-size: 22rpx; }
}
