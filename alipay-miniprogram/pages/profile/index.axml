<view class="page profile-page">
  <view class="profile-hero">
    <view class="profile-hero__brand">
      <image class="profile-hero__badge" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" aria-label="M-BOX" />
      <text>M-BOX</text>
    </view>
    <view class="profile-hero__content">
      <text class="profile-hero__kicker">会员 · 我的</text>
      <text class="profile-hero__title">我的夜晚</text>
      <text class="profile-hero__copy">积分、权益与到店安排，都在这里。</text>
    </view>
  </view>

  <state-panel a:if="{{loading}}" type="loading" title="正在读取会员与权益" />
  <view a:elif="{{error}}" class="profile-load-error">
    <state-panel type="error" title="会员资料读取失败" message="{{error}}" />
    <button onTap="load">重新读取</button>
    <text>暂时无法确认会员身份，请稍后再试。</text>
  </view>
  <block a:else>
    <view a:if="{{membership}}" class="profile-member-card profile-member-card--{{membership.level}}">
      <view class="profile-member-card__glow"></view>
      <view class="profile-member-card__corner"></view>
      <view class="profile-member-card__top">
        <image src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" />
        <view class="profile-member-card__identity"><text>{{membership.levelText}}</text><text>{{membership.levelEnglish}}</text><text>{{membership.memberNo}}</text></view>
        <button onTap="openMemberCenter">会员中心 ›</button>
      </view>
      <view class="profile-member-card__progress">
        <view class="profile-member-card__progress-copy"><text>{{membership.cardGrowthText}}</text><text>{{membership.cardDifferenceText}}</text></view>
        <view a:if="{{membership.cardProgressAvailable}}" class="profile-member-card__track"><view style="width: {{membership.cardProgressPercent}}%;"></view></view>
        <view class="profile-member-card__foot"><view a:if="{{membership.cardProgressAvailable}}"><text>{{membership.cardCurrentTierText}}</text><text>{{membership.cardNextTierText}}</text></view><button onTap="openCoupons">{{membership.cardBenefitText}}</button></view>
      </view>
    </view>

    <view a:else class="identity-card">
      <view class="identity-main" onTap="onIdentityTap" hover-class="identity-main--hover">
        <image class="identity-avatar" src="{{avatarUrl || '/assets/brand/mbox-logo-badge.png'}}" mode="aspectFill" />
        <view class="identity-copy">
          <view class="identity-name-row">
            <text class="identity-name">访客</text>
          </view>
          <text class="identity-sub">加入会员，解锁积分、权益与超嗨活动</text>
        </view>
      </view>
      <button class="identity-action" onTap="focusJoinInvitation">邀请加入</button>
    </view>

    <view class="metric-card">
      <button class="metric-item" onTap="openPoints" hover-class="metric-item--hover">
        <text class="metric-icon">积</text>
        <text class="metric-value">{{membership ? membership.pointsBalance : 0}}</text>
        <view class="metric-label-row"><text class="metric-label">积分</text><text class="metric-chevron">›</text></view>
      </button>
      <button class="metric-item" onTap="openCoupons" hover-class="metric-item--hover">
        <text class="metric-icon">券</text>
        <text class="metric-value">{{benefitError ? '—' : (benefitCount || 0)}}</text>
        <view class="metric-label-row"><text class="metric-label">优惠券</text><text class="metric-chevron">›</text></view>
      </button>
      <button class="metric-item" onTap="openPoints" hover-class="metric-item--hover">
        <text class="metric-icon">升</text>
        <text class="metric-value">{{membership ? membership.growthValue : 0}}</text>
        <view class="metric-label-row"><text class="metric-label">成长值</text><text class="metric-chevron">›</text></view>
      </button>
    </view>

    <view a:if="{{membership && benefitCount}}" class="benefit-tip" onTap="openCoupons">
      <view>
        <text>你有可用权益</text>
        <text>{{benefitCount}} 项可到店使用</text>
      </view>
      <text>去看看 ›</text>
    </view>

    <view a:if="{{membership && (membership.upgradeText || membership.retainText || membership.expiryText || membership.pendingRecoveryPoints > 0)}}" class="module-card">
      <text class="module-eyebrow">会员</text>
      <text class="module-title">会员进度</text>
      <text a:if="{{membership.upgradeText}}" class="progress-line">{{membership.upgradeText}}</text>
      <text a:if="{{membership.retainText}}" class="progress-line">{{membership.retainText}}</text>
      <text a:if="{{membership.periodText}}" class="progress-line">{{membership.periodText}}</text>
      <view a:if="{{membership.expiryText}}" class="expiry-row">
        <text>{{membership.expiryText}}</text>
        <button a:if="{{expiryNotificationOption}}" onTap="enableExpiryReminder">到期提醒</button>
      </view>
      <text a:if="{{membership.pendingRecoveryPoints > 0}}" class="progress-warn">当前有 {{membership.pendingRecoveryPoints}} 积分欠额；新到账积分会优先冲抵</text>
    </view>

    <view class="module-card service-module">
      <text class="module-eyebrow">服务</text>
      <text class="module-title">我的服务</text>
      <view class="service-grid">
        <view class="service-chip" onTap="openOrders" hover-class="service-chip--hover" role="button">
          <view class="service-chip__face"><image class="service-chip__icon" src="/assets/tabbar/order-active.png" mode="aspectFit" /><view class="service-chip__copy"><text>我的订单</text><text>订单与桌账</text></view><text class="service-chip__arrow">›</text></view>
        </view>
        <view class="service-chip" onTap="openReservations" hover-class="service-chip--hover" role="button">
          <view class="service-chip__face"><image class="service-chip__icon" src="/assets/tabbar/reservations-active.png" mode="aspectFit" /><view class="service-chip__copy"><text>我的预约</text><text>到店安排</text></view><text class="service-chip__arrow">›</text></view>
        </view>
        <view class="service-chip" onTap="openSuperhighService" hover-class="service-chip--hover" role="button">
          <view class="service-chip__face"><image class="service-chip__icon" src="/assets/tabbar/community-active.png" mode="aspectFit" /><view class="service-chip__copy"><text>超嗨活动</text><text>{{registrationError ? '暂时无法读取活动记录' : (registrations.length ? '已报名 ' + registrations.length + ' 场' : '发现最新活动')}}</text></view><text class="service-chip__arrow">›</text></view>
        </view>
        <view class="service-chip" onTap="openPreferenceSettings" hover-class="service-chip--hover" role="button">
          <view class="service-chip__face"><image class="service-chip__icon" src="/assets/tabbar/profile-active.png" mode="aspectFit" /><view class="service-chip__copy"><text>我的偏好</text><text>口味与服务</text></view><text class="service-chip__arrow">›</text></view>
        </view>
        <view class="service-chip" onTap="openContact" hover-class="service-chip--hover" role="button">
          <view class="service-chip__face"><image class="service-chip__icon service-chip__icon--badge" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" /><view class="service-chip__copy"><text>联系我们</text><text>门店客服</text></view><text class="service-chip__arrow">›</text></view>
        </view>
        <view a:if="{{membershipTerms}}" class="service-chip" onTap="openMembershipBenefits" hover-class="service-chip--hover" role="button">
          <view class="service-chip__face"><image class="service-chip__icon service-chip__icon--badge" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" /><view class="service-chip__copy"><text>会员权益</text><text>等级与规则</text></view><text class="service-chip__arrow">›</text></view>
        </view>
      </view>
    </view>

    <view a:if="{{registrations.length}}" id="registered-activities" class="module-card registered-activity-module">
      <view class="module-head"><view><text class="module-eyebrow">超嗨</text><text class="module-title">已报名的超嗨活动</text></view><text class="module-link" onTap="openSuperhighTab">更多活动 ›</text></view>
      <button a:for="{{registrations}}" a:key="publicId" class="list-row activity-registration-row" data-id="{{item.activityPublicId}}" onTap="openCommunity">
        <image class="list-row__icon" src="/assets/tabbar/community-active.png" mode="aspectFit" />
        <view><text>{{item.title}}</text><text>{{item.startsText}} · {{item.partySize}}人</text></view>
        <text>{{item.statusText}} ›</text>
      </button>
    </view>

    <view a:if="{{membership}}" class="account-footer">
      <button class="logout-button" loading="{{logoutBusy}}" onTap="logoutMember">退出登录</button>
    </view>

    <view a:if="{{reservations.length}}" class="module-card">
      <text class="module-eyebrow">预约</text>
      <text class="module-title">我的预约</text>
      <button a:for="{{reservations}}" a:key="publicId" class="list-row" onTap="openReservations">
        <view><text>预约到店</text><text>{{item.title}}</text></view>
        <text>{{item.statusText}} ›</text>
      </button>
    </view>
    <view a:if="{{registrationError}}" class="warning">{{registrationError}}</view>

    <view a:if="{{benefitError}}" class="warning">{{benefitError}}</view>
    <view a:if="{{benefits.length}}" class="module-card">
      <view class="module-head"><view><text class="module-eyebrow">权益</text><text class="module-title">可用权益</text></view><text class="module-link" onTap="openCoupons">全部 ›</text></view>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="benefit-scroll">
        <view class="benefit-row">
          <view a:for="{{benefits}}" a:key="id" class="benefit-card">
            <view class="benefit-card__head"><text>{{item.typeText}}</text><text>{{item.quantityText}}</text></view>
            <text class="benefit-title">{{item.title}}</text>
            <text class="benefit-description">{{item.description}}</text>
            <view class="benefit-foot">
              <view><text a:if="{{item.valueText}}">{{item.valueText}}</text><text>有效至 {{item.validText}}</text></view>
              <button data-id="{{item.id}}" loading="{{benefitBusyId === item.id}}" onTap="requestBenefitUse">使用</button>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view a:if="{{showRedemptions}}" class="module-card">
      <text class="module-eyebrow">兑换</text>
      <text class="module-title">积分兑换</text>
      <view a:if="{{redemptionError}}" class="warning">{{redemptionError}}</view>
      <scroll-view a:if="{{redemptionItems.length}}" scroll-x enhanced show-scrollbar="{{false}}" class="redemption-scroll">
        <view class="redemption-row">
          <view a:for="{{redemptionItems}}" a:key="publicId" class="redemption-card">
            <view class="redemption-card__head"><text>{{item.name}}</text><text>{{item.minimumTier === 'gold' ? '金卡' : item.minimumTier === 'silver' ? '银卡' : '会员'}}</text></view>
            <text class="redemption-description">{{item.description}}</text>
            <view class="redemption-meta"><text>{{item.inventoryText}}</text><text a:if="{{item.availableUntilText}}">有效至 {{item.availableUntilText}}</text></view>
            <button data-id="{{item.publicId}}" disabled="{{!item.eligible}}" loading="{{redemptionBusyId === item.publicId}}" onTap="redeemItem">{{item.actionText}}</button>
          </view>
        </view>
      </scroll-view>
      <view a:if="{{redemptions.length}}" class="redemption-history">
        <view a:for="{{redemptions}}" a:key="publicId" class="redemption-history__row">
          <view><text>{{item.name}}</text><text>{{item.pointsUsed}}积分 · {{item.statusText}}</text></view>
          <button a:if="{{item.canCancel}}" data-id="{{item.publicId}}" loading="{{redemptionBusyId === item.publicId}}" onTap="cancelRedemption">取消</button>
        </view>
      </view>
    </view>

    <view a:if="{{productRestrictions.length}}" class="module-card">
      <view class="module-head"><view><text class="module-eyebrow">偏好</text><text class="module-title">不再向我推荐</text></view><text class="module-link">本人可撤回</text></view>
      <view class="restriction-list">
        <view a:for="{{productRestrictions}}" a:key="publicId" class="restriction-row">
          <view><text>{{item.productName}}</text><text>{{item.restrictionText}}</text></view>
          <button data-id="{{item.publicId}}" loading="{{restrictionBusyId === item.publicId}}" onTap="withdrawRestriction">恢复推荐</button>
        </view>
        <text class="restriction-note">“过敏或不能饮用”只用于过滤本店推荐，不代替点单前的成分核对或医疗建议。</text>
      </view>
    </view>

    <view a:if="{{points.length}}" class="module-card">
      <view class="module-head"><view><text class="module-eyebrow">积分</text><text class="module-title">最近积分</text></view><text class="module-link" onTap="openPoints">明细 ›</text></view>
      <view class="points-list">
        <view a:for="{{points}}" a:key="id" class="point-row">
          <view><text>{{item.description || '积分变动'}}</text><text>{{item.occurredAt}}</text></view>
          <text class="{{item.pointsDelta > 0 ? 'positive' : ''}}">{{item.pointsDelta > 0 ? '+' : ''}}{{item.pointsDelta}}</text>
        </view>
      </view>
    </view>

    <view a:if="{{contentCards.length}}" class="module-card">
      <text class="module-eyebrow">内容</text>
      <text class="module-title">活动与内容</text>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="member-content-scroll">
        <view class="member-content-row">
          <view a:for="{{contentCards}}" a:key="code" class="member-content-card {{contentCards.length === 1 ? 'is-single' : ''}}">
            <image a:if="{{item.imageUrl}}" class="member-content-image" src="{{item.imageUrl}}" mode="aspectFill" />
            <view a:else class="member-content-image member-content-image--placeholder">
              <image src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" aria-label="M-BOX" />
            </view>
            <view class="member-content-copy">
              <text class="member-content-type">{{item.typeText}}</text>
              <text class="member-content-title">{{item.title}}</text>
              <text class="member-content-summary">{{item.summary}}</text>
              <button a:if="{{item.hasTarget}}" data-code="{{item.code}}" onTap="openMemberContentCard">{{item.ctaLabel}}</button>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>
  <view a:if="{{loginSheetVisible}}" class="login-sheet-mask" onTap="closeLoginSheet">
    <scroll-view scroll-y class="login-sheet" catchTap="noop">
      <button class="login-sheet__close compact-icon-action" aria-label="关闭登录" onTap="closeLoginSheet">×</button>
      <text class="login-sheet__kicker">M-BOX 会员</text>
      <text class="login-sheet__title">邀请加入 M-BOX 会员</text>
      <text class="login-sheet__copy">勾选协议后，可授权支付宝手机号加入；当前后端适配尚未接通，不影响浏览、预约和点单。</text>
      <image class="login-sheet__logo" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" aria-label="M-BOX" />
      <checkbox-group onChange="onAgreementChange">
        <label class="login-agree">
          <checkbox value="agree" checked="{{agreedToPolicies}}" color="#315d46" />
          <text class="login-agree-text">我已阅读并同意</text>
          <text class="login-agree-link" catchTap="showMembershipTerms">《用户服务协议》</text>
          <text class="login-agree-text">与</text>
          <text class="login-agree-link" catchTap="openPrivacy">《隐私政策》</text>
        </label>
      </checkbox-group>
      <view class="login-actions">
        <button
          a:if="{{agreedToPolicies}}"
          class="login-action-link login-action-link--primary alipay-phone-button"
          onTap="quickLoginAndEnroll"
          hover-class="none"
          loading="{{busy}}"
        >支付宝手机号入会暂未开通</button>
        <button a:else class="login-action-link login-action-link--primary login-action-link--pending" onTap="remindAgreement">确定加入并授权手机号</button>
        <button
          a:if="{{agreedToPolicies}}"
          class="login-action-link alipay-phone-button"
          onTap="recoverMembership"
          hover-class="none"
          loading="{{recoveryBusy}}"
        >支付宝手机号找回暂未开通</button>
        <button a:else class="login-action-link login-action-link--pending" onTap="remindAgreement">找回原会员</button>
      </view>
      <text a:if="{{recoveryMessage}}" class="login-recovery-note">{{recoveryMessage}}</text>
      <text a:if="{{error}}" class="login-recovery-note login-recovery-note--error">{{error}}</text>
    </scroll-view>
  </view>
</view>
