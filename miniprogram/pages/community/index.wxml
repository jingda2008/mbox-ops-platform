<view class="page community-page">
  <view class="community-head"><text class="eyebrow">SUPERHIGH TRIBE</text><text class="community-title">去见更大的世界</text><text class="community-copy">现场音乐之外，还有城市活动、会员小聚和认真准备的特别企划。</text></view>
  <state-panel wx:if="{{loading}}" type="loading" title="正在读取活动" />
  <block wx:else>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>
    <view wx:if="{{activities.length}}" class="activity-list">
      <button wx:for="{{activities}}" wx:key="publicId" class="activity-card" data-id="{{item.publicId}}" bindtap="openDetail">
        <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
        <view wx:else class="activity-placeholder"><text>SUPER</text><text>HIGH</text></view>
        <view class="activity-overlay"></view>
        <view class="activity-content"><view class="activity-top"><text>{{item.kindText}}</text><text wx:if="{{item.registrationText}}">{{item.registrationText}}</text></view><view class="activity-bottom"><text class="activity-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="activity-summary">{{item.summary}}</text><text class="activity-date">{{item.dateText}} · {{item.assemblyLocation}}</text><view><text class="activity-fee">{{item.feeText}}</text><text class="activity-capacity">{{item.availabilityText}} · 查看详情 →</text></view></view></view>
      </button>
    </view>
    <state-panel wx:else type="empty" title="下一场正在准备" message="通过发布审批的活动会第一时间出现在这里" />
  </block>
</view>
