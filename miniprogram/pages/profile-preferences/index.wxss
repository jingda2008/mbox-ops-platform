.preferences-page{padding-top:0;padding-bottom:48rpx}.preferences-hero{margin:0 -28rpx 28rpx;padding:42rpx 28rpx 38rpx;background:radial-gradient(circle at 88% 8%,rgba(211,170,108,.24),transparent 35%),linear-gradient(145deg,#0d1712,#234031 70%,#101512);color:#fff}.preferences-hero text{display:block}.preferences-kicker{color:#c8a675;font-size:19rpx;font-weight:700;letter-spacing:4rpx}.preferences-title{margin-top:13rpx;font-family:"Songti SC","STSong",serif;font-size:46rpx;font-weight:600}.preferences-copy{margin-top:12rpx;color:#d5ddd7;font-size:22rpx;line-height:1.55}.preference-card{margin-top:16rpx;padding:24rpx;border:1rpx solid #e0d9d0;border-radius:20rpx;background:#fff}.identity-card{margin-top:0}.field-label{display:block;color:#453e37;font-size:23rpx;font-weight:700}.identity-card input,.compact-fields input{width:100%;min-height:82rpx;margin-top:14rpx;padding:0 18rpx;box-sizing:border-box;border:1rpx solid #d9d2c8;border-radius:14rpx;background:#fbfaf8;font-size:24rpx}.card-head{display:flex;margin-bottom:16rpx;align-items:center;justify-content:space-between;gap:16rpx}.card-head text:first-child{font-size:23rpx;font-weight:700}.card-head text:last-child{color:#8d847a;font-size:18rpx}.chip-grid{display:flex;flex-wrap:wrap;gap:10rpx}.option-chip{width:auto;min-height:68rpx;margin:0;padding:0 20rpx;border:1rpx solid #d9d2c8;border-radius:34rpx;background:#fbfaf8;color:#5a524a;font-size:20rpx;line-height:66rpx}.option-chip::after{border:0}.option-chip.is-selected{border-color:#315d46;background:#315d46;color:#fff}.picker-line{display:flex;min-height:82rpx;margin-top:14rpx;padding:0 18rpx;align-items:center;justify-content:space-between;border:1rpx solid #d9d2c8;border-radius:14rpx;background:#fbfaf8;font-size:24rpx}.picker-line text:last-child{color:#8a8178;font-size:34rpx}.field-note,.privacy-note{display:block;margin-top:11rpx;color:#867e75;font-size:18rpx;line-height:1.55}.compact-fields{display:grid;gap:18rpx}.compact-fields label{display:block}.compact-fields label>text{display:block;color:#453e37;font-size:22rpx;font-weight:700}.compact-fields input{margin-top:10rpx}.save-button{width:100%;min-height:94rpx;margin-top:24rpx;border-radius:16rpx;background:#315d46;color:#fff;font-size:26rpx;font-weight:700;line-height:94rpx}.privacy-note{padding:0 8rpx}@media(max-width:390px){.preferences-page{padding-right:22rpx;padding-left:22rpx}.preferences-hero{margin-right:-22rpx;margin-left:-22rpx;padding-right:22rpx;padding-left:22rpx}.preference-card{padding:20rpx}.option-chip{padding:0 16rpx}}
