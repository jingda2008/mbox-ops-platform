<view class="page community-page">
  <view class="community-hero">
    <image class="community-hero__watermark" src="/assets/brand/superhigh-mark.png" mode="aspectFit" aria-hidden="true" />
    <view class="community-hero__brand">
      <image class="community-hero__badge" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" aria-label="M-BOX" />
      <text>M-BOX</text>
    </view>
    <view class="community-hero__content">
      <image class="community-hero__logo" src="/assets/brand/superhigh-horizontal-clear.png" mode="widthFix" aria-label="SUPERHIGH" />
      <text class="community-hero__kicker">LIVE · FRIENDS · CITY</text>
      <text class="community-hero__title">超嗨部落</text>
      <text class="community-hero__copy">现场、朋友与城市活动，都在这里集合。</text>
    </view>
  </view>

  <state-panel wx:if="{{loading}}" type="loading" title="正在读取活动" />
  <block wx:else>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>
    <view wx:if="{{activities.length}}" class="activity-section-head">
      <view><text>正在发生</text><text>报名与安排以活动详情为准</text></view>
      <text>{{activities.length}}</text>
    </view>
    <view wx:if="{{activities.length}}" class="activity-list">
      <button wx:for="{{activities}}" wx:key="publicId" class="activity-card" data-id="{{item.publicId}}" bindtap="openDetail">
        <view class="activity-art">
          <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="activity-placeholder">
            <image src="/assets/brand/superhigh-mark.png" mode="aspectFit" />
            <text>{{item.title}}</text>
          </view>
          <view class="activity-art__shade"></view>
          <view class="activity-art__top">
            <text>{{item.kindText}}</text>
            <text wx:if="{{item.registrationText}}">{{item.registrationText}}</text>
          </view>
        </view>
        <view class="activity-card__body">
          <text class="activity-sequence">{{item.sequenceText}}</text>
          <text class="activity-title">{{item.title}}</text>
          <text wx:if="{{item.summary}}" class="activity-summary">{{item.summary}}</text>
          <text class="activity-date">{{item.dateText}} · {{item.assemblyLocation}}</text>
          <view class="activity-footer">
            <text class="activity-fee">{{item.feeText}}</text>
            <text>详情 →</text>
          </view>
        </view>
      </button>
    </view>
    <state-panel wx:else type="empty" title="下一场正在准备" message="通过发布审批的活动会第一时间出现在这里" />
  </block>
</view>
