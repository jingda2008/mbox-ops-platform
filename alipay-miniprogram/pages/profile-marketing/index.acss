.contact-page{box-sizing:border-box;max-width:100%;overflow-wrap:anywhere;word-break:break-word;padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}.contact-title{display:block;font-size:30rpx;font-weight:700;margin:20rpx 0 12rpx}.contact-copy{display:block;font-size:23rpx;color:#746c63;line-height:1.6;margin-top:12rpx}.contact-box{box-sizing:border-box;min-width:0;margin:18rpx 0;padding:22rpx;background:#fff;border:1rpx solid #e0d9d0;border-radius:16rpx}.contact-row{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10rpx;font-size:26rpx}.contact-status{font-size:23rpx;color:#315d46}.contact-button{box-sizing:border-box;max-width:100%;min-height:88rpx;line-height:1.5;padding:16rpx 20rpx;margin:18rpx 0;font-size:25rpx;white-space:normal;border-radius:12rpx}.contact-button.primary{background:#315d46;color:#fff}.contact-button.stop{background:#fff2e8;color:#7b342b;border:1rpx solid #d4b3a6}.contact-terms{display:block;white-space:pre-wrap;font-size:25rpx;line-height:1.7;margin:16rpx 0}.contact-choice{display:flex;align-items:center;gap:12rpx;font-size:24rpx;line-height:1.6;min-height:88rpx}.contact-choice checkbox{flex-shrink:0}.contact-message,.contact-error{display:block;font-size:24rpx;line-height:1.6;padding:18rpx;background:#edf4ee;color:#315d46}.contact-error{background:#fff0eb;color:#8b3325}
.contact-page .contact-button{width:100%;min-width:0}
