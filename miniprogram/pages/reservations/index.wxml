<view class="page reservations-page">
  <view class="top-band reservation-band"><view class="brand-row"><view class="brand"><view class="brand-mark">M</view><text>预约到店</text></view><text wx:if="{{isDevelopment}}" class="dev-badge">开发模式</text></view><text class="reservation-band__title">先确认容量，再提交安排</text><text class="reservation-band__meta">费用、定金和位置规则在提交前明确展示</text></view>
  <state-panel wx:if="{{loading}}" type="loading" title="正在读取本人预约" />
  <block wx:else>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view><view wx:if="{{success}}" class="success-banner">{{success}}</view>
    <view class="section form-section"><view class="section-title"><text>预约信息</text><text class="section-link">门店确认后生效</text></view><view class="panel reservation-form">
      <label class="field"><text class="field__label">称呼</text><input class="field__input" maxlength="100" value="{{customerName}}" placeholder="如：林女士" bindinput="onNameInput" /></label>
      <label class="field"><text class="field__label">手机号或微信</text><input class="field__input" maxlength="100" value="{{contact}}" placeholder="仅用于本次预约联系" bindinput="onContactInput" /></label>
      <label class="field"><text class="field__label">人数</text><input class="field__input" type="number" value="{{partySize}}" bindinput="onPartySizeInput" bindblur="onPartySizeConfirm" /></label>
      <view class="field-row"><label class="field"><text class="field__label">日期</text><picker mode="date" value="{{reservationDate}}" start="{{minimumDate}}" bindchange="onDateChange"><view class="picker-field">{{reservationDate}}</view></picker></label><label class="field"><text class="field__label">时间</text><picker mode="time" value="{{reservationTime}}" bindchange="onTimeChange"><view class="picker-field">{{reservationTime}}</view></picker></label></view>
      <label class="field"><text class="field__label">位置倾向</text><picker mode="selector" range="{{seatOptions}}" range-key="name" value="{{seatIndex}}" bindchange="onSeatChange"><view class="picker-field">{{seatOptions[seatIndex].name}}</view></picker></label>
      <label class="field"><text class="field__label">到店场景</text><picker mode="selector" range="{{occasionOptions}}" range-key="name" value="{{occasionIndex}}" bindchange="onOccasionChange"><view class="picker-field">{{occasionOptions[occasionIndex].name}}</view></picker></label>
      <label class="field"><text class="field__label">需要提前知道的事</text><textarea class="field__textarea" maxlength="500" value="{{occasionNote}}" placeholder="如生日称呼、商务安静沟通、希望安排互动" bindinput="onNoteInput" /></label>
      <view class="availability {{availability && availability.acceptingReservations ? 'is-available' : ''}}"><text>{{checking ? '正在确认容量…' : availabilityText}}</text><text wx:if="{{depositText}}">{{depositText}}</text></view>
      <button class="primary-button" loading="{{submitting}}" disabled="{{submitting || checking || (availability && !availability.acceptingReservations)}}" bindtap="submitReservation">确认并提交预约</button>
    </view></view>
    <view class="section"><view class="section-title"><text>我的预约</text><text class="section-link">{{reservations.length}} 条</text></view>
      <view wx:if="{{reservations.length}}" class="panel reservation-list"><view wx:for="{{reservations}}" wx:key="publicId" class="list-row reservation-row"><view class="list-row__main"><text class="list-row__title">{{item.scheduledAtText}} · {{item.partySize}}人</text><text class="list-row__meta">{{item.seatName}}</text><text wx:if="{{item.note}}" class="reservation-note">{{item.note}}</text></view><text class="status-tag status-tag--{{item.status}}">{{item.statusText}}</text></view></view>
      <state-panel wx:else type="empty" title="暂无预约" message="提交后可在本页查看门店确认状态" />
    </view>
  </block>
</view>
