{
  "name": "@mbox/ops-platform",
  "private": true,
  "version": "1.0.0-rc.6",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "db:migrate": "tsx server/migrate.ts",
    "db:verify": "node scripts/verify-database.mjs",
    "db:provision": "tsx server/provision-runtime.ts",
    "demo:performance": "tsx server/load-demo-performance.ts",
    "qr:generate": "tsx server/generate-table-qrs.ts",
    "pilot:access": "node scripts/print-pilot-access.mjs",
    "check": "npm run lint && npm run check:miniprogram && npm test && npm run build",
    "check:miniprogram": "node scripts/check-miniprogram.mjs",
    "lint": "oxlint src server",
    "test": "vitest run",
    "test:watch": "vitest",
    "evidence:capture": "node scripts/capture-release-evidence.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.0",
    "fastify": "^5.10.0",
    "lucide-react": "^1.24.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
