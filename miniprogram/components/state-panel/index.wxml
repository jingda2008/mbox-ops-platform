<view class="state state--{{type}}" role="status">
  <view class="state__mark" aria-hidden="true">{{type === 'loading' ? '···' : type === 'error' ? '!' : '—'}}</view>
  <text class="state__title">{{title}}</text>
  <text wx:if="{{message}}" class="state__message">{{message}}</text>
  <button wx:if="{{actionText}}" class="state__action" bindtap="handleAction">{{actionText}}</button>
</view>
