.tab-bar { box-sizing: content-box; position: fixed; bottom: 0; left: 0; right: 0; z-index: 20; display: flex; height: 50px; padding-bottom: env(safe-area-inset-bottom); background: #fffdfa; border-top: 1px solid #eeeae4; }
.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; min-width: 0; height: 50px; min-height: 44px; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: #817a72; line-height: 16px; font-size: 10px; }
.tab-item::after { border: 0; }
.tab-item image { width: 24px; height: 24px; }
.is-selected { color: #315d46; }
