.community-page { padding-top: 0; }
.community-hero { position: relative; overflow: hidden; margin: 0 -28rpx 32rpx; padding: 26rpx 28rpx 0; background: radial-gradient(circle at 96% 20%, rgba(251, 199, 47, .2), transparent 28%), linear-gradient(145deg, #f8fbf8, #edf5ef); color: #183d2b; }
.community-hero::before { position: absolute; inset: 0 0 auto; height: 22rpx; background: linear-gradient(90deg, #315d46 0 54%, #263e93 54% 59%, #00bfc0 59% 64%, #fb7d9d 64% 70%, #ffd136 70% 77%, #ff952f 77% 100%); content: ""; }
.community-hero__top { position: relative; z-index: 1; display: flex; padding-top: 16rpx; align-items: center; justify-content: space-between; color: #315d46; font-size: 18rpx; font-weight: 700; letter-spacing: 1rpx; }
.community-hero__top view { display: flex; align-items: center; gap: 9rpx; }.community-hero__top image { width: 44rpx; height: 44rpx; border-radius: 50%; }.community-hero__top > text { color: #687d70; font-size: 17rpx; font-weight: 600; }
.community-hero__stage { position: relative; z-index: 1; min-height: 210rpx; margin-top: 16rpx; padding: 22rpx 112rpx 16rpx 18rpx; border: 1rpx solid rgba(49, 93, 70, .13); border-radius: 28rpx 28rpx 0 28rpx; background: #fffefa; box-shadow: 0 14rpx 36rpx rgba(26, 77, 50, .09); }
.community-hero__stage::before { position: absolute; right: 32rpx; bottom: -2rpx; width: 180rpx; height: 94rpx; border-top: 2rpx solid rgba(49, 93, 70, .16); border-radius: 50% 50% 0 0; content: ""; }.community-hero__stage::after { position: absolute; left: 18rpx; bottom: 20rpx; width: 72rpx; height: 8rpx; border-radius: 999rpx; background: #315d46; content: ""; }
.community-hero__logo { display: block; width: 100%; max-width: 460rpx; height: auto; }.community-hero__mark { position: absolute; right: 6rpx; bottom: -10rpx; width: 152rpx; height: 152rpx; transform: rotate(6deg); }
.community-hero__copy { display: flex; position: relative; z-index: 1; padding: 22rpx 6rpx 21rpx; flex-direction: column; gap: 9rpx; }.community-hero__copy text:first-child { color: #244c37; font-family: "Songti SC", "STSong", serif; font-size: 31rpx; font-weight: 600; line-height: 1.35; }.community-hero__copy text:last-child { color: #527964; font-size: 17rpx; font-weight: 700; letter-spacing: 4rpx; }
.community-hero__palette { display: flex; height: 13rpx; margin: 0 -28rpx; }.community-hero__palette text { flex: 1; }.community-hero__palette text:nth-child(1) { background: #315d46; }.community-hero__palette text:nth-child(2) { background: #263e93; }.community-hero__palette text:nth-child(3) { background: #00bfc0; }.community-hero__palette text:nth-child(4) { background: #fb7d9d; }.community-hero__palette text:nth-child(5) { background: #ffd136; }.community-hero__palette text:nth-child(6) { background: #ff952f; }
.activity-section-head { display: flex; margin: 0 2rpx 18rpx; align-items: flex-end; justify-content: space-between; }.activity-section-head view text { display: block; }.activity-section-head view text:first-child { color: #203a2b; font-family: "Songti SC", "STSong", serif; font-size: 36rpx; font-weight: 650; }.activity-section-head view text:last-child { margin-top: 8rpx; color: #718176; font-size: 19rpx; }.activity-section-head > text { padding-bottom: 3rpx; color: #315d46; font-size: 21rpx; font-weight: 750; }
.activity-list { display: grid; gap: 24rpx; }.activity-card { position: relative; overflow: hidden; width: 100%; margin: 0; padding: 0; border: 1rpx solid #dce8df; border-radius: 26rpx; background: #fffdfa; color: #213328; text-align: left; box-shadow: 0 16rpx 36rpx rgba(31, 74, 47, .09); }.activity-card::after { border: 0; }.activity-art { position: relative; overflow: hidden; height: 250rpx; background: linear-gradient(145deg, #315d46, #183225); }.activity-art > image:first-child, .activity-placeholder, .activity-art__shade { position: absolute; inset: 0; width: 100%; height: 100%; }.activity-placeholder { display: flex; padding: 28rpx; flex-direction: column; justify-content: flex-end; background: radial-gradient(circle at 78% 15%, rgba(255, 209, 54, .5), transparent 23%), linear-gradient(135deg, #315d46, #202c8f 55%, #04c3c5); color: #fffefa; font-size: 44rpx; font-weight: 800; letter-spacing: -2rpx; }.activity-placeholder text:last-child { margin-top: 8rpx; color: #fff7c7; font-size: 20rpx; font-weight: 600; letter-spacing: 2rpx; }.activity-art__shade { background: linear-gradient(to bottom, rgba(4, 20, 13, .08), rgba(4, 20, 13, .1) 46%, rgba(4, 20, 13, .52)); }.activity-art__top { position: absolute; z-index: 1; top: 20rpx; right: 20rpx; left: 20rpx; display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }.activity-art__top text { padding: 8rpx 14rpx; border-radius: 999rpx; background: rgba(255, 254, 250, .92); color: #315d46; font-size: 19rpx; font-weight: 700; box-shadow: 0 4rpx 12rpx rgba(9, 38, 23, .1); }.activity-art__top text:last-child { background: #ff6671; color: #fff; }.activity-art__mark { position: absolute; z-index: 1; right: 18rpx; bottom: -17rpx; width: 128rpx; height: 128rpx; transform: rotate(-7deg); }
.activity-card__body { padding: 22rpx 24rpx 26rpx; }.activity-card__body text { display: block; }.activity-sequence { color: #315d46; font-size: 16rpx; font-weight: 750; letter-spacing: 2rpx; }.activity-title { margin-top: 7rpx; color: #203429; font-family: "Songti SC", "STSong", serif; font-size: 37rpx; font-weight: 650; line-height: 1.25; }.activity-summary { display: -webkit-box!important; overflow: hidden; margin-top: 9rpx; color: #647268; font-size: 21rpx; line-height: 1.46; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.activity-date { margin-top: 12rpx; color: #526158; font-size: 20rpx; }.activity-footer { display: flex; margin-top: 17rpx; padding-top: 15rpx; align-items: flex-end; justify-content: space-between; border-top: 1rpx solid #e4ede6; gap: 18rpx; }.activity-fee { flex: 0 0 auto; color: #315d46; font-size: 28rpx; font-weight: 800; }.activity-footer view { display: flex; min-width: 0; flex-wrap: wrap; align-items: flex-end; justify-content: flex-end; row-gap: 4rpx; column-gap: 12rpx; }.activity-footer view text { color: #6d7e72; font-size: 19rpx; }.activity-footer view text:last-child { color: #315d46; font-weight: 750; }.activity-card__palette { display: flex; height: 9rpx; }.activity-card__palette text { flex: 1; }.activity-card__palette text:nth-child(1) { background: #315d46; }.activity-card__palette text:nth-child(2) { background: #263e93; }.activity-card__palette text:nth-child(3) { background: #00bfc0; }.activity-card__palette text:nth-child(4) { background: #fb7d9d; }.activity-card__palette text:nth-child(5) { background: #ffbf27; }
@media(max-width:350px) { .community-hero { padding-right: 22rpx; padding-left: 22rpx; }.community-hero__stage { min-height: 188rpx; padding-top: 18rpx; padding-right: 96rpx; }.community-hero__mark { width: 128rpx; height: 128rpx; }.activity-art { height: 230rpx; }.activity-title { font-size: 34rpx; }.activity-summary { -webkit-line-clamp: 1; } }
