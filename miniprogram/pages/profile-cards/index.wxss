.member-cards-page{box-sizing:border-box;max-width:100%;padding-bottom:calc(32rpx + env(safe-area-inset-bottom));overflow-wrap:anywhere;word-break:break-word}.cards-heading{margin-bottom:24rpx}.cards-title{display:block;font-size:32rpx;font-weight:700}.cards-copy{display:block;font-size:23rpx;color:#746c63;line-height:1.6;margin-top:10rpx}.cards-section{display:block;font-size:28rpx;font-weight:700;margin:28rpx 0 14rpx}.cards-box{min-width:0;padding:22rpx;margin:14rpx 0;border:1rpx solid #e0d9d0;border-radius:18rpx;background:#fff;box-sizing:border-box}.cards-row{display:flex;justify-content:space-between;align-items:baseline;gap:12rpx;flex-wrap:wrap;font-size:27rpx}.cards-status{font-size:22rpx;color:#315d46}.cards-button{box-sizing:border-box;max-width:100%;min-height:88rpx;margin:16rpx 0 0;padding:14rpx 22rpx;line-height:1.5;font-size:25rpx;white-space:normal;border-radius:14rpx}.cards-button.primary{background:#315d46;color:#fff}.cards-button[disabled]{opacity:.5}.cards-actions{display:flex;gap:16rpx;flex-wrap:wrap}.cards-actions .cards-button{flex:1;min-width:160rpx}.cards-terms{display:block;white-space:pre-wrap;font-size:25rpx;line-height:1.7;margin:24rpx 0}.cards-ack{display:flex;align-items:center;font-size:24rpx;line-height:1.5;gap:10rpx}.cards-message,.cards-error{display:block;font-size:24rpx;padding:18rpx;line-height:1.5;border-radius:12rpx;background:#edf4ee;color:#315d46}.cards-error{background:#fff0eb;color:#8b3325}
.member-cards-page .cards-button{width:100%;min-width:0}.member-cards-page .cards-actions .cards-button{width:auto;flex:1 1 160rpx}
