{$MBOX_DOMAIN} {
  encode zstd gzip

  @developmentPaymentEndpoints path /api/payments/*/dev-simulate-success /api/payments/refunds/*/dev-approve-complete
  respond @developmentPaymentEndpoints 404

  reverse_proxy https://mbox-ops-validation-845187646287.asia-east1.run.app {
    header_up Host mbox-ops-validation-845187646287.asia-east1.run.app
  }
  header {
    -Server
  }
}
