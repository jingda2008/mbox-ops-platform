.account-footer {
  margin-top: 28rpx;
  padding: 8rpx 0 calc(16rpx + env(safe-area-inset-bottom));
}
.logout-button {
  width: 100%;
  min-height: 72rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #8a8278;
  font-size: 28rpx;
  line-height: 72rpx;
}
.logout-button::after { border: 0; }
