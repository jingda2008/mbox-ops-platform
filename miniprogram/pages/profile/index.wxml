<view class="page profile-page">
  <view class="profile-hero">
    <view class="profile-hero__brand">
      <image class="profile-hero__badge" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" aria-label="M-BOX" />
      <text>M-BOX</text>
    </view>
    <view class="profile-hero__content">
      <text class="profile-hero__kicker">MEMBER · PERSONAL</text>
      <text class="profile-hero__title">我的夜晚</text>
      <text class="profile-hero__copy">积分、权益与到店安排，都在这里。</text>
    </view>
  </view>

  <state-panel wx:if="{{loading}}" type="loading" title="正在读取会员与权益" />
  <block wx:else>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>

    <view class="identity-card">
      <view class="identity-main" bindtap="onIdentityTap" hover-class="identity-main--hover">
        <image class="identity-avatar" src="{{avatarUrl || '/assets/brand/mbox-logo-badge.png'}}" mode="aspectFill" />
        <view class="identity-copy">
          <view class="identity-name-row">
            <text class="identity-name">{{membership ? (displayName || membership.levelText) : '访客'}}</text>
            <text wx:if="{{membership}}" class="identity-badge">{{membership.levelText}}</text>
          </view>
          <text class="identity-sub">{{membership ? membership.memberNo : '加入会员，解锁积分、权益与超嗨活动'}}</text>
        </view>
      </view>
      <button wx:if="{{membership}}" class="identity-action" bindtap="openMemberCenter">会员中心</button>
      <button wx:else class="identity-action" bindtap="focusJoinInvitation">邀请加入</button>
    </view>

    <view class="metric-card">
      <button class="metric-item" bindtap="openPoints" hover-class="metric-item--hover">
        <text class="metric-icon">积</text>
        <text class="metric-value">{{membership ? membership.pointsBalance : 0}}</text>
        <view class="metric-label-row"><text class="metric-label">积分</text><text class="metric-chevron">›</text></view>
      </button>
      <button class="metric-item" bindtap="openCoupons" hover-class="metric-item--hover">
        <text class="metric-icon">券</text>
        <text class="metric-value">{{benefitCount || 0}}</text>
        <view class="metric-label-row"><text class="metric-label">优惠券</text><text class="metric-chevron">›</text></view>
      </button>
      <button class="metric-item" bindtap="openPoints" hover-class="metric-item--hover">
        <text class="metric-icon">升</text>
        <text class="metric-value">{{membership ? membership.growthValue : 0}}</text>
        <view class="metric-label-row"><text class="metric-label">成长值</text><text class="metric-chevron">›</text></view>
      </button>
      <button class="metric-item" bindtap="openBalance" hover-class="metric-item--hover">
        <text class="metric-icon">¥</text>
        <text class="metric-value">{{balanceText}}</text>
        <view class="metric-label-row"><text class="metric-label">余额</text><text class="metric-chevron">›</text></view>
      </button>
    </view>

    <view wx:if="{{membership && benefitCount}}" class="benefit-tip" bindtap="openCoupons">
      <view>
        <text>你有可用权益</text>
        <text>{{benefitCount}} 项可到店使用</text>
      </view>
      <text>去看看 ›</text>
    </view>

    <view wx:if="{{membership && (membership.upgradeText || membership.retainText || membership.expiryText || membership.pendingRecoveryPoints > 0)}}" class="module-card">
      <text class="module-eyebrow">STATUS</text>
      <text class="module-title">会员进度</text>
      <text wx:if="{{membership.upgradeText}}" class="progress-line">{{membership.upgradeText}}</text>
      <text wx:if="{{membership.retainText}}" class="progress-line">{{membership.retainText}}</text>
      <text wx:if="{{membership.periodText}}" class="progress-line">{{membership.periodText}}</text>
      <view wx:if="{{membership.expiryText}}" class="expiry-row">
        <text>{{membership.expiryText}}</text>
        <button wx:if="{{expiryNotificationOption}}" bindtap="enableExpiryReminder">到期提醒</button>
      </view>
      <text wx:if="{{membership.pendingRecoveryPoints > 0}}" class="progress-warn">当前有 {{membership.pendingRecoveryPoints}} 积分欠额；新到账积分会优先冲抵</text>
    </view>

    <view class="module-card service-module">
      <text class="module-eyebrow">SERVICES</text>
      <text class="module-title">我的服务</text>
      <view class="service-grid">
        <view class="service-chip" bindtap="openOrders" hover-class="service-chip--hover" role="button">
          <view class="service-chip__face"><image class="service-chip__icon" src="/assets/tabbar/order-active.png" mode="aspectFit" /><view class="service-chip__copy"><text>我的订单</text><text>订单与桌账</text></view><text class="service-chip__arrow">›</text></view>
        </view>
        <view class="service-chip" bindtap="openReservations" hover-class="service-chip--hover" role="button">
          <view class="service-chip__face"><image class="service-chip__icon" src="/assets/tabbar/reservations-active.png" mode="aspectFit" /><view class="service-chip__copy"><text>我的预约</text><text>到店安排</text></view><text class="service-chip__arrow">›</text></view>
        </view>
        <view class="service-chip" bindtap="openSuperhighService" hover-class="service-chip--hover" role="button">
          <view class="service-chip__face"><image class="service-chip__icon" src="/assets/tabbar/community-active.png" mode="aspectFit" /><view class="service-chip__copy"><text>超嗨活动</text><text>{{registrationError ? '记录待刷新' : (registrations.length ? '已报名 ' + registrations.length + ' 场' : '发现最新活动')}}</text></view><text class="service-chip__arrow">›</text></view>
        </view>
        <view class="service-chip" bindtap="openPreferenceSettings" hover-class="service-chip--hover" role="button">
          <view class="service-chip__face"><image class="service-chip__icon" src="/assets/tabbar/profile-active.png" mode="aspectFit" /><view class="service-chip__copy"><text>我的偏好</text><text>口味与服务</text></view><text class="service-chip__arrow">›</text></view>
        </view>
        <view class="service-chip" bindtap="openContact" hover-class="service-chip--hover" role="button">
          <view class="service-chip__face"><image class="service-chip__icon service-chip__icon--badge" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" /><view class="service-chip__copy"><text>联系我们</text><text>门店客服</text></view><text class="service-chip__arrow">›</text></view>
        </view>
        <view wx:if="{{membershipTerms}}" class="service-chip" bindtap="openMembershipBenefits" hover-class="service-chip--hover" role="button">
          <view class="service-chip__face"><image class="service-chip__icon service-chip__icon--badge" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" /><view class="service-chip__copy"><text>会员权益</text><text>等级与规则</text></view><text class="service-chip__arrow">›</text></view>
        </view>
      </view>
    </view>

    <view wx:if="{{registrations.length}}" id="registered-activities" class="module-card registered-activity-module">
      <view class="module-head"><view><text class="module-eyebrow">SUPERHIGH</text><text class="module-title">已报名的超嗨活动</text></view><text class="module-link" bindtap="openSuperhighTab">更多活动 ›</text></view>
      <button wx:for="{{registrations}}" wx:key="publicId" class="list-row activity-registration-row" data-id="{{item.activityPublicId}}" bindtap="openCommunity">
        <image class="list-row__icon" src="/assets/tabbar/community-active.png" mode="aspectFit" />
        <view><text>{{item.title}}</text><text>{{item.startsText}} · {{item.partySize}}人</text></view>
        <text>{{item.statusText}} ›</text>
      </button>
    </view>

    <view wx:if="{{membership}}" class="account-footer">
      <button class="logout-button" loading="{{logoutBusy}}" bindtap="logoutMember">退出登录</button>
    </view>

    <view wx:if="{{reservations.length}}" class="module-card">
      <text class="module-eyebrow">RESERVATIONS</text>
      <text class="module-title">我的预约</text>
      <button wx:for="{{reservations}}" wx:key="publicId" class="list-row" bindtap="openReservations">
        <view><text>预约到店</text><text>{{item.title}}</text></view>
        <text>{{item.statusText}} ›</text>
      </button>
    </view>
    <view wx:if="{{registrationError}}" class="warning">{{registrationError}}</view>

    <view wx:if="{{benefits.length}}" class="module-card">
      <view class="module-head"><view><text class="module-eyebrow">BENEFITS</text><text class="module-title">可用权益</text></view><text class="module-link" bindtap="openCoupons">全部 ›</text></view>
      <view wx:if="{{benefitError}}" class="warning">{{benefitError}}</view>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="benefit-scroll">
        <view class="benefit-row">
          <view wx:for="{{benefits}}" wx:key="id" class="benefit-card">
            <view class="benefit-card__head"><text>{{item.typeText}}</text><text>{{item.quantityText}}</text></view>
            <text class="benefit-title">{{item.title}}</text>
            <text class="benefit-description">{{item.description}}</text>
            <view class="benefit-foot">
              <view><text wx:if="{{item.valueText}}">{{item.valueText}}</text><text>有效至 {{item.validText}}</text></view>
              <button data-id="{{item.id}}" loading="{{benefitBusyId === item.id}}" bindtap="requestBenefitUse">使用</button>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{showRedemptions}}" class="module-card">
      <text class="module-eyebrow">REDEEM</text>
      <text class="module-title">积分兑换</text>
      <view wx:if="{{redemptionError}}" class="warning">{{redemptionError}}</view>
      <scroll-view wx:if="{{redemptionItems.length}}" scroll-x enhanced show-scrollbar="{{false}}" class="redemption-scroll">
        <view class="redemption-row">
          <view wx:for="{{redemptionItems}}" wx:key="publicId" class="redemption-card">
            <view class="redemption-card__head"><text>{{item.name}}</text><text>{{item.minimumTier === 'gold' ? '金卡' : item.minimumTier === 'silver' ? '银卡' : '会员'}}</text></view>
            <text class="redemption-description">{{item.description}}</text>
            <view class="redemption-meta"><text>{{item.inventoryText}}</text><text wx:if="{{item.availableUntilText}}">有效至 {{item.availableUntilText}}</text></view>
            <button data-id="{{item.publicId}}" disabled="{{!item.eligible}}" loading="{{redemptionBusyId === item.publicId}}" bindtap="redeemItem">{{item.actionText}}</button>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{redemptions.length}}" class="redemption-history">
        <view wx:for="{{redemptions}}" wx:key="publicId" class="redemption-history__row">
          <view><text>{{item.name}}</text><text>{{item.pointsUsed}}积分 · {{item.statusText}}</text></view>
          <button wx:if="{{item.canCancel}}" data-id="{{item.publicId}}" loading="{{redemptionBusyId === item.publicId}}" bindtap="cancelRedemption">取消</button>
        </view>
      </view>
    </view>

    <view wx:if="{{productRestrictions.length}}" class="module-card">
      <view class="module-head"><view><text class="module-eyebrow">PREFERENCE</text><text class="module-title">不再向我推荐</text></view><text class="module-link">本人可撤回</text></view>
      <view class="restriction-list">
        <view wx:for="{{productRestrictions}}" wx:key="publicId" class="restriction-row">
          <view><text>{{item.productName}}</text><text>{{item.restrictionText}}</text></view>
          <button data-id="{{item.publicId}}" loading="{{restrictionBusyId === item.publicId}}" bindtap="withdrawRestriction">恢复推荐</button>
        </view>
        <text class="restriction-note">“过敏或不能饮用”只用于过滤本店推荐，不代替点单前的成分核对或医疗建议。</text>
      </view>
    </view>

    <view wx:if="{{points.length}}" class="module-card">
      <view class="module-head"><view><text class="module-eyebrow">POINTS</text><text class="module-title">最近积分</text></view><text class="module-link" bindtap="openPoints">明细 ›</text></view>
      <view class="points-list">
        <view wx:for="{{points}}" wx:key="id" class="point-row">
          <view><text>{{item.description || '积分变动'}}</text><text>{{item.occurredAt}}</text></view>
          <text class="{{item.pointsDelta > 0 ? 'positive' : ''}}">{{item.pointsDelta > 0 ? '+' : ''}}{{item.pointsDelta}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{contentCards.length}}" class="module-card">
      <text class="module-eyebrow">CONTENT</text>
      <text class="module-title">活动与内容</text>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="member-content-scroll">
        <view class="member-content-row">
          <view wx:for="{{contentCards}}" wx:key="code" class="member-content-card">
            <image wx:if="{{item.imageUrl}}" class="member-content-image" src="{{item.imageUrl}}" mode="aspectFill" />
            <view wx:else class="member-content-image member-content-image--placeholder">
              <image src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" aria-label="M-BOX" />
            </view>
            <view class="member-content-copy">
              <text class="member-content-type">{{item.typeText}}</text>
              <text class="member-content-title">{{item.title}}</text>
              <text class="member-content-summary">{{item.summary}}</text>
              <button wx:if="{{item.hasTarget}}" data-code="{{item.code}}" bindtap="openMemberContentCard">{{item.ctaLabel}}</button>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>
  <view wx:if="{{loginSheetVisible}}" class="login-sheet-mask" catchtouchmove="noop" bindtap="closeLoginSheet">
    <view class="login-sheet" catchtap="noop">
      <button class="login-sheet__close" aria-label="关闭登录" bindtap="closeLoginSheet">×</button>
      <text class="login-sheet__kicker">M-BOX MEMBERSHIP</text>
      <text class="login-sheet__title">邀请加入 M-BOX 会员</text>
      <text class="login-sheet__copy">勾选协议后，授权微信手机号即可加入并享受积分、优惠券与活动资格。</text>
      <image class="login-sheet__logo" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" aria-label="M-BOX" />
      <checkbox-group bindchange="onAgreementChange">
        <label class="login-agree">
          <checkbox value="agree" checked="{{agreedToPolicies}}" color="#315d46" />
          <text class="login-agree-text">我已阅读并同意</text>
          <text class="login-agree-link" catchtap="showMembershipTerms">《用户服务协议》</text>
          <text class="login-agree-text">与</text>
          <text class="login-agree-link" catchtap="openPrivacy">《隐私政策》</text>
        </label>
      </checkbox-group>
      <view class="login-actions">
        <button
          wx:if="{{agreedToPolicies}}"
          class="login-action-link login-action-link--primary wx-phone-button"
          open-type="getPhoneNumber|agreePrivacyAuthorization"
          bindgetphonenumber="quickLoginAndEnroll"
          bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
          hover-class="none"
          loading="{{busy}}"
        >确定加入并授权手机号</button>
        <button wx:else class="login-action-link login-action-link--primary login-action-link--pending" bindtap="remindAgreement">确定加入并授权手机号</button>
        <button
          wx:if="{{agreedToPolicies}}"
          class="login-action-link wx-phone-button"
          open-type="getPhoneNumber|agreePrivacyAuthorization"
          bindgetphonenumber="recoverMembership"
          bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
          hover-class="none"
          loading="{{recoveryBusy}}"
        >找回原会员</button>
        <button wx:else class="login-action-link login-action-link--pending" bindtap="remindAgreement">找回原会员</button>
      </view>
      <text wx:if="{{recoveryMessage}}" class="login-recovery-note">{{recoveryMessage}}</text>
      <text wx:if="{{error}}" class="login-recovery-note login-recovery-note--error">{{error}}</text>
    </view>
  </view>
</view>
