.home-page {
  padding-top: 0;
}
.home-hero {
  position: relative;
  overflow: hidden;
  margin: 0 -28rpx 28rpx;
  padding: 24rpx 28rpx 36rpx;
  background:
    radial-gradient(circle at 90% 5%, rgba(198, 163, 105, 0.26), transparent 34%),
    linear-gradient(145deg, #0d1712, #234031 66%, #101512);
  color: #fff;
}
.home-hero::after {
  position: absolute;
  right: -100rpx;
  bottom: -180rpx;
  width: 360rpx;
  height: 360rpx;
  border: 1rpx solid rgba(210, 171, 115, 0.22);
  border-radius: 50%;
  content: "";
}
.hero-content {
  position: relative;
  z-index: 1;
  margin-top: 36rpx;
  max-width: 620rpx;
}
.hero-kicker,
.hero-title,
.hero-copy {
  display: block;
}
.hero-kicker {
  color: #c8a675;
  font-size: 21rpx;
  letter-spacing: 4rpx;
}
.hero-title {
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.hero-copy {
  margin-top: 14rpx;
  color: #d2cec8;
  font-size: 24rpx;
  line-height: 1.55;
}
.state-card {
  display: flex;
  min-height: 172rpx;
  padding: 26rpx;
  align-items: center;
  border: 1rpx solid #ddd6cb;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(33, 27, 22, 0.06);
  gap: 20rpx;
}
.state-card--waiting {
  border-color: #d5b474;
  background: #fffaf0;
}
.state-card__icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #302a25;
  color: #d9ba87;
  font-size: 28rpx;
}
.state-card__body {
  min-width: 0;
  flex: 1;
}
.state-card__body text {
  display: block;
}
.state-card__eyebrow {
  color: #8b7659;
  font-size: 21rpx;
}
.state-card__title {
  margin-top: 6rpx;
  font-size: 31rpx;
  font-weight: 700;
}
.state-card__copy {
  margin-top: 8rpx;
  color: #777069;
  font-size: 23rpx;
  line-height: 1.45;
}
.state-card__action {
  width: 112rpx;
  min-height: 88rpx;
  margin: 0;
  border: 1rpx solid #c9b28d;
  border-radius: 44rpx;
  background: transparent;
  color: #5d4830;
  font-size: 23rpx;
  line-height: 86rpx;
}
.onsite-summary {
  display: grid;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid #ddd8d0;
  grid-template-columns: repeat(3, 1fr);
}
.onsite-summary > view {
  min-width: 0;
  padding: 0 14rpx;
  text-align: center;
  border-right: 1rpx solid #e4dfd8;
}
.onsite-summary > view:last-child {
  border: 0;
}
.summary-value,
.summary-label {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.summary-value {
  font-size: 25rpx;
  font-weight: 700;
}
.summary-label {
  margin-top: 7rpx;
  color: #8a827a;
  font-size: 20rpx;
}
.primary-experience {
  display: flex;
  width: 100%;
  min-height: 218rpx;
  margin: 26rpx 0 0;
  padding: 32rpx;
  align-items: center;
  justify-content: space-between;
  border: 0;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #315d46, #172a21);
  color: #fff;
  text-align: left;
  box-shadow: 0 18rpx 44rpx rgba(25, 70, 49, 0.18);
}
.primary-experience::after {
  border: 0;
}
.primary-experience text {
  display: block;
}
.primary-experience__kicker {
  color: #caaa77;
  font-size: 21rpx;
  letter-spacing: 2rpx;
}
.primary-experience__title {
  margin-top: 8rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 40rpx;
  font-weight: 600;
}
.primary-experience__copy {
  margin-top: 12rpx;
  color: #cbc5bd;
  font-size: 23rpx;
}
.primary-experience__arrow {
  font-size: 44rpx;
  color: #d4b27d;
}
.reservation-experience {
  margin-top: 0;
  background: linear-gradient(145deg, #4a2c26, #211817);
}
.current-state,.reservation-state { margin-top: 22rpx; }
.home-editorial-section { margin-top: 34rpx; }
.featured-activity-card { position: relative; display: block; overflow: hidden; width: 100%; min-height: 296rpx; margin: 0; padding: 0; border: 0; border-radius: 28rpx; background: linear-gradient(135deg,#351817,#171313); color: #fff; text-align: left; }
.featured-activity-card::after,.editorial-story-card::after { border: 0; }
.featured-activity-card>image { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .55; }
.featured-activity-card__shade { position: absolute; inset: 0; background: linear-gradient(90deg,rgba(24,15,14,.96),rgba(40,16,17,.72) 62%,rgba(31,17,16,.38)); }
.featured-activity-card__copy { position: relative; z-index: 1; display: grid; min-height: 296rpx; padding: 34rpx; align-content: end; gap: 9rpx; }
.featured-activity-card__copy text:nth-child(1) { color: #d6ae74; font-size: 20rpx; letter-spacing: 2rpx; }
.featured-activity-card__copy text:nth-child(2) { margin-top: 12rpx; font-family: "Songti SC","STSong",serif; font-size: 42rpx; font-weight: 600; }
.featured-activity-card__copy text:nth-child(3) { color: #d8d0c9; font-size: 21rpx; }
.featured-activity-card__copy text:nth-child(4) { margin-top: 13rpx; color: #e7c89c; font-size: 21rpx; font-weight: 700; }
.editorial-story-card { display: flex; overflow: hidden; width: 100%; min-height: 184rpx; margin: 20rpx 0 0; padding: 24rpx; align-items: center; border: 1rpx solid #dfd2c1; border-radius: 26rpx; background: linear-gradient(135deg,#fff,#f4eee6); color: #2b2723; text-align: left; gap: 24rpx; box-shadow: 0 12rpx 30rpx rgba(42,31,22,.045); }
.editorial-story-card>image { width: 112rpx; height: 112rpx; flex: 0 0 auto; border-radius: 50%; background: #151312; }
.editorial-story-card>view { display: grid; min-width: 0; flex: 1; gap: 5rpx; }
.editorial-story-card>view text:nth-child(1) { color: #a77a42; font-size: 18rpx; letter-spacing: 3rpx; }
.editorial-story-card>view text:nth-child(2) { overflow: hidden; font-family: "Songti SC","STSong",serif; font-size: 32rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.editorial-story-card>view text:nth-child(3) { display: -webkit-box; overflow: hidden; color: #777069; font-size: 20rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.editorial-story-card>view text:nth-child(4) { margin-top: 5rpx; color: #745b3e; font-size: 20rpx; font-weight: 700; }
.performance-card {
  display: flex;
  overflow: hidden;
  min-height: 148rpx;
  margin-top: 22rpx;
  border: 1rpx solid #ddd8d0;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(42, 34, 26, 0.04);
}
.performance-card image {
  width: 188rpx;
  height: 148rpx;
  background: #2e2925;
}
.performance-card > view {
  display: flex;
  min-width: 0;
  padding: 20rpx 24rpx;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}
.performance-state,
.performance-name,
.performance-time {
  display: block;
}
.performance-state {
  color: #a16f37;
  font-size: 20rpx;
  font-weight: 700;
}
.performance-name {
  margin-top: 5rpx;
  overflow: hidden;
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.performance-time {
  margin-top: 8rpx;
  color: #807870;
  font-size: 21rpx;
}
.live-section { margin-top: 30rpx; }
.performance-compact {
  position: relative;
  display: block;
  overflow: hidden;
  width: 100%;
  min-height: 218rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 90% 78%, transparent 0 70rpx, rgba(195, 145, 84, 0.24) 71rpx 73rpx, transparent 74rpx),
    linear-gradient(140deg, #284536, #101713 74%);
  color: #fff;
  text-align: left;
  box-shadow: 0 16rpx 40rpx rgba(25, 70, 49, 0.16);
}
.performance-compact::after { border: 0; }
.performance-compact > image,
.performance-compact__shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.performance-compact > image { opacity: .42; }
.performance-compact__shade { background: linear-gradient(90deg, rgba(12,25,18,.94), rgba(18,42,30,.58) 63%, rgba(12,20,16,.22)); }
.performance-compact__content {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: 218rpx;
  padding: 34rpx 34rpx 30rpx;
  flex-direction: column;
  justify-content: flex-end;
}
.performance-compact__content text { display: block; }
.performance-compact__state { color: #d5ab72; font-size: 18rpx; font-weight: 700; letter-spacing: 4rpx; }
.performance-compact.is-live .performance-compact__state { color: #88c9a4; }
.performance-compact__name { margin-top: 12rpx; font-family: "Songti SC", "STSong", serif; font-size: 38rpx; font-weight: 600; }
.performance-compact__time { margin-top: 10rpx; color: #d1c9c0; font-size: 21rpx; }
.performance-compact__action { position: absolute; z-index: 2; right: 28rpx; bottom: 28rpx; color: #e4c596; font-size: 21rpx; }
.performance-shortcuts { display: grid; margin-top: 14rpx; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.performance-shortcuts button {
  display: flex;
  overflow: hidden;
  min-width: 0;
  min-height: 156rpx;
  margin: 0;
  padding: 22rpx;
  align-items: flex-start;
  flex-direction: column;
  border: 1rpx solid #dfd2c1;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #fffdfa, #f3ede5);
  color: #29241f;
  text-align: left;
  box-shadow: 0 9rpx 26rpx rgba(42, 32, 23, .05);
}
.performance-shortcuts button::after { border: 0; }
.performance-shortcuts text { display: block; max-width: 100%; }
.performance-shortcuts text:first-child { color: #9a7343; font-size: 16rpx; font-weight: 700; letter-spacing: 3rpx; }
.performance-shortcuts text:nth-child(2) { margin-top: 12rpx; overflow: hidden; font-family: "Songti SC", "STSong", serif; font-size: 26rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.performance-shortcuts text:last-child { display: -webkit-box; margin-top: 8rpx; overflow: hidden; color: #766e65; font-size: 19rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.performance-panel-mask { position: fixed; z-index: 70; inset: 0; display: flex; align-items: flex-end; background: rgba(10, 8, 7, .68); }
.performance-panel { width: 100%; max-height: 78vh; overflow-y: auto; padding: 16rpx 28rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #f7f3ed; color: #28231f; }
.performance-panel__handle { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 999rpx; background: #cfc6ba; }
.performance-panel__head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.performance-panel__head view text { display: block; }
.performance-panel__head view text:first-child { color: #967043; font-size: 17rpx; font-weight: 700; letter-spacing: 3rpx; }
.performance-panel__head view text:last-child { margin-top: 8rpx; font-family: "Songti SC", "STSong", serif; font-size: 38rpx; font-weight: 600; }
.performance-panel__head button { width: 72rpx; height: 72rpx; margin: 0; padding: 0; border: 1rpx solid #d7cfc5; border-radius: 50%; background: #fffdfa; color: #6d665e; font-size: 38rpx; line-height: 68rpx; }
.performance-panel__head button::after { border: 0; }
.performance-panel__schedule { margin-top: 26rpx; border-top: 1rpx solid #ddd4ca; }
.performance-schedule-row { display: grid; min-height: 112rpx; padding: 20rpx 0; grid-template-columns: 180rpx minmax(0, 1fr); align-items: center; border-bottom: 1rpx solid #e6ddd3; gap: 20rpx; }
.performance-schedule-row view text { display: block; }
.performance-schedule-row view:first-child text:first-child { color: #987043; font-size: 18rpx; font-weight: 700; }
.performance-schedule-row.is-current view:first-child text:first-child { color: #277052; }
.performance-schedule-row view:first-child text:last-child { margin-top: 6rpx; color: #847b72; font-size: 19rpx; }
.performance-schedule-row view:last-child text:first-child { font-size: 27rpx; font-weight: 650; }
.performance-schedule-row view:last-child text:last-child { margin-top: 6rpx; color: #7c746b; font-size: 19rpx; }
.performance-panel__artist { display: grid; margin-top: 28rpx; grid-template-columns: 180rpx minmax(0, 1fr); gap: 24rpx; }
.performance-panel__artist image { width: 180rpx; height: 220rpx; border-radius: 20rpx; background: #27211c; }
.performance-panel__artist view text { display: block; }
.performance-panel__artist view text:first-child { font-family: "Songti SC", "STSong", serif; font-size: 34rpx; font-weight: 600; }
.performance-panel__artist view text:nth-child(2) { margin-top: 12rpx; color: #9b7141; font-size: 19rpx; }
.performance-panel__artist view text:last-child { margin-top: 16rpx; color: #6e675f; font-size: 22rpx; line-height: 1.65; }
.performance-panel__note { display: block; margin-top: 24rpx; color: #8b837a; font-size: 18rpx; line-height: 1.55; }
.home-campaign-mask{position:fixed;z-index:74;inset:0;display:flex;align-items:flex-end;background:rgba(9,14,11,.58)}.home-campaign-sheet{position:relative;width:100%;padding:26rpx 30rpx calc(38rpx + env(safe-area-inset-bottom));box-sizing:border-box;border-radius:32rpx 32rpx 0 0;background:linear-gradient(145deg,#fffefb,#f3f6f2);color:#26221f}.home-campaign-close{position:absolute;z-index:2;top:20rpx;right:24rpx;width:64rpx;height:64rpx;margin:0;padding:0;border:1rpx solid rgba(255,255,255,.78);border-radius:50%;background:rgba(15,24,18,.58);color:#fff;font-size:36rpx;line-height:60rpx}.home-campaign-close::after,.home-campaign-cta::after{border:0}.home-campaign-image{width:100%;height:264rpx;border-radius:20rpx;background:#193223}.home-campaign-logo{display:block;width:122rpx;height:122rpx;margin:0 auto 12rpx}.home-campaign-kicker,.home-campaign-title,.home-campaign-copy,.home-campaign-note{display:block}.home-campaign-kicker{margin-top:22rpx;color:#527460;font-size:18rpx;font-weight:700;letter-spacing:3rpx}.home-campaign-title{margin-top:10rpx;font-family:"Songti SC","STSong",serif;font-size:42rpx;font-weight:600;line-height:1.24}.home-campaign-copy{margin-top:12rpx;color:#6f685f;font-size:23rpx;line-height:1.55}.home-campaign-cta{width:100%;min-height:92rpx;margin-top:24rpx;border-radius:16rpx;background:#315d46;color:#fff;font-size:25rpx;font-weight:700;line-height:92rpx}.home-campaign-cta--quiet{background:#fff;color:#315d46;border:1rpx solid #315d46}.home-campaign-note{margin-top:14rpx;color:#8d857c;font-size:18rpx;text-align:center}
.compact-section {
  margin-top: 34rpx;
}
.action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}
.action-grid button {
  display: flex;
  min-width: 0;
  min-height: 122rpx;
  margin: 0;
  padding: 18rpx 8rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  border: 1rpx solid #dfdad3;
  border-radius: 20rpx;
  background: #fff;
  color: #302d29;
  font-size: 21rpx;
}
.action-grid button::after {
  border: 0;
}
.action-icon {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 10rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0e9df;
  color: #7a5631;
  font-size: 21rpx;
  font-weight: 700;
}
.reservation-state {
  margin-bottom: 0;
}
.discovery-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 14rpx;
}
.discovery-card {
  display: flex;
  min-height: 230rpx;
  margin: 0;
  padding: 24rpx;
  flex-direction: column;
  justify-content: flex-end;
  border: 0;
  border-radius: 22rpx;
  color: #fff;
  text-align: left;
}
.discovery-card::after {
  border: 0;
}
.discovery-card text {
  display: block;
}
.discovery-card text:first-child {
  color: #d5b27d;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.discovery-card text:nth-child(2) {
  margin-top: 10rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  line-height: 1.35;
}
.discovery-card text:last-child {
  margin-top: 18rpx;
  color: #d2ccc5;
  font-size: 20rpx;
}
.discovery-card--activity {
  background: linear-gradient(145deg, #3b2822, #191716);
}
.discovery-card--member {
  background: linear-gradient(145deg, #344139, #1b211e);
}
.member-invite-mask {
  position: fixed;
  z-index: 100;
  inset: 0;
  display: flex;
  padding: 30rpx;
  align-items: flex-end;
  background: rgba(10, 9, 8, 0.64);
  backdrop-filter: blur(8rpx);
}
.member-invite-sheet {
  position: relative;
  width: 100%;
  padding: 42rpx 42rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #fffefb;
  box-shadow: 0 -18rpx 56rpx rgba(0, 0, 0, 0.22);
  text-align: center;
}
.member-invite-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(43, 39, 34, 0.06);
  color: #79716a;
  font-size: 34rpx;
  line-height: 56rpx;
}
.member-invite-close::after {
  border: 0;
}
.member-invite-art {
  position: relative;
  display: flex;
  width: 260rpx;
  height: 220rpx;
  margin: 24rpx auto 20rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  color: #b6915c;
}
.member-invite-art__ring {
  position: absolute;
  width: 190rpx;
  height: 190rpx;
  border: 2rpx solid #caa66d;
  border-radius: 50%;
  transform: rotate(-12deg);
}
.member-invite-art__ring::before,
.member-invite-art__ring::after {
  position: absolute;
  border: 1rpx solid rgba(202, 166, 109, 0.55);
  border-radius: 50%;
  content: "";
}
.member-invite-art__ring::before {
  inset: 20rpx -18rpx;
  transform: rotate(38deg);
}
.member-invite-art__ring::after {
  inset: 38rpx -28rpx;
  transform: rotate(-42deg);
}
.member-invite-art__mark {
  position: relative;
  z-index: 1;
  display: flex;
  width: 94rpx;
  height: 94rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c39a60;
  border-radius: 50%;
  background: #27231f;
  color: #e8cfaa;
  font-family: "Songti SC", serif;
  font-size: 54rpx;
}
.member-invite-art > text {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  color: #8f6d41;
  font-size: 17rpx;
  letter-spacing: 5rpx;
}
.member-invite-kicker,
.member-invite-title,
.member-invite-copy,
.member-invite-note {
  display: block;
}
.member-invite-kicker {
  margin-top: 2rpx;
  color: #8a6c48;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 3.5rpx;
}
.member-invite-title {
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.member-invite-copy {
  margin-top: 14rpx;
  color: #706860;
  font-size: 22rpx;
  line-height: 1.6;
}
.member-invite-logo {
  display: block;
  width: 126rpx;
  height: 126rpx;
  margin: 28rpx auto 22rpx;
  border: 1rpx solid rgba(117, 91, 62, 0.22);
  border-radius: 50%;
  background: #000;
  box-shadow: 0 10rpx 24rpx rgba(27, 22, 18, 0.14);
}
.member-invite-agreement {
  display: flex;
  min-height: 72rpx;
  align-items: flex-start;
  justify-content: flex-start;
  color: #675f57;
  font-size: 21rpx;
  line-height: 1.55;
  text-align: left;
  gap: 10rpx;
}
.member-invite-agreement checkbox {
  flex: 0 0 auto;
  margin-top: 1rpx;
  transform: scale(0.86);
}
.member-invite-agreement .wx-checkbox-input { width: 34rpx; height: 34rpx; border: 1rpx solid #bdb5ac; border-radius: 50%; }
.member-invite-agreement .wx-checkbox-input.wx-checkbox-input-checked { border-color: #315d46; background: #315d46; }
.member-invite-agreement-copy { flex: 1; min-width: 0; }
.member-invite-links {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  color: #8a6036;
  font-size: 20rpx;
  gap: 0 10rpx;
}
.member-invite-actions {
  display: grid;
  margin-top: 24rpx;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.member-invite-refuse,
.member-invite-agree {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  border: 1rpx solid #315d46;
  border-radius: 44rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 88rpx;
}
.member-invite-refuse {
  background: #fffdfa;
  color: #315d46;
}
.member-invite-agree {
  background: #315d46;
  color: #fff;
}
.member-invite-agree--pending {
  border-color: #c5c1ba;
  background: #c5c1ba;
  color: #fff;
}
.member-invite-refuse::after,
.member-invite-agree::after {
  border: 0;
}
.member-invite-note {
  margin-top: 16rpx;
  color: #90877e;
  font-size: 18rpx;
  line-height: 1.55;
  text-align: center;
}
@media (max-width: 350px) {
  .hero-content {
    margin-top: 28rpx;
  }
  .hero-title {
    font-size: 42rpx;
  }
  .action-grid {
    grid-template-columns: 1fr 1fr;
  }
  .discovery-grid {
    grid-template-columns: 1fr;
  }
  .discovery-card {
    min-height: 190rpx;
  }
}
