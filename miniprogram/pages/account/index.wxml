<view class="page">
  <view class="top-band">
    <view class="brand-row"><view><text class="eyebrow">当前桌台</text><text class="account-table">{{tableCode}} 桌账摘要</text></view><text wx:if="{{isDevelopment}}" class="dev-badge">开发模式</text></view>
  </view>
  <state-panel wx:if="{{loading}}" type="loading" title="正在核对桌账" />
  <block wx:else>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>
    <view class="account-total panel">
      <text class="eyebrow">当前未结余额</text>
      <text class="account-total__amount">{{outstandingText}}</text>
      <text class="account-note">同桌订单共同可见，但不会展示付款人身份或支付凭证。</text>
    </view>
    <view class="warning payment-boundary">本页只展示订单、出品进度与未结余额，不在这里模拟支付。金额有疑问请在点单页呼叫买单服务。</view>
    <view class="section">
      <view class="section-title"><text>本桌订单</text><text class="section-link">下拉刷新</text></view>
      <view wx:if="{{orders.length}}" class="order-list">
        <view wx:for="{{orders}}" wx:key="publicId" class="panel order-card">
          <view class="order-card__head">
            <view><text class="list-row__title">{{item.roundText}} · {{item.statusText}}</text><text class="list-row__meta">{{item.isMineText}} · {{item.createdAtText}}</text></view>
            <view class="order-card__amount"><text class="amount">{{item.payableText}}</text><text>{{item.paymentText}}</text></view>
          </view>
          <view wx:for="{{item.items}}" wx:for-item="product" wx:key="key" class="list-row">
            <view class="list-row__main"><text class="list-row__title">{{product.name}} ×{{product.quantity}}</text><text class="list-row__meta">{{product.statusText}}</text></view>
          </view>
        </view>
      </view>
      <state-panel wx:else type="empty" title="当前暂无订单" message="下单后，商品与出品进度会显示在这里" />
    </view>
  </block>
</view>
