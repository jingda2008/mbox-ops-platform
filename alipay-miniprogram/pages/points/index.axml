<view class="page points-page">
  <view class="points-head">
    <text class="eyebrow">M-BOX 会员</text>
    <text class="points-title">积分与成长值</text>
    <text class="points-copy">积分只兑换指定商品或权益，不抵现金；成长值仅用于会员等级。</text>
  </view>

  <state-panel a:if="{{loading}}" type="loading" title="正在读取明细" />
  <view a:elif="{{error}}" class="error-banner"><text>{{error}}</text><button onTap="load">重新读取</button></view>
  <block a:else>
    <view a:if="{{membership}}" class="balance-card">
      <view><text>{{membership.pointsBalance}}</text><text>可用积分</text></view>
      <view><text>{{membership.growthValue}}</text><text>成长值</text></view>
      <text>{{membership.expiryText}}</text>
      <text a:if="{{membership.debtText}}" class="balance-debt">{{membership.debtText}}</text>
    </view>
    <view a:else class="empty-member"><text>当前身份还没有会员账户</text><button onTap="openMembership">返回“我的”查看入会说明</button></view>

    <view a:if="{{membership && processing.length}}" class="progress-card">
      <view class="progress-head"><text>积分与成长值进展</text><text>仅显示你的记录</text></view>
      <view a:for="{{processing}}" a:key="key" class="progress-row">
        <view class="progress-marker {{item.active ? 'is-active' : ''}}"></view>
        <view><text>{{item.title}}</text><text>{{item.message}}</text><text a:if="{{item.referenceText}}">{{item.referenceText}} · {{item.updatedAt}}</text><text a:else>{{item.updatedAt}}</text></view>
      </view>
    </view>

    <view a:if="{{membership}}" class="ledger-tabs">
      <button class="{{tab === 'points' ? 'is-active' : ''}}" data-tab="points" onTap="switchTab">积分明细</button>
      <button class="{{tab === 'growth' ? 'is-active' : ''}}" data-tab="growth" onTap="switchTab">成长值明细</button>
    </view>

    <view a:if="{{membership && tab === 'points'}}" class="ledger-list">
      <view a:for="{{points}}" a:key="id" class="ledger-row"><view><text>{{item.title}}</text><text>{{item.description}}</text><text a:if="{{item.metaText}}">{{item.metaText}}</text><text>{{item.occurredAt}}</text></view><view><text class="{{item.positive ? 'positive' : 'negative'}}">{{item.amountText}}</text><text>{{item.balanceText}}</text></view></view>
      <state-panel a:if="{{!points.length}}" type="empty" title="还没有积分记录" message="完成符合规则的付款后，积分会在这里显示" />
    </view>

    <view a:if="{{membership && tab === 'growth'}}" class="ledger-list">
      <view a:for="{{growth}}" a:key="id" class="ledger-row"><view><text>{{item.title}}</text><text>{{item.description}}</text><text a:if="{{item.metaText}}">{{item.metaText}}</text><text>{{item.occurredAt}}</text></view><view><text class="{{item.positive ? 'positive' : 'negative'}}">{{item.amountText}}</text><text>{{item.balanceText}}</text></view></view>
      <state-panel a:if="{{!growth.length}}" type="empty" title="还没有成长值记录" message="成长值与可用积分分开计算" />
    </view>

    <view class="ledger-note"><text>记录说明</text><text>退款、到期、补发、调整和兑换返还会分别显示。如对积分有疑问，请联系门店协助核对。</text></view>
  </block>
</view>
