.order-page {
  width: 100%;
  overflow-x: hidden;
  padding-top: 0;
  padding-bottom: calc(230rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(230rpx + env(safe-area-inset-bottom));
}
.order-head {
  display: flex;
  margin: 0 -28rpx 18rpx;
  padding: 24rpx 28rpx 22rpx;
  align-items: center;
  justify-content: space-between;
  background:
    radial-gradient(circle at 88% 0, rgba(198, 163, 105, .28), transparent 32%),
    radial-gradient(circle at 18% 96%, rgba(69, 123, 92, .28), transparent 42%),
    linear-gradient(145deg, #0d1712, #234031 68%, #101512);
  color: #fff;
}
.order-title {
  display: block;
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 600;
}
.service-entry {
  min-width: 160rpx;
  min-height: 88rpx;
  margin: 0;
  border: 1rpx solid #7e6a4f;
  border-radius: 44rpx;
  background: transparent;
  color: #dfc18f;
  font-size: 23rpx;
  line-height: 86rpx;
}
.gate-wrap {
  display: block;
  padding: 0 0 48rpx;
  text-align: left;
}
.browse-intro {
  position: relative;
  overflow: hidden;
  margin: 0 -4rpx;
  padding: 38rpx 30rpx 32rpx;
  border: 1rpx solid rgba(202, 170, 119, 0.38);
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 88% 10%, rgba(198, 163, 105, .28), transparent 32%),
    radial-gradient(circle at 18% 96%, rgba(69, 123, 92, .28), transparent 42%),
    linear-gradient(145deg, #0d1712, #234031 68%, #101512);
  color: #fff;
  box-shadow: 0 20rpx 54rpx rgba(25, 21, 17, 0.16);
}
.browse-intro::after {
  position: absolute;
  right: -110rpx;
  bottom: -175rpx;
  width: 330rpx;
  height: 330rpx;
  border: 1rpx solid rgba(218, 184, 130, 0.2);
  border-radius: 50%;
  content: "";
}
.browse-intro__copy {
  position: relative;
  z-index: 1;
}
.gate-logo {
  position: absolute;
  z-index: 1;
  top: 24rpx;
  right: 24rpx;
  display: block;
  width: 84rpx;
  height: 84rpx;
  border: 1rpx solid rgba(206, 169, 110, 0.42);
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.18);
}
.gate-art {
  position: absolute;
  z-index: 1;
  top: 26rpx;
  right: 26rpx;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  opacity: 0.9;
}
.gate-ring {
  position: absolute;
  inset: 0;
  border: 1rpx solid #a8885a;
  border-radius: 50%;
}
.gate-ring::before,
.gate-ring::after {
  position: absolute;
  border: 1rpx solid rgba(222, 208, 184, 0.45);
  border-radius: 50%;
  content: "";
}
.gate-ring::before {
  inset: 12rpx;
}
.gate-ring::after {
  inset: 24rpx;
}
.gate-mark {
  position: relative;
  z-index: 1;
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #c5a46f;
  border-radius: 10rpx;
  color: #f4eadb;
  font-family: "Songti SC", serif;
  font-size: 25rpx;
}
.gate-kicker,
.gate-title,
.gate-copy,
.gate-note {
  display: block;
}
.gate-kicker {
  padding-right: 110rpx;
  color: #caaa77;
  font-size: 19rpx;
  letter-spacing: 3rpx;
}
.gate-title {
  max-width: 470rpx;
  margin-top: 18rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.3;
}
.gate-copy {
  max-width: 560rpx;
  margin-top: 16rpx;
  color: #cbc4ba;
  font-size: 23rpx;
  line-height: 1.7;
}
.gate-button {
  position: relative;
  z-index: 1;
  width: 100%;
  margin-top: 30rpx;
  background: #f3eee6;
  color: #211e1a;
}
.gate-note {
  position: relative;
  z-index: 1;
  margin-top: 17rpx;
  color: #9e978f;
  font-size: 19rpx;
  text-align: center;
}
.gate-error {
  width: 100%;
  margin-top: 18rpx;
  text-align: left;
}
.browse-menu {
  margin-top: 38rpx;
}
.browse-menu__heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.browse-menu__heading view text {
  display: block;
}
.browse-menu__heading view text:first-child {
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 600;
}
.browse-menu__heading view text:last-child {
  margin-top: 7rpx;
  color: #837b72;
  font-size: 20rpx;
}
.browse-menu__heading > text {
  color: #927049;
  font-size: 21rpx;
}
.menu-tools--browse {
  position: static;
  margin: 24rpx 0 0;
  padding: 0;
  border: 0;
  background: transparent;
}
.product-list--browse {
  margin-top: 24rpx;
}
.waiting-pulse {
  display: flex;
  width: 150rpx;
  height: 150rpx;
  margin-bottom: 40rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d2b682;
  border-radius: 50%;
  animation: pulse 1.8s ease-in-out infinite;
}
.waiting-pulse view {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #332d27;
}
.table-strip {
  display: grid;
  min-height: 112rpx;
  padding: 14rpx 18rpx;
  align-items: center;
  border: 1rpx solid #ddd7cf;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(42, 34, 26, .035);
  grid-template-columns: 80rpx minmax(0, 1fr);
  gap: 16rpx;
}
.table-strip__table {
  display: grid;
  min-height: 76rpx;
  padding-right: 16rpx;
  align-content: center;
  border-right: 1rpx solid #e3ddd5;
}
.table-strip__label,
.table-strip__value,
.show-brief text {
  display: block;
}
.table-strip__label {
  color: #91877c;
  font-size: 19rpx;
}
.table-strip__value {
  margin-top: 5rpx;
  font-size: 30rpx;
  font-weight: 750;
}
.table-strip__content { display: grid; min-width: 0; }
.table-strip__service {
  display: flex;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #292621;
  text-align: left;
}
.table-strip__service::after { border: 0; }
.table-strip__service-value { overflow: hidden; color: #315d46; font-size: 22rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.table-strip__service-link { margin-left: auto; padding-left: 12rpx; flex: 0 0 auto; color: #8a8177; font-size: 18rpx; }
.show-brief {
  display: flex;
  min-width: 0;
  min-height: 42rpx;
  padding-top: 6rpx;
  align-items: center;
  border-top: 1rpx solid #eee9e2;
  gap: 10rpx;
}
.show-brief text:first-child {
  padding: 2rpx 8rpx;
  flex: 0 0 auto;
  border-radius: 999rpx;
  background: #f5ead8;
  color: #8b642f;
  font-size: 17rpx;
}
.show-brief text:last-child {
  min-width: 0;
  overflow: hidden;
  color: #5f5850;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.show-brief--retry {
  min-height: 42rpx;
  margin: 0;
  padding-top: 6rpx;
  padding-right: 0;
  padding-bottom: 0;
  border-right: 0;
  border-bottom: 0;
  border-left: 0;
  border-radius: 0;
  background: transparent;
  color: #873f35;
  text-align: left;
}
.show-brief--retry::after { border: 0; }
.show-brief--retry text:first-child { color: #873f35; }
.show-brief--retry text:last-child { color: #837a70; font-size: 18rpx; }
.quick-service { display: grid; min-width: 0; margin-top: 8rpx; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.quick-service button { display: flex; width: 100%; min-width: 0; min-height: 88rpx; margin: 0; padding: 10rpx 0; align-items: center; justify-content: center; border: 0; background: transparent; color: #2f5b43; font-size: 20rpx; font-weight: 650; line-height: 1.2; text-align: center; white-space: nowrap; }
.quick-service button::after { border: 0; }
.quick-service__surface { box-sizing: border-box; display: flex; width: 100%; min-width: 0; min-height: 64rpx; padding: 0 10rpx; align-items: center; justify-content: center; border: 1rpx solid #b9cec0; border-radius: 32rpx; background: #eef6f1; gap: 7rpx; }
.quick-service button:nth-child(2) { color: #725630; }
.quick-service button:nth-child(2) .quick-service__surface { border-color: #decba9; background: #fbf6ed; }
.quick-service button:nth-child(3) { color: #87483f; }
.quick-service button:nth-child(3) .quick-service__surface { border-color: #e1c4bf; background: #fcf3f1; }
.quick-service__dot { width: 8rpx; height: 8rpx; flex: 0 0 auto; border-radius: 50%; background: currentColor; opacity: .82; }
.recommend-entry {
  margin-top: 18rpx;
  padding: 4rpx 0 0;
  border: 0;
  background: transparent;
  color: #1f2e26;
}
.recommend-entry__head { display: flex; padding: 0 4rpx 12rpx; align-items: flex-end; justify-content: space-between; gap: 18rpx; }
.recommend-entry__head text {
  display: block;
}
.recommend-entry__head text:first-child {
  font-family: "Songti SC", "STSong", serif;
  font-size: 29rpx;
  font-weight: 600;
}
.recommend-entry__head text:last-child {
  color: #6c766f;
  font-size: 18rpx;
  line-height: 1.35;
  text-align: right;
}
.recommend-entry__actions { display: grid; margin-top: 12rpx; grid-template-columns: 1.2fr 1fr; gap: 12rpx; }
.recommend-entry__actions--primary { margin-top: 4rpx; margin-bottom: 14rpx; }
.recommend-entry__actions button {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 96rpx;
  margin: 0;
  padding: 12rpx 16rpx;
  align-items: center;
  justify-content: flex-start;
  border: 1rpx solid #b9cec0;
  border-radius: 16rpx;
  background: #f4f8f5;
  color: #244b37;
  line-height: 1.2;
  text-align: left;
  gap: 12rpx;
}
.recommend-entry__actions button::after { border: 0; }
.recommend-entry__actions button > view { min-width: 0; }
.recommend-entry__actions button > view text { display: block; }
.recommend-entry__actions button > view text:first-child { font-size: 21rpx; font-weight: 700; white-space: nowrap; }
.recommend-entry__actions button > view text:last-child { margin-top: 4rpx; color: #738078; font-size: 16rpx; white-space: nowrap; }
.recommend-entry__action-icon { display: flex; width: 50rpx; height: 50rpx; flex: 0 0 auto; align-items: center; justify-content: center; border: 1rpx solid #b9985f; border-radius: 50%; color: #a17735; font-size: 25rpx; }
.recommend-entry__actions .shake-recommendation { border-color: #d7c8ad; background: #fbf7ef; color: #665235; }
.recommend-entry__actions .shake-recommendation .recommend-entry__action-icon { border-color: #d3bd91; color: #8b6c35; }
.shake-recommendation::after { border: 0; }
.recommendation-note { margin-top: 12rpx; padding: 12rpx 14rpx; border-radius: 12rpx; background: #f6efe4; color: #765c37; font-size: 19rpx; line-height: 1.5; }
.recommend-scroll {
  width: 100%;
  margin-top: 12rpx;
}
.recommend-row {
  display: flex;
  padding-bottom: 4rpx;
  gap: 12rpx;
}
.recommend-card {
  overflow: hidden;
  width: 296rpx;
  min-height: 330rpx;
  flex: 0 0 auto;
  border: 1rpx solid #ddd7cf;
  border-radius: 16rpx;
  background: #fff;
}
.recommend-card--priority { border-color: #c8a56e; box-shadow: 0 10rpx 28rpx rgba(137, 98, 48, .12); }
.recommend-card__image {
  width: 100%;
  height: 108rpx;
  background: #29251f;
}
.recommend-body {
  display: flex;
  min-height: 222rpx;
  padding: 12rpx;
  flex-direction: column;
}
.recommend-tier {
  color: #9b6b34;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.recommend-name {
  display: block;
  margin-top: 5rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 26rpx;
  font-weight: 600;
}
.recommend-reason {
  display: block;
  overflow: hidden;
  margin-top: 6rpx;
  color: #706960;
  font-size: 18rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.saving {
  display: block;
  color: #28704d;
  font-size: 20rpx;
  font-weight: 650;
}
.recommend-value { display: grid; margin-top: 6rpx; color: #8b8177; font-size: 17rpx; gap: 2rpx; }
.recommend-foot {
  display: flex;
  margin-top: auto;
  align-items: center;
  justify-content: space-between;
}
.recommend-price {
  font-size: 27rpx;
  font-weight: 750;
}
.recommend-actions { display: flex; align-items: center; gap: 8rpx; }
.recommend-foot button { display: flex; width: auto; min-width: 112rpx; min-height: 88rpx; margin: 0; padding: 0 14rpx; align-items: center; justify-content: center; border-radius: 44rpx; font-size: 20rpx; line-height: 1; }
.recommend-foot .recommend-reject { border: 1rpx solid #d2cbc1; background: transparent; color: #756d64; }
.recommend-foot .recommend-select { min-width: 132rpx; border: 0; background: #315d46; color: #fff; }
.menu-tools {
  position: sticky;
  z-index: 6;
  top: 0;
  margin: 30rpx -28rpx 0;
  padding: 18rpx 28rpx 12rpx;
  border-bottom: 1rpx solid #e0dbd4;
  background: rgba(247, 245, 241, 0.96);
}
.menu-tools .search-box { margin-top: 14rpx; }
.search-box {
  display: flex;
  height: 88rpx;
  padding: 0 22rpx;
  align-items: center;
  border: 1rpx solid #d6d0c7;
  border-radius: 44rpx;
  background: #fff;
  gap: 12rpx;
}
.search-box > text {
  color: #8d7d68;
  font-size: 30rpx;
}
.search-box input {
  min-width: 0;
  flex: 1;
  font-size: 24rpx;
}
.category-scroll {
  width: 100%;
  margin-top: 0;
}
.category-row {
  display: flex;
  gap: 10rpx;
}
.category-row button {
  width: auto;
  min-width: 112rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  flex: 0 0 auto;
  border: 1rpx solid #d5cfc6;
  border-radius: 36rpx;
  background: #fff;
  color: #6f675f;
  font-size: 22rpx;
  line-height: 70rpx;
}
.category-row button.is-active {
  border-color: #315d46;
  background: #315d46;
  color: #fff;
}
.category-scroll--sub { margin-top: 10rpx; }
.category-row--sub { gap: 8rpx; }
.category-row--sub button {
  min-width: 96rpx;
  min-height: 64rpx;
  padding: 0 20rpx;
  border-color: #c7d6cd;
  border-radius: 32rpx;
  background: #f3f8f5;
  color: #486757;
  font-size: 20rpx;
  line-height: 62rpx;
}
.category-row--sub button.is-active {
  border-color: #7cad92;
  background: #e0eee5;
  color: #194c36;
}
.product-section {
  margin-top: 24rpx;
}
.product-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}
.product-row {
  display: flex;
  min-width: 0;
  min-height: 520rpx;
  overflow: hidden;
  padding: 0;
  align-items: stretch;
  flex-direction: column;
  border: 1rpx solid #ded7cd;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(42, 34, 26, 0.045);
}
.product-row.is-unavailable {
  border-color: #e2d7cc;
  background: #fbf8f4;
}
.product-row.is-unavailable .product-media {
  opacity: .62;
}
.product-media {
  display: flex;
  width: 100%;
  height: 236rpx;
  overflow: hidden;
  align-items: center;
  flex: 0 0 auto;
  justify-content: center;
  border-radius: 0;
  background: linear-gradient(145deg, #284536, #101713);
}
.product-media image {
  width: 100%;
  height: 100%;
}
.product-media__placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: #d7bd93;
  font-family: "Songti SC", serif;
  font-size: 42rpx;
}
.product-main {
  min-width: 0;
  padding: 18rpx 18rpx 8rpx;
  flex: 1;
}
.product-main text {
  display: block;
}
.product-kind {
  color: #9b6a31;
  font-size: 18rpx;
  font-weight: 700;
}
.product-name {
  margin-top: 6rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 27rpx;
  font-weight: 650;
}
.product-copy {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #7a736b;
  font-size: 20rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.product-action {
  display: flex;
  min-height: 110rpx;
  padding: 4rpx 18rpx 18rpx;
  align-items: flex-end;
  justify-content: space-between;
  flex: 0 0 auto;
  text-align: left;
  gap: 10rpx;
}
.product-action__meta { min-width: 0; flex: 1; }
.product-price {
  display: block;
  font-size: 27rpx;
  font-weight: 750;
}
.product-availability,
.product-availability-copy {
  display: block;
}
.product-availability {
  margin-top: 7rpx;
  color: #315d46;
  font-size: 19rpx;
  font-weight: 700;
}
.product-availability.is-unavailable {
  color: #8e7162;
}
.product-availability-copy {
  max-width: 168rpx;
  margin-top: 5rpx;
  overflow: hidden;
  color: #8a8279;
  font-size: 17rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
}
.product-action button {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  margin: 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #315d46;
  border-radius: 44rpx;
  background:
    linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,0) 44%),
    linear-gradient(145deg, #315d46, #214635);
  color: #fff;
  font-size: 34rpx;
  line-height: 88rpx;
}
.product-action .product-unavailable {
  width: 120rpx;
  height: auto;
  min-height: 64rpx;
  margin-top: 12rpx;
  padding: 8rpx 10rpx;
  border-color: #d8c8bc;
  background: #f0e9e2;
  color: #806b5e;
  font-size: 18rpx;
  line-height: 1.35;
}
.cart-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #d8d2c9;
  background: rgba(248, 247, 242, 0.98);
  box-shadow: 0 -14rpx 38rpx rgba(24, 20, 17, 0.12);
}
.shared-cart-empty {
  display: grid;
  gap: 6rpx;
  margin: 18rpx 0 132rpx;
  padding: 20rpx 22rpx;
  border: 1rpx dashed #a9c0b1;
  border-radius: 18rpx;
  background: #f4faf6;
}
.shared-cart-empty text:first-child { color: #244633; font-size: 24rpx; font-weight: 700; }
.shared-cart-empty text:last-child { color: #607369; font-size: 21rpx; line-height: 1.55; }
.service-name { display: grid; gap: 4rpx; min-width: 0; }
.service-name text:first-child { color: #8a8278; font-size: 18rpx; }
.service-name text:last-child { overflow: hidden; color: #315d46; font-size: 22rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.cart-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.cart-summary > view {
  min-width: 0;
  flex: 1;
}
.cart-summary text {
  display: block;
}
.cart-summary text:first-child {
  font-size: 29rpx;
  font-weight: 750;
}
.cart-summary text:last-child {
  margin-top: 4rpx;
  color: #8a8279;
  font-size: 18rpx;
}
.checkout-button {
  width: 270rpx;
  min-height: 92rpx;
  margin: 0;
  border-radius: 46rpx;
  background:
    linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,0) 44%),
    linear-gradient(145deg, #315d46, #214635);
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 92rpx;
  box-shadow: 0 10rpx 24rpx rgba(35, 78, 58, 0.2);
}
.cart-summary__actions { display: flex; flex: 0 0 auto; align-items: center; gap: 10rpx; }
