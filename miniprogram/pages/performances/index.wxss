.performances-page{padding-top:0}.performance-hero{margin:0 -28rpx 24rpx;padding:42rpx 28rpx 38rpx;background:radial-gradient(circle at 88% 7%,rgba(202,164,103,.25),transparent 34%),linear-gradient(145deg,#111a15,#254332);color:#fff}.performance-hero text{display:block}.performance-hero text:first-child{color:#d6b177;font-size:19rpx;font-weight:700;letter-spacing:4rpx}.performance-hero text:nth-child(2){margin-top:12rpx;font-family:"Songti SC","STSong",serif;font-size:44rpx;font-weight:600}.performance-hero text:last-child{margin-top:12rpx;color:#d3dcd5;font-size:22rpx}.date-picker-card{padding:20rpx 22rpx;border:1rpx solid #ddd7cf;border-radius:18rpx;background:#fff}.date-picker-card>text{display:block;color:#857b71;font-size:19rpx}.date-picker-card picker>view{display:flex;min-height:60rpx;align-items:end;justify-content:space-between;font-size:28rpx;font-weight:700}.date-picker-card picker>view text:last-child{color:#315d46;font-size:20rpx;font-weight:500}.schedule-list{display:grid;margin-top:18rpx;gap:12rpx}.schedule-card{display:grid;min-height:146rpx;padding:14rpx;grid-template-columns:118rpx minmax(0,1fr);align-items:center;border:1rpx solid #ddd7cf;border-radius:18rpx;background:#fff;gap:18rpx}.schedule-card image,.schedule-avatar{width:118rpx;height:118rpx;border-radius:14rpx;background:#214635}.schedule-avatar{display:flex;align-items:center;justify-content:center;color:#d8b37a;font-size:20rpx;font-weight:700;letter-spacing:2rpx}.schedule-card view text{display:block}.schedule-card view text:first-child{color:#8f6b40;font-size:19rpx;font-weight:700}.schedule-card view text:nth-child(2){margin-top:9rpx;font-family:"Songti SC","STSong",serif;font-size:30rpx;font-weight:600}.schedule-card view text:last-child{margin-top:8rpx;color:#7b736a;font-size:19rpx;line-height:1.4}.schedule-note{display:block;margin:22rpx 4rpx;color:#8b837a;font-size:18rpx;line-height:1.5}@media(max-width:390px){.performances-page{padding-right:22rpx;padding-left:22rpx}.performance-hero{margin-right:-22rpx;margin-left:-22rpx;padding-right:22rpx;padding-left:22rpx}}

.day-scroll{margin-top:10rpx;white-space:nowrap}.day-row{display:inline-flex;gap:0;padding:0 2rpx 6rpx}.day-chip{display:inline-flex;width:88rpx;min-height:88rpx;margin:0;padding:0;align-items:center;justify-content:center;border:0;border-radius:50%;background:transparent;color:#766f67;font-size:20rpx;font-weight:650;line-height:1}.day-chip::after{border:0}.day-chip__label{display:inline-flex;min-width:24rpx;height:24rpx;align-items:center;justify-content:center;border-radius:50%;font-size:20rpx;line-height:24rpx}.day-chip.is-today{color:#315d46}.day-chip.is-today .day-chip__label{box-shadow:inset 0 0 0 1rpx rgba(49,93,70,.36)}.day-chip.is-on{color:#fff}.day-chip.is-on .day-chip__label{min-width:36rpx;height:36rpx;background:#315d46;box-shadow:none;font-weight:750;line-height:36rpx}
