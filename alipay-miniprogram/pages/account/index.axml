<view class="page">
  <view class="top-band">
    <view class="brand-row"><view><text class="eyebrow">当前桌台</text><text class="account-table">{{tableCode}} 桌账摘要</text></view></view>
  </view>
  <state-panel a:if="{{loading}}" type="loading" title="正在查看桌账" />
  <block a:else>
    <view a:if="{{error}}" class="error-banner">{{error}}</view>
    <view a:if="{{success}}" class="success-banner">{{success}}</view>
    <view class="account-total panel">
      <text class="eyebrow">当前未结余额</text>
      <text class="account-total__amount">{{outstandingText}}</text>
      <text class="account-note">同桌订单可共同查看，不显示付款人信息。</text>
    </view>
    <view class="warning payment-boundary">金额会在付款或退款确认后更新。付款结果尚未确认时，请先查看结果，避免重复付款。</view>
    <view class="section">
      <view class="section-title"><text>本桌订单</text><text class="section-link">下拉刷新</text></view>
      <view a:if="{{orders.length}}" class="order-list">
        <view a:for="{{orders}}" a:key="publicId" class="panel order-card">
          <view class="order-card__head">
            <view>
              <view class="order-title-row"><text class="list-row__title">{{item.roundText}} · {{item.statusText}}</text><text a:if="{{item.pricingLabel}}" class="pricing-badge pricing-badge--{{item.pricingKind}}">{{item.pricingLabel}}</text></view>
              <text class="list-row__meta">{{item.sourceText}} · {{item.createdAtText}}</text>
            </view>
            <view class="order-card__amount"><text class="amount">{{item.payableText}}</text><text>{{item.paymentText}}</text></view>
          </view>
          <view class="payment-line">
            <text class="payment-line__hint">{{item.paymentHint}}</text>
            <button a:if="{{item.canPay}}" class="payment-line__button" loading="{{busyOrderId === item.publicId}}" disabled="{{!!busyOrderId}}" data-id="{{item.publicId}}" onTap="continuePayment">继续支付</button>
          </view>
          <view a:for="{{item.items}}" a:for-item="product" a:key="key" class="list-row">
            <view class="list-row__main"><text class="list-row__title">{{product.name}} ×{{product.quantity}}</text><text class="list-row__meta">{{product.statusText}}</text></view>
          </view>
        </view>
      </view>
      <state-panel a:else type="empty" title="当前暂无订单" message="下单后，商品与出品进度会显示在这里" />
    </view>
  </block>
</view>
