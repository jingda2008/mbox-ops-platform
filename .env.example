# local | test | staging | production
MBOX_RUNTIME_MODE=local

# Required in staging and production. Use a secret manager, never commit the real value.
MBOX_SESSION_SECRET=
MBOX_QR_SECRET=
# Temporary migration key for previously printed static table QRs. Never use it to sign new sessions.
MBOX_QR_PREVIOUS_SECRET=

# json for local/test; production is forced to postgres.
MBOX_REPOSITORY=json
MBOX_JSON_STATE_PATH=.runtime/state.json
DATABASE_URL=
MBOX_TENANT_ID=
MBOX_STORE_UUID=
MBOX_DATABASE_POOL_MAX=10
MBOX_DATABASE_MUTATION_QUEUE_MAX=100
MBOX_DATABASE_MUTATION_QUEUE_WAIT_MS=15000
MBOX_STATE_READ_CACHE_MS=3000
MBOX_TENANT_CODE=
MBOX_TENANT_NAME=
MBOX_STORE_CODE=
MBOX_INITIAL_STATE_PATH=
# One-time provisioning guard. Set to PROVISION only for an approved initial import.
MBOX_CONFIRM_PROVISION=
MBOX_GUEST_BASE_URL=http://localhost:5173/guest
# Staff-side payment QR target. Use the HTTPS guest domain in staging/production.
VITE_MBOX_GUEST_BASE_URL=http://localhost:5173/guest
MBOX_QR_OUTPUT_DIR=private/table-qrs
MBOX_CONFIRM_QR_GENERATION=

# Optional production mini-program identity. Store all real secrets in a secret manager.
MBOX_WECHAT_ENABLED=false
MBOX_WECHAT_APP_ID=
MBOX_WECHAT_APP_SECRET=
MBOX_WECHAT_STATE_SECRET=
MBOX_WECHAT_ENCRYPTION_KEY_VERSION=1
MBOX_WECHAT_ENCRYPTION_KEY_BASE64=

# Optional Postar/Xingyi payment provider. Keep disabled until KYC and UAT are complete.
MBOX_POSTAR_ENABLED=false
MBOX_POSTAR_ENVIRONMENT=test
MBOX_POSTAR_MERCHANT_ID=
MBOX_POSTAR_AGENCY_ID=
MBOX_POSTAR_PUBLIC_KEY=
MBOX_POSTAR_CALLBACK_URL=
MBOX_POSTAR_CALLBACK_SUCCESS_CODE=000000
# Fallback only; new QR payments derive 1/2/9 from Alipay/WeChat/UnionPay callback data.
MBOX_POSTAR_REFUND_TAG=2
MBOX_POSTAR_HTTP_TIMEOUT_MS=10000
# Normalized runtime aliases. Use the same provider values, never duplicate secrets in source control.
MBOX_PAYMENT_PROVIDER=
POSTAR_ENVIRONMENT=
POSTAR_AGENCY_ID=
POSTAR_MERCHANT_ID=
POSTAR_PUBLIC_KEY=
POSTAR_CALLBACK_URL=
POSTAR_HTTP_TIMEOUT_MS=10000
POSTAR_WECHAT_APP_ID=
# 5=official account, 8=mini program
POSTAR_WECHAT_TRADE_TYPE=
MBOX_TRUST_PROXY_HOPS=0

# Optional customer notification delivery. Recipient identities must already be bound.
MBOX_NOTIFICATION_HTTP_TIMEOUT_MS=10000
MBOX_SERVICE_ACCOUNT_NOTIFICATIONS_ENABLED=false
MBOX_SERVICE_ACCOUNT_NOTIFICATION_APP_ID=
MBOX_SERVICE_ACCOUNT_NOTIFICATION_APP_SECRET=
MBOX_SERVICE_ACCOUNT_NOTIFICATION_TEMPLATES_JSON=
MBOX_WECOM_NOTIFICATIONS_ENABLED=false
MBOX_WECOM_CORP_ID=
MBOX_WECOM_CORP_SECRET=
MBOX_WECOM_AGENT_ID=
# Staff delivery map and optional external SOP adapters. Missing adapters stay visibly unconfigured.
MBOX_SOP_WECOM_EMPLOYEE_USER_IDS_JSON=
MBOX_SOP_HEADSET_WEBHOOK_URL=
MBOX_SOP_HEADSET_WEBHOOK_TOKEN=
MBOX_SOP_CAMERA_WEBHOOK_URL=
MBOX_SOP_CAMERA_WEBHOOK_TOKEN=

# Comma-separated exact origins. Production origins must use HTTPS.
MBOX_CORS_ORIGINS=http://localhost:5173
MBOX_PUBLIC_BASE_URL=http://localhost:8787

# Optional staging-only employee verification login. Never enable in production.
MBOX_PILOT_ACCESS_CODE=
MBOX_VOICE_TRANSCRIPTION_PROVIDER=disabled
MBOX_ASSISTANT_PROVIDER=disabled
MBOX_GEMINI_API_KEY=
MBOX_GEMINI_MODEL=gemini-3.5-flash
# Optional HTTPS relay for regions that cannot directly reach the Gemini API.
MBOX_GEMINI_ENDPOINT=
MBOX_QWEN_API_KEY=
MBOX_QWEN_MODEL=qwen3.7-plus
# Example: https://ws-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
MBOX_QWEN_ENDPOINT=
MBOX_ASSISTANT_HTTP_TIMEOUT_MS=20000
# JSON object keyed by employee id. Values must be unique 4-digit PINs.
MBOX_PILOT_EMPLOYEE_PINS_JSON=
MBOX_PILOT_SESSION_HOURS=6
# Staging-only non-settling payment simulator. Production rejects this setting.
MBOX_PILOT_PAYMENT_SIMULATION_ENABLED=false

# Required in staging and production. Protects /api/metrics.
MBOX_METRICS_TOKEN=
MBOX_LOG_LEVEL=info
MBOX_BODY_LIMIT_BYTES=1048576
MBOX_SHUTDOWN_GRACE_MS=10000

API_HOST=0.0.0.0
API_PORT=8787
