<view class="page">
  <button wx:for="{{proposals}}" wx:key="id" bindtap="openProposal" data-id="{{item.id}}">核对服务员代选的 {{item.name}} × {{item.quantity}}桌</button>
  <view wx:if="{{selected}}" class="section">
    <view class="title">{{selected.name}}</view><view wx:if="{{selected.saleText}}">{{selected.saleText}}</view><view>{{selected.time}} · {{selected.location}}</view>
    <view>{{selected.areaName}}一整桌 · {{selected.price}}／桌<text wx:if="{{selected.giftPoints}}"> · 每张赠 {{selected.giftPoints}} 积分</text></view>
    <view>可只看演出。付款后出票，门店按已验证手机号联系安排具体桌号。入场按本场核准容量安排。</view>
    <view wx:if="{{selected.giftPoints}}">积分可抵菜品、酒水及餐饮套餐。自付款起至次年同月同日全天有效，闰日对应次年2月28日。今天付款可用至 {{selected.validThroughIfPaidToday}} 当天结束。赠分不能单独退现。</view>
    <view>举办方 {{selected.organizer}} · 售票方 {{selected.seller}} · {{selected.approvalReference}}</view>
    <view>{{selected.performers}} · 至少 {{selected.durationMinutes}} 分钟 · {{selected.programNote}}</view>
    <view>退票时段及费用：{{selected.refundSchedule}} · 客服 {{selected.serviceContact}}</view>
    <view>{{selected.refundSummary}}。退票时收回该票赠分，已抵扣的菜款按原菜价、原实付及退票原因核算。</view>
    <view>{{selected.safetySummary}}</view>
    <radio-group wx:if="{{eligibleReservations.length}}" bindchange="chooseReservation"><view>是否沿用本人已订的桌</view><label><radio value="" checked="{{!reservationLockId}}"/>另购一桌</label><label wx:for="{{eligibleReservations}}" wx:key="id"><radio value="{{item.id}}"/>{{item.tableName}} · {{item.reference}}</label></radio-group>
    <label>购买桌数<input type="number" value="{{quantity}}" bindinput="quantity" disabled="{{busy || proposalId}}"/></label>
    <view wx:if="{{summary}}">{{summary}}</view>
    <checkbox-group bindchange="agree"><label><checkbox value="yes" checked="{{agreed}}"/>已阅读本场入场、退票和赠分说明</label></checkbox-group>
    <button wx:if="{{member && phone && !originalOrder && !selected.saleText}}" bindtap="buy" disabled="{{busy || !agreed || (!selected.remaining && !reservationLockId)}}" loading="{{busy}}">微信支付购票</button>
  </view>
    <block wx:if="{{selected && ((terms && !member) || (member && !phone))}}">
      <view>授权本人手机号，用于接收积分及门店安排桌位。</view>
      <navigator wx:if="{{!member}}" url="/pages/membership-terms/index">{{terms.title || '会员服务协议'}}</navigator>
      <button open-type="getPhoneNumber" bindgetphonenumber="authorize" disabled="{{busy || (!member && !terms)}}">{{member ? '授权本人手机号' : '同意会员协议并授权手机号'}}</button>
    </block>
  <view class="section"><view class="title">可选场次</view>
    <button wx:for="{{offers}}" wx:key="id" data-id="{{item.id}}" bindtap="select" disabled="{{busy}}">{{item.time}} · {{item.name}} · {{item.price}}／桌 {{item.saleText}}</button>
  </view>
  <view class="section"><view class="title">我的门票</view>
    <view wx:if="{{originalOrder}}">已建立购票单 {{originalOrder}}，收款、出票和赠分进度见下方原单。<button size="mini" bindtap="chooseAnother" disabled="{{busy}}">另买一单</button></view>
    <view wx:for="{{mine}}" wx:key="registrationPublicId" class="ticket">
      <view>{{item.time}} · {{item.name}} × {{item.quantity}}桌 · {{item.total}}</view>
      <view wx:if="{{item.purchaseTerms.schedule}}">购票时退票约定：{{item.purchaseTerms.schedule}}</view>
      <button wx:if="{{item.paymentStatus === 'pending'}}" data-id="{{item.registrationPublicId}}" bindtap="resume" disabled="{{busy}}">继续付款／核对原单</button>
      <view wx:if="{{item.status === 'cancelled' && !item.lateUnissued}}">{{item.cashRefundStatus==='succeeded'?'未出票款已原路退回':'原单已关闭'}}</view>
      <view wx:if="{{!item.tickets.length && item.status==='refunded'}}">未出票款已原路退回</view>
      <view wx:if="{{item.lateUnissued}}">原单超时后收到票款，未出票及赠分。{{item.cashRefundPending ? '原票款退款已申请' : ''}}</view>
      <button wx:if="{{item.lateUnissued && !item.cashRefundPending}}" size="mini" data-order="{{item.registrationPublicId}}" bindtap="refund" disabled="{{busy}}">申请退回未出票款</button>
      <view wx:for="{{item.tickets}}" wx:for-item="ticket" wx:key="id">第{{ticket.number}}张 · {{ticket.tableName || '桌号待安排'}} · 票号 {{ticket.id}}
        <text wx:if="{{ticket.doorCode && !ticket.refundStatus}}">现场入场码 {{ticket.doorCode}}</text>
        <text wx:if="{{item.giftPoints && !ticket.refundStatus}}">{{ticket.pointsPosted ? "赠分已到账" : "赠分待入账"}} · 每张赠 {{item.giftPoints}} 分<text wx:if="{{ticket.pointsPosted}}">，批次剩余 {{ticket.remainingPoints}} 分</text> · 有效至 {{ticket.validThrough}}</text>
        <text wx:if="{{ticket.refundStatus}}">{{ticket.cashZero ? '退票已办结，本次应退现金为零' : ticket.refundStatus === 'refunded' ? '已退款' : ticket.refundStatus === 'review' ? '退票待核算' : '原退款审核处理中'}}</text>
        <view wx:if="{{ticket.refundDetail}}">申请原因：{{ticket.refundDetail.reason}}<text wx:if="{{ticket.refundDetail.decision}}"> · 处理依据：{{ticket.refundDetail.decision}}</text><text wx:if="{{ticket.refundDetail.cashMinor}}"> · {{ticket.refundDetail.cashStatus==='succeeded' ? '已退票款' : '申请退回票款'}} ¥{{ticket.refundDetail.cashMinor / 100}}</text></view>
        <button wx:if="{{ticket.refundStatus==='review'}}" size="mini" bindtap="withdraw" data-ticket="{{ticket.id}}" disabled="{{busy}}">撤回退票申请</button>
        <view wx:for="{{ticket.dining}}" wx:for-item="bill" wx:key="id">
          <view>{{bill.reason}}</view><view wx:for="{{bill.items}}" wx:for-item="line" wx:key="portionId">{{line.orderNo}} · {{line.name}} · 原价 ¥{{line.priceMinor / 100}} · 本票已抵 ¥{{line.usedMinor / 100}}</view>
          <button wx:if="{{!bill.confirmed && bill.caseStatus==='review' && !bill.closing}}" data-id="{{bill.id}}" data-amount="{{bill.amountMinor}}" bindtap="confirmDining" disabled="{{busy}}">确认补款 ¥{{bill.amountMinor / 100}}</button>
          <text wx:elif="{{bill.confirmed}}">{{bill.paymentStatus === 'refunded' ? '补菜款已退回' : bill.paymentStatus === 'partially_refunded' ? '补菜款已部分退回' : bill.paymentStatus === 'succeeded' ? '菜款已收' : bill.caseStatus==='review' && !bill.closing ? '已确认，等待门店在原菜品单收款' : '补款处理已结束'}} · ¥{{bill.returnedMinor ? bill.returnedMinor / 100 : bill.amountMinor / 100}}</text>
        </view>
        <button wx:if="{{!ticket.refundStatus}}" size="mini" data-order="{{item.registrationPublicId}}" data-ticket="{{ticket.id}}" bindtap="refund" disabled="{{busy}}">原单退票</button>
      </view>
    </view>
  </view>
  <view wx:if="{{error}}" role="alert">{{error}}</view><button bindtap="refresh" disabled="{{busy}}">刷新</button>
</view>
