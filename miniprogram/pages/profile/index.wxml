<view class="page profile-page">
  <view class="top-band profile-band"><view class="brand"><view class="brand-mark">M</view><text>M-BOX MEMBER</text></view><text class="profile-greeting">今晚，按你的方式来</text></view>
  <state-panel wx:if="{{loading}}" type="loading" title="正在读取会员资料" />
  <block wx:else><view wx:if="{{error}}" class="error-banner">{{error}}</view>
    <view wx:if="{{membership}}" class="member-card"><view><text>{{membership.level}}</text><text>{{membership.memberNo}}</text></view><text class="points-number">{{membership.pointsBalance}}</text><text>当前积分</text><view class="member-stats"><text>到店 {{membership.visitCount}} 次</text><text>{{membership.lifecycleStage}}</text></view></view>
    <view wx:else class="join-band"><text>成为 M-BOX 会员</text><text>保留到店偏好、积分、活动资格和专属权益</text><button bindtap="becomeMember" loading="{{busy}}">自然加入</button></view>
    <view class="section"><view class="section-title"><text>我的到店偏好</text><text class="section-link">服务时参考</text></view><view class="panel"><label class="field"><text class="field__label">常喝酒水</text><picker mode="selector" range="{{alcoholOptions}}" range-key="name" value="{{alcoholIndex}}" bindchange="onAlcoholChange"><view class="picker-field">{{alcoholOptions[alcoholIndex].name}}</view></picker></label><label class="field"><text class="field__label">希望的服务方式</text><picker mode="selector" range="{{serviceOptions}}" range-key="name" value="{{serviceIndex}}" bindchange="onServiceChange"><view class="picker-field">{{serviceOptions[serviceIndex].name}}</view></picker></label><button class="primary-button" bindtap="savePreferences" loading="{{busy}}">保存偏好</button></view></view>
    <view class="section"><view class="section-title"><text>最近积分</text><text class="section-link">{{points.length}} 条</text></view><view class="panel"><view wx:for="{{points}}" wx:key="id" class="point-row"><view><text>{{item.reason}}</text><text>{{item.occurredAt}}</text></view><text class="{{item.pointsDelta > 0 ? 'positive' : ''}}">{{item.pointsDelta > 0 ? '+' : ''}}{{item.pointsDelta}}</text></view><text wx:if="{{!points.length}}" class="empty-copy">还没有积分记录</text></view></view>
  </block>
</view>
