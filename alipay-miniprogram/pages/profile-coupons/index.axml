<view class="page coupons-page">
  <navigator url="/pages/profile-cards/index" class="coupon-more">兴趣卡与联名卡 ›</navigator>
  <view class="coupons-hero"><text>M-BOX · 优惠券</text><text>我的优惠券</text><text>查看待生效、可用与历史权益。时间均为北京时间。</text></view>
  <state-panel a:if="{{loading}}" type="loading" title="正在读取优惠券" />
  <block a:else>
    <view a:if="{{error}}" class="error-banner">{{error}}<button class="secondary-button" onTap="load">重新读取优惠券</button></view>
    <block a:elif="{{coupons.length}}">
      <view class="coupon-list">
        <view a:for="{{coupons}}" a:key="id" class="coupon-card">
          <view class="coupon-card__head"><text>{{item.typeText}}</text><text>{{item.stateText}}</text></view>
          <text class="coupon-title">{{item.title}}</text>
          <text class="coupon-copy">{{item.description}}</text>
          <text class="coupon-copy">{{item.quantityText}}</text>
          <text a:if="{{item.calendarText}}" class="coupon-copy">{{item.calendarText}}</text>
          <text a:if="{{item.calendarNextText}}" class="coupon-copy">{{item.calendarNextText}}</text>
          <text a:if="{{item.calendarLimitText}}" class="coupon-copy">{{item.calendarLimitText}}</text>
          <view class="coupon-foot"><text a:if="{{item.valueText}}">{{item.valueText}}</text><text>{{item.validText}}</text></view>
        </view>
      </view>
      <view a:if="{{moreError}}" class="error-banner">{{moreError}}</view>
      <button a:if="{{nextCursor}}" class="secondary-button coupon-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" onTap="loadMore">{{moreError ? '重试加载更多' : '加载更多权益'}}</button>
    </block>
    <state-panel a:else type="empty" title="暂无优惠券" message="门店发放后会出现在这里；也可在会员卡查看权益。" />
  </block>
</view>
