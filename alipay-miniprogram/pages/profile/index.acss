.benefit-tip view text:last-child { margin-top: 6rpx; color: rgba(255,255,255,.82); font-size: 20rpx; }
.benefit-tip > text { flex: 0 0 auto; font-size: 22rpx; font-weight: 650; }


.account-footer {
  margin-top: 28rpx;
  padding: 8rpx 0 calc(16rpx + env(safe-area-inset-bottom));
}
.logout-button {
  width: 100%;
  min-height: 72rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #8a8278;
  font-size: 28rpx;
  line-height: 72rpx;
}
.logout-button::after { border: 0; }
@media (max-width: 390px) { .profile-hero { margin-right: -22rpx; margin-left: -22rpx; padding-right: 22rpx; padding-left: 22rpx; } }
@media (max-width: 360px) { .profile-hero { margin-right: -18rpx; margin-left: -18rpx; padding-right: 18rpx; padding-left: 18rpx; } }
/* Override the historical duplicate sheet block: compact screens keep a
   touchable close action and scroll the sheet instead of trapping its footer. */
.login-sheet-mask { padding: 0; }
.login-sheet { max-height: calc(100vh - env(safe-area-inset-bottom)); overflow-y: auto; }
.login-sheet__close { z-index: 1; top: 0; right: 0; }
@media (max-width: 390px) { .login-sheet { padding-right: 22rpx; padding-left: 22rpx; } }
@media (max-width: 360px) { .login-sheet { max-height: calc(100vh - 4px); padding-right: 18rpx; padding-left: 18rpx; } .login-sheet__close { top: 0; right: 0; } }
