.profile-contact-page { min-height: 100vh; padding: 0 28rpx 52rpx; background: #f7f5f0; }
.contact-hero { display: flex; margin: 0 -28rpx 30rpx; padding: 52rpx 38rpx 38rpx; flex-direction: column; gap: 10rpx; background: linear-gradient(145deg, #1d392a, #315d46); color: #fffdf8; }.contact-hero text:first-child { color: #d9e7dc; font-size: 19rpx; font-weight: 700; letter-spacing: 3rpx; }.contact-hero text:nth-child(2) { font-family: "Songti SC", "STSong", serif; font-size: 50rpx; font-weight: 650; }.contact-hero text:last-child { color: #dce8df; font-size: 24rpx; }
.contact-card,.wecom-card { margin-bottom: 20rpx; padding: 30rpx; border: 1rpx solid #dce4dc; border-radius: 24rpx; background: #fffdfa; box-shadow: 0 12rpx 28rpx rgba(29, 57, 42, .07); }.contact-card text,.wecom-card text { display: block; }.contact-card text:first-child,.wecom-card text:first-child { color: #698071; font-size: 21rpx; }.contact-card text:nth-child(2) { margin-top: 12rpx; color: #203a2b; font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }.contact-card text:nth-child(3) { margin-top: 12rpx; color: #748077; font-size: 22rpx; line-height: 1.55; }.contact-call { width: 100%; margin-top: 24rpx; border-radius: 999rpx; background: #315d46; color: #fff; font-size: 28rpx; font-weight: 700; }
.wecom-card { display: flex; align-items: center; gap: 24rpx; }.wecom-card image { width: 174rpx; height: 174rpx; padding: 8rpx; border: 1rpx solid #e3e8e2; border-radius: 16rpx; background: #fff; }.wecom-card view { flex: 1; }.wecom-card text:last-child { margin-top: 10rpx; color: #748077; font-size: 22rpx; line-height: 1.55; }.contact-boundary { display: block; padding: 8rpx 12rpx; color: #879087; font-size: 20rpx; line-height: 1.6; }
