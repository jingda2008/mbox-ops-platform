<view class="page channel-page">
  <view wx:if="{{loading}}" class="card">正在读取优惠…</view>
  <view wx:if="{{offer}}" class="card featured">
    <text class="title">{{offer.title}}</text><text class="offer">{{offer.offerText}}</text>
    <text>推荐来源：{{offer.sourceLabel}}</text><text>满 {{offer.minimumText}} 可用 · {{offer.productText}}</text>
    <text>领取：{{offer.claimTimeText}}</text><text>使用：{{offer.timeText}}（北京时间）</text>
    <text>每人限领 {{offer.perCustomerClaims}} 次 · 每组顾客每次到店限用 {{offer.perVisitUses}} 次</text>
    <template is="couponRules" data="{{coupon: offer, ruleId: 'offer', expandedRules: expandedRules}}"/>
    <text wx:if="{{offer.existingClaimId}}">本优惠已在本人账户，可在下方“本次推广已领券”直接查看和使用。</text>
    <text wx:if="{{offer.unavailable}}">{{offer.unavailable}}</text>
    <button wx:if="{{!offer.unavailable && !pendingClaim}}" bindtap="claim" loading="{{busy}}" disabled="{{busy || loading}}">{{offer.claimedCount ? '再领取一张到本人账户' : '立即领取到本人账户'}}</button>
  </view>
  <button wx:if="{{pendingClaim}}" bindtap="recoverClaim" disabled="{{busy || loading}}">核对上次领取（不重复领券）</button>
  <view wx:if="{{offer.existingCoupon}}" class="card featured">
    <button wx:if="{{offer.existingCoupon.canRecover}}" data-id="{{offer.existingCoupon.id}}" bindtap="recoverCoupon" disabled="{{busy || loading}}">核对上次绑定</button>
    <text class="title">本次推广已领券</text><text>{{offer.existingCoupon.offerText}} · {{offer.existingCoupon.stateText}}</text>
    <template is="couponRules" data="{{coupon: offer.existingCoupon, ruleId: 'claimed', expandedRules: expandedRules}}"/><text>{{offer.existingCoupon.timeText}}（北京时间）</text><text>适用商品：{{offer.existingCoupon.productText}}</text>
    <button wx:if="{{offer.existingCoupon.status === 'available' && !offer.existingCoupon.canRecover}}" data-id="{{offer.existingCoupon.id}}" class="use-at-table" bindtap="useCoupon" disabled="{{busy || loading || checkingTable}}">{{!hasTable || tableRetryId === offer.existingCoupon.id ? '扫桌码使用' : '使用本次推广已领券'}}</button>
  </view>
  <view wx:if="{{needsLogin}}" class="card"><text>请先登录本人账号，登录后会回到这张优惠。</text><button bindtap="login">登录并返回领券</button></view>
  <view wx:if="{{!offer && !loading && !needsLogin}}" class="card coupon-entry">
    <text class="title">领取推荐优惠</text>
    <button class="primary-button" bindtap="scan" disabled="{{busy}}">扫码领券</button>
    <button class="coupon-link" bindtap="toggleManualEntry" aria-expanded="{{manualEntry}}">{{manualEntry ? '收起号码输入' : '手动输入优惠号码'}}</button>
    <view wx:if="{{manualEntry}}" class="code-entry">
      <input value="{{code}}" maxlength="100" disabled="{{busy}}" placeholder="输入图片上的优惠号码" bindinput="inputCode" />
      <button bindtap="load" disabled="{{busy || !code}}">查看优惠</button>
    </view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{!needsLogin && !loading}}" class="wallet-heading">
    <text class="title">我的优惠券</text><button class="coupon-link" bindtap="load" disabled="{{busy}}">刷新</button>
  </view>
  <text wx:if="{{!coupons.length && !error && !loading && !needsLogin}}" class="wallet-empty">{{filterIndex ? '这个分类里还没有券' : '还没有优惠券'}}</text>
  <picker wx:if="{{coupons.length || filterIndex}}" range="{{filters}}" range-key="label" value="{{filterIndex}}" bindchange="filterChanged" disabled="{{busy}}"><view class="card">我的券：{{filters[filterIndex].label}} · 点击筛选</view></picker>
  <view class="card" wx:for="{{coupons}}" wx:key="id"><button wx:if="{{item.canRecover}}" data-id="{{item.id}}" bindtap="recoverCoupon" disabled="{{busy || loading}}">核对上次绑定</button><text class="title">{{item.title}}</text><text>{{item.offerText}} · {{item.stateText}}</text><text>推荐来源：{{item.sourceLabel}}</text><text>优惠号码：{{item.offerCode}}</text><text>适用商品：{{item.productText}}</text><text>满 {{item.minimumText}} 可用 · 每人限领 {{item.perCustomerClaims}} 次 · 每组顾客每次到店限用 {{item.perVisitUses}} 次</text><template is="couponRules" data="{{coupon: item, ruleId: item.id, expandedRules: expandedRules}}"/><text>{{item.timeText}}（北京时间）</text><button wx:if="{{item.status === 'available' && !item.canRecover}}" data-id="{{item.id}}" class="use-at-table" bindtap="useCoupon" disabled="{{busy || loading || checkingTable}}">{{!hasTable || tableRetryId === item.id ? '扫桌码使用' : '使用到当前桌次'}}</button></view>
  <button wx:if="{{nextCursor}}" bindtap="loadMore" disabled="{{loading || loadingMore || busy}}">{{loadingMore ? '正在读取…' : '加载更多优惠券'}}</button>
  <text wx:if="{{!loading && !nextCursor && coupons.length}}">当前筛选的优惠券已全部显示</text>

</view>

<template name="couponRules">
  <button class="coupon-rules-toggle" bindtap="toggleCouponRules" data-id="{{ruleId}}" aria-expanded="{{expandedRules === ruleId}}">用券说明 {{expandedRules === ruleId ? '⌃' : '⌄'}}</button>
  <view wx:if="{{expandedRules === ruleId}}" class="coupon-rule-copy">
    <text>{{coupon.stackingText}}</text>
    <text>领取时以券的余量和使用条件为准。本券不能与会员券、积分优惠叠加。</text>
    <text wx:if="{{coupon.offer.kind === 'gift'}}">领券或绑定桌号不会预留赠品。请在到店使用时确认余量，缺货经双方确认后更换。</text>
  <text>已兑现记录保留；退款不自动退券或恢复已使用的优惠额度。结果有疑问请刷新或联系服务员核对。</text>
  <text>换桌或拆单不增加次数；需符合最低消费及适用商品条件。到店后也可请服务员核对本人及优惠号码办理。</text>
  <text>自行绑定后，请服务员核对本人及到店情况；单独扫描桌码不作为已到店证明。</text>
  </view>
</template>
