/* Checkout outcome is explicit: WeChat acceptance is not labelled as store
   settlement until the table ledger confirms it. */
.payment-result { z-index: 60; align-items: flex-end; }
.payment-result__sheet { position: relative; width: 100%; padding: 38rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fffcf7; box-shadow: 0 -18rpx 58rpx rgba(25, 20, 16, .24); text-align: center; }
.payment-result__close { position: absolute; top: 18rpx; right: 22rpx; display: flex; width: 138rpx; min-width: 138rpx; height: 76rpx; min-height: 76rpx; margin: 0; padding: 0; align-items: center; justify-content: center; border: 1rpx solid #d6cec4; border-radius: 38rpx; background: #f5f1eb; box-shadow: 0 4rpx 12rpx rgba(45, 38, 31, .08); color: #62594f; font-size: 20rpx; font-weight: 650; line-height: 1; }
.payment-result__close::after { border: 0; }
.payment-result__close--pressed { background: #eae4dc; transform: scale(.97); }
.payment-result__mark { display: flex; width: 76rpx; height: 76rpx; margin: 10rpx auto 18rpx; align-items: center; justify-content: center; border-radius: 50%; background: #eef0ec; color: #615b53; font-size: 38rpx; font-weight: 750; }
.payment-result__mark--success { background: #e4f0e8; color: #315d46; }
.payment-result__mark--pending { background: #f4ecd9; color: #856430; }
.payment-result__mark--failed, .payment-result__mark--cancelled { background: #f4e6e3; color: #8a493e; }
.payment-result__title, .payment-result__copy { display: block; }
.payment-result__title { color: #2f2924; font-family: "Songti SC", "STSong", serif; font-size: 34rpx; font-weight: 650; }
.payment-result__copy { max-width: 610rpx; margin: 12rpx auto 0; color: #746b62; font-size: 22rpx; line-height: 1.6; }
.payment-result__actions { display: flex; margin-top: 26rpx; align-items: center; justify-content: flex-end; gap: 10rpx; }
.payment-result__actions button { width: 220rpx; min-width: 0; min-height: 76rpx; margin: 0; padding: 0 8rpx; flex: 0 0 220rpx; border-radius: 38rpx; font-size: 20rpx; line-height: 76rpx; white-space: nowrap; }
.payment-result__actions .primary-button { width: 250rpx; flex-basis: 250rpx; }

@media (max-width: 360px) {
  .order-page { padding-top: 12rpx; }
  .order-head { margin-right: -18rpx; margin-left: -18rpx; padding-right: 18rpx; padding-left: 18rpx; }
  .table-strip { padding: 16rpx 18rpx; }
  .table-strip__content { grid-template-columns: minmax(0, 1fr) 150rpx; }
  .table-strip__service { min-height: 76rpx; padding-left: 10rpx; }
  .table-strip__service-value { font-size: 18rpx; }
  .show-brief, .show-brief--retry { min-height: 76rpx; }
  .quick-service__surface { min-height: 40px; padding: 0 6rpx; }
  .quick-service__surface > text:last-child { font-size: 18rpx; }
  .recommend-entry { padding-top: 18rpx; }
  .recommend-entry__head > text { display: none; }
  .recommend-entry__actions button { min-height: 40px; }
  .recommend-question { padding-right: 18rpx; padding-left: 18rpx; }
  .recommend-question__sheet { padding-right: 18rpx; padding-left: 18rpx; }
  .recommend-question__close { min-width: 96rpx; min-height: 88rpx; line-height: 86rpx; }
  .recommend-question__head text:last-child { padding-right: 110rpx; font-size: 30rpx; }
  .recommend-question__options { gap: 8rpx; }
  .recommend-question__options button { min-height: 88rpx; padding: 8rpx; font-size: 20rpx; }
  .recommend-card { width: 470rpx; }
  .recommend-foot button { min-height: 40px; }
  .product-action button { width: 44px; height: 44px; border-radius: 22px; line-height: 44px; }
  .cart-dock { padding-right: 18rpx; padding-left: 18rpx; }
  .cart-summary { grid-template-columns: minmax(0, 1fr) 172rpx; gap: 8rpx; }
  .cart-overview { min-height: 44px; grid-template-columns: 48rpx minmax(0, 1fr); gap: 8rpx; }
  .cart-overview__copy > text:last-child { display: none; }
  .checkout-button { min-height: 44px; font-size: 22rpx; line-height: 44px; }
  .checkout-confirm__sheet { max-height: 90vh; padding-right: 18rpx; padding-left: 18rpx; }
  .checkout-confirm__head { min-height: 70rpx; }
  .checkout-confirm__title { font-size: 30rpx; }
  .checkout-confirm__close { width: 44px; min-width: 44px; height: 44px; min-height: 44px; padding: 0; border: 0; background: transparent; font-size: 32rpx; line-height: 44px; }
  .checkout-confirm__lines { max-height: 46vh; }
  .checkout-confirm__line { min-height: 96rpx; gap: 8rpx; }
  .checkout-confirm__actions { gap: 4rpx; }
  .checkout-confirm__actions button { width: 36px; height: 36px; border-radius: 18px; line-height: 36px; }
  .checkout-confirm__actions .checkout-confirm__remove { min-width: 36px; }
  .checkout-confirm__footer { gap: 8rpx; }
  .checkout-confirm__footer-button { min-height: 44px; line-height: 44px; }
  .payment-result__sheet { padding-right: 20rpx; padding-left: 20rpx; }
  .payment-result__close { top: 14rpx; right: 18rpx; width: 126rpx; min-width: 126rpx; min-height: 40px; height: 40px; border-radius: 20px; font-size: 19rpx; }
  .payment-result__actions { gap: 8rpx; }
  .payment-result__actions button { width: 204rpx; min-height: 40px; flex-basis: 204rpx; border-radius: 20px; font-size: 20rpx; line-height: 40px; }
  .payment-result__actions .primary-button { width: 232rpx; flex-basis: 232rpx; }
}

/* Cart and checkout must stay operable on foldable outer screens. */
.cart-dock,
.cart-summary,
.checkout-confirm,
.checkout-confirm__sheet,
.payment-result,
.payment-result__sheet {
  box-sizing: border-box;
  max-width: 100vw;
}

.cart-dock {
  width: 100%;
  overflow: hidden;
}

.cart-summary {
  width: 100%;
  min-width: 0;
}

.cart-overview {
  min-width: 0;
  overflow: hidden;
  cursor: pointer;
}

.cart-overview--pressed {
  opacity: .72;
}

.checkout-button {
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  width: calc(100% - 8rpx);
  min-height: 76rpx;
  overflow: hidden;
  padding: 0 10rpx;
  align-items: center;
  justify-content: center;
  justify-self: end;
  border-radius: 38rpx;
  font-size: 21rpx;
  line-height: 1.2;
  text-overflow: clip;
  white-space: nowrap;
}

.checkout-confirm {
  width: 100vw;
  overflow: hidden;
}

.checkout-confirm__sheet {
  position: relative;
  display: flex;
  width: 100%;
  max-height: calc(100vh - 8px);
  overflow: hidden;
  flex-direction: column;
}

.checkout-confirm__head,
.checkout-confirm__total,
.checkout-confirm__footer {
  flex: 0 0 auto;
}

.checkout-confirm__head {
  padding-right: 224rpx;
}

.checkout-confirm__close-slot {
  position: absolute;
  z-index: 2;
  top: 18rpx;
  right: 22rpx;
  width: 200rpx;
  height: 76rpx;
}

.checkout-confirm__close {
  display: flex;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 100%;
  min-height: 0;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d6cec4;
  border-radius: 38rpx;
  background: #f5f1eb;
  box-shadow: 0 4rpx 12rpx rgba(45, 38, 31, .08);
  color: #62594f;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1;
}

.checkout-confirm__close::after {
  border: 0;
}

.checkout-confirm__close--pressed {
  background: #eae4dc;
  transform: scale(.97);
}

.checkout-confirm__lines {
  min-height: 0;
  overflow: hidden;
  flex: 1 1 42vh;
}

.checkout-confirm__copy,
.checkout-confirm__total > view {
  min-width: 0;
}

.checkout-confirm__total {
  gap: 12rpx;
}

.checkout-confirm__total > text,
.checkout-confirm__footer-button {
  white-space: nowrap;
}

.checkout-confirm__footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
}

.checkout-confirm__footer-button {
  width: 176rpx;
  min-height: 76rpx;
  padding: 0 8rpx;
  flex: 0 0 176rpx;
  border-radius: 38rpx;
  font-size: 20rpx;
  line-height: 76rpx;
}

.checkout-confirm__footer .primary-button {
  width: 200rpx;
  flex-basis: 200rpx;
}

.payment-result__sheet {
  overflow: hidden;
}

@media (max-width: 360px) {
  .cart-summary {
    grid-template-columns: minmax(0, 1fr) 164rpx;
  }

  .cart-overview {
    padding-right: 2rpx;
    padding-left: 2rpx;
  }

  .cart-overview__copy > text:first-child {
    font-size: 24rpx;
  }

  .checkout-button {
    width: 156rpx;
    max-width: 100%;
    min-height: 40px;
    padding-right: 6rpx;
    padding-left: 6rpx;
    border-radius: 20px;
    font-size: 21rpx;
    line-height: 1.2;
  }

  .checkout-confirm__sheet {
    max-height: calc(100vh - 4px);
  }

  .checkout-confirm__lines {
    max-height: none;
    flex-basis: 46vh;
  }

  .checkout-confirm__line {
    padding-top: 16rpx;
    padding-bottom: 16rpx;
    align-items: stretch;
    grid-template-columns: minmax(0, 1fr);
  }

  .checkout-confirm__actions {
    justify-content: flex-end;
  }

  .checkout-confirm__total-price {
    font-size: 32rpx;
  }

  .checkout-confirm__footer-button {
    min-height: 40px;
    padding-right: 6rpx;
    padding-left: 6rpx;
    font-size: 20rpx;
    line-height: 40px;
  }
}
