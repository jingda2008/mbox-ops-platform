<view class="page terms-page">
  <state-panel a:if="{{loading}}" type="loading" title="正在读取当前入会条款" />
  <block a:else>
    <view a:if="{{error}}" class="error-banner">{{error}}</view>
    <state-panel a:if="{{!terms}}" type="empty" title="当前入会条款尚未发布" message="新入会暂未开放；点单、预约和找回原会员不受影响" />
    <block a:else>
      <view class="terms-head">
        <text class="terms-kicker">M-BOX 会员条款</text>
        <text class="terms-title">{{terms.title}}</text>
        <text class="terms-version">第 {{terms.version}} 版 · 生效时间 {{terms.effectiveFrom}}</text>
        <text class="terms-summary">{{terms.summary}}</text>
      </view>
      <view class="terms-content"><text user-select="true">{{terms.content}}</text></view>
      <view a:if="{{membership}}" class="terms-status">您已经是会员，本页仅供查看当前条款，不要求重复确认。</view>
      <view a:elif="{{allowEnrollment}}" class="terms-dock">
        <checkbox-group onChange="onAgreementChange">
          <label class="agree-row">
            <checkbox value="agree" checked="{{agreedToPolicies}}" color="#2d2925" />
            <text class="agree-copy">我已阅读并同意《用户服务协议》和《隐私政策》</text>
          </label>
        </checkbox-group>
        <view class="agree-links">
          <text onTap="openPrivacy">查看《隐私政策》</text>
        </view>
        <button a:if="{{agreedToPolicies}}" class="accept-button alipay-phone-button" onTap="acceptAndEnroll" hover-class="none" loading="{{busy}}">支付宝手机号入会暂未开通</button>
        <button a:else class="accept-button accept-button--pending" onTap="remindAgreement" hover-class="none">授权手机号并加入</button>
        <text class="terms-note">须先自行勾选同意后再授权手机号加入；未勾选或拒绝授权都不会入会。不会开启短信或营销。老客请回「我的」用「授权手机号找回会员」。</text>
      </view>
    </block>
  </block>
</view>
