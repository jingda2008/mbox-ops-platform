.community-page { padding-top: 0; }
.community-hero {
  position: relative;
  overflow: hidden;
  margin: 0 -28rpx 28rpx;
  padding: 28rpx 28rpx 44rpx;
  background:
    radial-gradient(circle at 90% 5%, rgba(198, 163, 105, 0.26), transparent 34%),
    linear-gradient(145deg, #0d1712, #234031 66%, #101512);
  color: #fff;
}
.community-hero::after {
  position: absolute;
  right: -100rpx;
  bottom: -180rpx;
  width: 360rpx;
  height: 360rpx;
  border: 1rpx solid rgba(210, 171, 115, 0.22);
  border-radius: 50%;
  content: "";
}
.community-hero__watermark {
  position: absolute;
  right: -28rpx;
  bottom: -36rpx;
  width: 260rpx;
  height: 260rpx;
  opacity: .12;
  pointer-events: none;
}
.community-hero__brand {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.community-hero__badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.community-hero__content {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  max-width: 640rpx;
}
.community-hero__logo {
  display: block;
  width: 78%;
  max-width: 460rpx;
  margin: 0 0 8rpx;
  background: transparent;
}
.community-hero__kicker {
  display: block;
  margin-top: 18rpx;
  color: #c8a675;
  font-size: 21rpx;
  letter-spacing: 4rpx;
}
.community-hero__title {
  display: block;
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.community-hero__copy {
  display: block;
  margin-top: 14rpx;
  max-width: 520rpx;
  color: #d2cec8;
  font-size: 24rpx;
  line-height: 1.55;
}


.activity-section-head {
  display: flex;
  margin: 0 2rpx 18rpx;
  align-items: flex-end;
  justify-content: space-between;
}
.activity-section-head view text { display: block; }
.activity-section-head view text:first-child {
  color: #203a2b;
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 650;
}
.activity-section-head view text:last-child {
  margin-top: 6rpx;
  color: #718176;
  font-size: 19rpx;
}
.activity-section-head > text {
  color: #315d46;
  font-size: 28rpx;
  font-weight: 750;
}

.activity-list { display: grid; gap: 22rpx; }
.activity-card {
  overflow: hidden;
  width: 100%;
  margin: 0;
  padding: 0;
  border: 1rpx solid #d7e4db;
  border-radius: 24rpx;
  background: #fffdfa;
  color: #213328;
  text-align: left;
  box-shadow: 0 12rpx 28rpx rgba(31, 74, 47, .07);
}
.activity-card::after { border: 0; }

.activity-art {
  position: relative;
  overflow: hidden;
  height: 236rpx;
  background: linear-gradient(145deg, #315d46, #1d3728);
}
.activity-art > image:first-child,
.activity-placeholder,
.activity-art__shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.activity-placeholder {
  display: flex;
  padding: 28rpx;
  flex-direction: column;
  justify-content: flex-end;
  gap: 12rpx;
  background: linear-gradient(145deg, #2a503b, #315d46 55%, #234433);
  color: #fffefa;
}
.activity-placeholder image {
  width: 86rpx;
  height: 86rpx;
  opacity: .9;
}
.activity-placeholder text {
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.3;
}
.activity-art__shade {
  background: linear-gradient(to bottom, rgba(8, 24, 16, .05), rgba(8, 24, 16, .42));
}
.activity-art__top {
  position: absolute;
  z-index: 1;
  top: 18rpx;
  right: 18rpx;
  left: 18rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}
.activity-art__top text {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 254, 250, .92);
  color: #315d46;
  font-size: 18rpx;
  font-weight: 700;
}
.activity-art__top text:last-child {
  background: rgba(49, 93, 70, .92);
  color: #fff;
}

.activity-card__body { padding: 20rpx 22rpx 24rpx; }
.activity-card__body text { display: block; }
.activity-sequence {
  color: #315d46;
  font-size: 16rpx;
  font-weight: 750;
  letter-spacing: 1.5rpx;
}
.activity-title {
  margin-top: 6rpx;
  color: #203429;
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.28;
}
.activity-summary {
  display: -webkit-box !important;
  overflow: hidden;
  margin-top: 8rpx;
  color: #647268;
  font-size: 21rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.activity-date {
  margin-top: 12rpx;
  color: #526158;
  font-size: 20rpx;
}
.activity-footer {
  display: flex;
  margin-top: 16rpx;
  padding-top: 14rpx;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #e4ede6;
}
.activity-fee {
  color: #315d46;
  font-size: 26rpx;
  font-weight: 800;
}
.activity-footer > text:last-child {
  color: #315d46;
  font-size: 20rpx;
  font-weight: 700;
}

@media (max-width: 350px) {
  .community-hero { padding: 28rpx 22rpx 30rpx; }
  .community-hero__logo { width: 78%; }
  .community-hero__title { font-size: 42rpx; }
  .activity-art { height: 210rpx; }
  .activity-title { font-size: 31rpx; }
}
