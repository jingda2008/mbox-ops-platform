{
  "name": "@mbox/ops-platform",
  "private": true,
  "version": "1.0.0-rc.84",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/normalized-server.ts",
    "dev:normalized": "tsx watch server/normalized-server.ts",
    "dev:legacy": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev:api:legacy\" \"npm:dev:web\"",
    "dev:api:legacy": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run build:normalized",
    "build:normalized": "tsc -p tsconfig.normalized-server.json && vite build",
    "build:legacy": "tsc -b && vite build && tsc -p tsconfig.server.json && node scripts/copy-runtime-assets.mjs",
    "typecheck:web": "tsc -b tsconfig.app.json tsconfig.node.json",
    "start": "node dist-normalized/server/normalized-server.js",
    "start:normalized": "node dist-normalized/server/normalized-server.js",
    "start:legacy": "node dist-server/server/index.js",
    "db:migrate": "tsx server/migrate.ts",
    "db:migrate:normalized": "tsx server/migrate-normalized.ts",
    "db:provision:normalized": "tsx server/provision-normalized-store.ts",
    "db:provision:normalized:catalog": "tsx server/provision-normalized-catalog.ts",
    "db:verify:normalized:commercial": "tsx server/verify-normalized-commercial-readiness.ts",
    "test:normalized": "vitest run server/migrate-normalized.test.ts server/provision-normalized-store.test.ts server/normalized src/normalized-ui --reporter=dot && node --test scripts/normalized-load-acceptance.test.mjs",
    "test:normalized:postgres": "node scripts/run-normalized-postgres-tests.mjs",
    "test:normalized:postgres:runner": "node --test scripts/run-normalized-postgres-tests.test.mjs",
    "test:normalized:load": "node --test scripts/normalized-load-acceptance.test.mjs",
    "acceptance:normalized:load": "node scripts/normalized-load-acceptance.mjs",
    "acceptance:normalized:http": "tsx scripts/run-normalized-http-acceptance.ts",
    "test:e2e:normalized": "playwright test --config playwright.normalized.config.ts",
    "db:verify": "node scripts/verify-database.mjs",
    "db:verify:time": "node scripts/verify-database-time.mjs",
    "db:verify:operational": "node scripts/verify-operational-read-path.mjs",
    "db:verify:kds": "node scripts/verify-kds-authoritative-transactions.mjs",
    "db:verify:checksum-upgrade": "tsx scripts/verify-checksum-migration-upgrade.ts",
    "db:verify:presence": "node scripts/verify-presence-leases.mjs",
    "db:provision": "tsx server/provision-runtime.ts",
    "demo:performance": "tsx server/load-demo-performance.ts",
    "qr:generate": "tsx server/generate-table-qrs.ts",
    "qr:generate:normalized": "tsx server/normalized/generate-table-qrs.ts",
    "qr:render:normalized": "node scripts/render-normalized-table-qr-pdfs.mjs",
    "pilot:access": "node scripts/print-pilot-access.mjs",
    "check": "npm run release:metadata && npm run architecture:normalized:verify && npm run architecture:normalized:new && npm run ci:classifier:test && npm run quality:evidence:test && npm run quality:tc-register:test && npm run quality:plan:test && npm run quality:model:verify && npm run runtime:quality:test && npm run typecheck:web && npm run lint && npm run check:miniprogram && npm run tc:verify && npm test && npm run build && npm run quality:seed:verify",
    "architecture:normalized:test": "node --test scripts/normalized-architecture-policy.test.mjs",
    "architecture:normalized:verify": "node scripts/verify-normalized-architecture.mjs",
    "architecture:normalized:new": "node scripts/verify-normalized-new-code.mjs",
    "architecture:normalized:zero": "node scripts/verify-normalized-architecture.mjs --require-zero",
    "ci:classifier:test": "node --test scripts/ci-change-scope.test.mjs",
    "quality:evidence:test": "node --test scripts/verify-quality-evidence.test.mjs scripts/write-ci-quality-evidence.test.mjs scripts/release-evidence-eligibility.test.mjs",
    "quality:evidence:verify": "node scripts/verify-quality-evidence.mjs",
    "quality:tc-register:test": "node --test scripts/verify-tc-register.test.mjs scripts/build-tc-reviewed-baseline.test.mjs scripts/verify-quality-model.test.mjs scripts/load-workload-model.test.mjs scripts/merge-rc68-load-reports.test.mjs",
    "quality:tc-register:verify": "node scripts/verify-tc-register.mjs",
    "quality:model:verify": "node scripts/verify-quality-model.mjs --state-machine docs/quality/mbox-kds-state-machine-v1.json --invariants docs/quality/mbox-invariant-register-v1.csv",
    "quality:plan:test": "node --test scripts/run-software-quality-plan.test.mjs",
    "quality:plan:run": "node scripts/run-software-quality-plan.mjs",
    "quality:seed:verify": "tsc -p tsconfig.server.json && node scripts/verify-deterministic-load-seed.mjs",
    "release:quality-gate": "node scripts/build-tc-execution-register.mjs --check --require-release-pass && node scripts/verify-quality-model.mjs --state-machine docs/quality/mbox-kds-state-machine-v1.json --invariants docs/quality/mbox-invariant-register-v1.csv --require-release-pass",
    "runtime:quality:test": "node --test scripts/analyze-runtime-logs.test.mjs scripts/verify-runtime-metrics.test.mjs scripts/run-local-rc68-load.test.mjs scripts/load-reference-time.test.mjs scripts/reset-runtime-metrics-window.test.mjs scripts/verify-sensitive-artifacts.test.mjs scripts/build-aliyun-evidence-bundle.test.mjs scripts/filter-sls-events.test.mjs scripts/aliyun-evidence-pipeline.test.mjs scripts/render-normalized-table-qr-pdfs.test.mjs deploy/ai-relay/deployment.test.mjs",
    "check:miniprogram": "node scripts/check-miniprogram.mjs",
    "lint": "oxlint src server",
    "test": "vitest run",
    "test:customer": "vitest run server/guest-api.test.ts server/client-responsibility-flow.test.ts && node scripts/prepare-e2e-state.mjs && playwright test tests/e2e/guest-sales-path.spec.ts tests/e2e/commercial-flows.spec.ts",
    "test:payment-simulation": "vitest run server/payment-domain.test.ts server/payment-api.test.ts server/payment-provider.test.ts server/payment-provider-api.integration.test.ts server/guest-postar-payment.integration.test.ts server/assisted-payment-flow.test.ts server/payment-reconciliation.test.ts server/table-operations.test.ts server/night-operations-simulation.test.ts server/business-day-api.test.ts server/authorization.test.ts server/commercial-idempotency.test.ts server/gift-policy.test.ts server/order-domain.test.ts server/complex-refund-operations.test.ts",
    "test:integration": "npm run test:payment-simulation",
    "test:security": "vitest run server/authorization.test.ts server/pilot-auth.test.ts server/reservation-authorization.test.ts server/table-access.test.ts server/log-redaction.test.ts server/commercial-idempotency.test.ts",
    "test:performance": "npm run test:load:rc68:route-suite",
    "test:e2e": "node scripts/prepare-e2e-state.mjs && playwright test",
    "test:e2e:smoke": "node scripts/prepare-e2e-state.mjs && playwright test tests/e2e/ui-smoke.spec.ts",
    "test:e2e:headed": "node scripts/prepare-e2e-state.mjs && playwright test --headed",
    "test:load": "node scripts/run-k6-local.mjs",
    "test:load:rc68": "node scripts/rc68-mixed-load.mjs",
    "test:load:rc68:local": "bash scripts/run-local-rc68-load.sh",
    "test:load:rc68:route-suite": "bash scripts/run-local-rc68-route-suite.sh",
    "test:browser-startup": "node scripts/measure-browser-startup.mjs",
    "test:commercial": "npm run check && npm run test:e2e && npm run test:load && npm run test:load:rc68",
    "test:voice": "vitest run src/components/voice-command.test.ts src/components/voice-command-agent.test.ts src/components/voice-command-dictionary.test.ts src/components/voice-page-controls.test.ts src/components/voice-speech.test.ts",
    "test:watch": "vitest",
    "tc:register": "node scripts/build-tc-execution-register.mjs",
    "tc:verify": "node scripts/build-tc-execution-register.mjs --check",
    "evidence:capture": "node scripts/capture-release-evidence.mjs",
    "release:metadata": "node scripts/verify-release-metadata.mjs",
    "release:verify": "node scripts/verify-release-smoke.mjs && node scripts/verify-release-browser.mjs",
    "release:config:generate": "tsx scripts/generate-normalized-runtime-config.ts",
    "release:config:test": "vitest run server/normalized/normalized-runtime-config.test.ts server/verify-normalized-runtime-config.test.ts && node --test scripts/generate-normalized-runtime-config.test.mjs && bash deploy/aliyun/release-state.test.sh && bash deploy/aliyun/normalize-runtime-env.test.sh",
    "release:system:test": "npm run release:config:test && node scripts/verify-release-incident-register.mjs && node --test scripts/release-system-policy.test.mjs && node --test scripts/write-release-bundle-manifest.test.mjs && node --test scripts/run-release-chain-drills.test.mjs",
    "release:drills": "tsx scripts/run-release-chain-drills.ts",
    "logs:audit": "node scripts/analyze-runtime-logs.mjs",
    "metrics:verify": "node scripts/verify-runtime-metrics.mjs",
    "evidence:aliyun:build": "node scripts/build-aliyun-evidence-bundle.mjs",
    "evidence:sensitive:verify": "node scripts/verify-sensitive-artifacts.mjs",
    "logs:sls:filter": "node scripts/filter-sls-events.mjs",
    "android:build:validation": "bash scripts/build-android-validation.sh",
    "ios:profile": "node scripts/generate-ios-validation-profile.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:doctor": "cap doctor ios",
    "ios:open": "cap open ios",
    "ios:test:simulator": "bash scripts/test-ios-simulator.sh",
    "ios:build:validation": "bash scripts/build-ios-validation.sh",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.0",
    "fastify": "^5.10.0",
    "google-auth-library": "^10.9.0",
    "lucide-react": "^1.24.0",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "pinyin-pro": "^3.28.1",
    "pngjs": "^5.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "read-excel-file": "^9.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "jsqr": "^1.4.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
