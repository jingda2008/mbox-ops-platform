{
  "schemaVersion": 1,
  "template": true,
  "name": "REPLACE_WITH_PRODUCT_NAME",
  "workingDirectory": ".",
  "profiles": {
    "quick": ["static", "unit"],
    "release": ["static", "unit", "integration", "e2e", "performance", "security"]
  },
  "gates": [
    {
      "id": "static",
      "title": "Static checks",
      "category": "functional",
      "required": true,
      "timeoutSeconds": 300,
      "command": ["npm", "run", "lint"]
    },
    {
      "id": "unit",
      "title": "Unit tests",
      "category": "functional",
      "required": true,
      "timeoutSeconds": 600,
      "command": ["npm", "test"]
    },
    {
      "id": "integration",
      "title": "Integration and invariant tests",
      "category": "functional",
      "required": true,
      "timeoutSeconds": 900,
      "command": ["npm", "run", "test:integration"]
    },
    {
      "id": "e2e",
      "title": "Critical user journeys",
      "category": "functional",
      "required": true,
      "timeoutSeconds": 1200,
      "command": ["npm", "run", "test:e2e"]
    },
    {
      "id": "performance",
      "title": "Representative workload and SLO checks",
      "category": "performance",
      "required": true,
      "timeoutSeconds": 1800,
      "command": ["npm", "run", "test:performance"]
    },
    {
      "id": "security",
      "title": "Security checks",
      "category": "security",
      "required": true,
      "timeoutSeconds": 600,
      "command": ["npm", "run", "test:security"]
    }
  ]
}
