.status-page{padding-top:0}.status-head{margin:0 -28rpx 28rpx;padding:46rpx 28rpx 40rpx;background:linear-gradient(145deg,#191715,#2f2a25);color:#fff}.status-title,.status-copy{display:block}.status-title{margin-top:8rpx;font-family:"Songti SC","STSong",serif;font-size:43rpx;font-weight:600}.status-copy{margin-top:12rpx;color:#c9c1b7;font-size:23rpx}.status-list{display:grid;gap:14rpx}.status-card{padding:26rpx;border:1rpx solid #ddd7cf;border-radius:20rpx;background:#fff}.status-card__head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.status-card__head view text{display:block}.status-card__name{font-size:27rpx;font-weight:700}.status-card__time{margin-top:6rpx;color:#8b837b;font-size:20rpx}.status-chip{flex:0 0 auto;padding:10rpx 16rpx;border-radius:26rpx;background:#eee8df;color:#6d5638;font-size:20rpx}.status-chip--completed,.status-chip--confirmed{background:#e5f1e9;color:#2b6748}.status-chip--escalated,.status-chip--reopened{background:#fff0ec;color:#913e32}.status-detail{display:block;margin-top:18rpx;padding:16rpx;border-radius:12rpx;background:#f6f3ef;color:#5f5952;font-size:22rpx;line-height:1.5}.status-owner{display:block;margin-top:16rpx;color:#817970;font-size:21rpx}.feedback-actions{display:grid;margin-top:20rpx;grid-template-columns:1fr 1fr;gap:12rpx}.feedback-actions button{min-height:88rpx;margin:0;border-radius:44rpx;font-size:23rpx}.feedback-actions button:first-child{background:#e7f2eb;color:#2a6547}.feedback-actions button:last-child{background:#fff0ec;color:#8d3d32}.new-service{margin-top:24rpx}
