# Validation uses production-optimized Node.js behavior without claiming that
# real payment, strict inventory, or hardware integrations are commercially ready.
NODE_ENV=production
MBOX_DEPLOYMENT_TIER=validation
PORT=8787
DATABASE_URL=<new-empty-normalized-validation-database-url>
MBOX_TENANT_ID=<tenant-uuid>
MBOX_STORE_ID=<store-uuid>
MBOX_NORMALIZED_SECRET=<at-least-32-byte-secret>
MBOX_METRICS_TOKEN=<at-least-32-byte-private-metrics-token>
MBOX_DATABASE_POOL_MAX=12
MBOX_WORKER_DATABASE_POOL_MAX=4
MBOX_GUEST_PAYMENT_MODE=simulation
MBOX_INVENTORY_ENFORCEMENT_MODE=audit_only
MBOX_START_WORKERS=false
