.home-page{padding-top:0}.home-hero{position:relative;overflow:hidden;margin:0 -28rpx 28rpx;padding:32rpx 28rpx 54rpx;background:radial-gradient(circle at 90% 5%,rgba(181,125,67,.28),transparent 34%),linear-gradient(145deg,#11100f,#25211e 66%,#141312);color:#fff}.home-hero::after{position:absolute;right:-100rpx;bottom:-180rpx;width:360rpx;height:360rpx;border:1rpx solid rgba(210,171,115,.22);border-radius:50%;content:""}.hero-content{position:relative;z-index:1;margin-top:72rpx;max-width:620rpx}.hero-kicker,.hero-title,.hero-copy{display:block}.hero-kicker{color:#c8a675;font-size:21rpx;letter-spacing:4rpx}.hero-title{margin-top:14rpx;font-family:"Songti SC","STSong",serif;font-size:54rpx;font-weight:600;letter-spacing:2rpx}.hero-copy{margin-top:14rpx;color:#d2cec8;font-size:24rpx;line-height:1.55}.state-card{display:flex;min-height:172rpx;padding:26rpx;align-items:center;border:1rpx solid #ddd6cb;border-radius:22rpx;background:#fff;box-shadow:0 12rpx 34rpx rgba(33,27,22,.06);gap:20rpx}.state-card--waiting{border-color:#d5b474;background:#fffaf0}.state-card__icon{display:flex;width:72rpx;height:72rpx;align-items:center;justify-content:center;border-radius:50%;background:#302a25;color:#d9ba87;font-size:28rpx}.state-card__body{min-width:0;flex:1}.state-card__body text{display:block}.state-card__eyebrow{color:#8b7659;font-size:21rpx}.state-card__title{margin-top:6rpx;font-size:31rpx;font-weight:700}.state-card__copy{margin-top:8rpx;color:#777069;font-size:23rpx;line-height:1.45}.state-card__action{width:112rpx;min-height:88rpx;margin:0;border:1rpx solid #c9b28d;border-radius:44rpx;background:transparent;color:#5d4830;font-size:23rpx;line-height:86rpx}.onsite-summary{display:grid;padding:22rpx 8rpx;border-bottom:1rpx solid #ddd8d0;grid-template-columns:repeat(3,1fr)}.onsite-summary>view{min-width:0;padding:0 14rpx;text-align:center;border-right:1rpx solid #e4dfd8}.onsite-summary>view:last-child{border:0}.summary-value,.summary-label{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.summary-value{font-size:25rpx;font-weight:700}.summary-label{margin-top:7rpx;color:#8a827a;font-size:20rpx}.primary-experience{display:flex;width:100%;min-height:218rpx;margin:26rpx 0 0;padding:32rpx;align-items:center;justify-content:space-between;border:0;border-radius:24rpx;background:linear-gradient(145deg,#292622,#171615);color:#fff;text-align:left;box-shadow:0 18rpx 44rpx rgba(17,15,13,.16)}.primary-experience::after{border:0}.primary-experience text{display:block}.primary-experience__kicker{color:#caaa77;font-size:21rpx;letter-spacing:2rpx}.primary-experience__title{margin-top:8rpx;font-family:"Songti SC","STSong",serif;font-size:40rpx;font-weight:600}.primary-experience__copy{margin-top:12rpx;color:#cbc5bd;font-size:23rpx}.primary-experience__arrow{font-size:44rpx;color:#d4b27d}.reservation-experience{margin-top:0;background:linear-gradient(145deg,#4a2c26,#211817)}.performance-card{display:flex;overflow:hidden;min-height:148rpx;margin-top:22rpx;border:1rpx solid #ddd8d0;border-radius:20rpx;background:#fff}.performance-card image{width:188rpx;height:148rpx;background:#2e2925}.performance-card>view{display:flex;min-width:0;padding:20rpx 24rpx;flex:1;flex-direction:column;justify-content:center}.performance-state,.performance-name,.performance-time{display:block}.performance-state{color:#a16f37;font-size:20rpx;font-weight:700}.performance-name{margin-top:5rpx;overflow:hidden;font-family:"Songti SC","STSong",serif;font-size:30rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.performance-time{margin-top:8rpx;color:#807870;font-size:21rpx}.performance-card--public{margin-top:0}.compact-section{margin-top:34rpx}.action-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.action-grid button{display:flex;min-width:0;min-height:122rpx;margin:0;padding:18rpx 8rpx;align-items:center;flex-direction:column;justify-content:center;border:1rpx solid #dfdad3;border-radius:18rpx;background:#fff;color:#302d29;font-size:21rpx}.action-grid button::after{border:0}.action-icon{display:flex;width:50rpx;height:50rpx;margin-bottom:10rpx;align-items:center;justify-content:center;border-radius:50%;background:#f0e9df;color:#7a5631;font-size:21rpx;font-weight:700}.reservation-state{margin-bottom:0}.discovery-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:14rpx}.discovery-card{display:flex;min-height:230rpx;margin:0;padding:24rpx;flex-direction:column;justify-content:flex-end;border:0;border-radius:22rpx;color:#fff;text-align:left}.discovery-card::after{border:0}.discovery-card text{display:block}.discovery-card text:first-child{color:#d5b27d;font-size:21rpx;font-weight:700;letter-spacing:2rpx}.discovery-card text:nth-child(2){margin-top:10rpx;font-family:"Songti SC","STSong",serif;font-size:28rpx;line-height:1.35}.discovery-card text:last-child{margin-top:18rpx;color:#d2ccc5;font-size:20rpx}.discovery-card--activity{background:linear-gradient(145deg,#3b2822,#191716)}.discovery-card--member{background:linear-gradient(145deg,#344139,#1b211e)}
@media (max-width:350px){.hero-content{margin-top:52rpx}.hero-title{font-size:48rpx}.action-grid{grid-template-columns:1fr 1fr}.discovery-grid{grid-template-columns:1fr}.discovery-card{min-height:190rpx}}
