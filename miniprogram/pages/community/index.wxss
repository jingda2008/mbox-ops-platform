.community-page{padding-top:0}.community-head{position:relative;overflow:hidden;margin:0 -28rpx 28rpx;padding:52rpx 28rpx 48rpx;background:radial-gradient(circle at 85% 0,rgba(184,117,62,.32),transparent 38%),linear-gradient(145deg,#161412,#352620);color:#fff}.community-head::after{position:absolute;right:-80rpx;bottom:-120rpx;width:290rpx;height:290rpx;border:1rpx solid rgba(217,174,116,.22);border-radius:50%;content:""}.community-title,.community-copy{position:relative;z-index:1;display:block}.community-title{margin-top:9rpx;font-family:"Songti SC","STSong",serif;font-size:48rpx;font-weight:600}.community-copy{max-width:600rpx;margin-top:14rpx;color:#cec5ba;font-size:23rpx;line-height:1.6}.activity-list{display:grid;gap:18rpx}.activity-card{position:relative;overflow:hidden;width:100%;height:460rpx;margin:0;padding:0;border:0;border-radius:24rpx;background:#241f1b;color:#fff;text-align:left;box-shadow:0 18rpx 42rpx rgba(35,27,22,.14)}.activity-card::after{border:0}.activity-card>image,.activity-placeholder,.activity-overlay{position:absolute;inset:0;width:100%;height:100%}.activity-placeholder{display:flex;align-items:flex-end;justify-content:flex-end;padding:34rpx;background:linear-gradient(145deg,#54362c,#171514);color:rgba(255,255,255,.12);font-family:serif;font-size:90rpx;line-height:.72}.activity-placeholder text{display:block}.activity-overlay{background:linear-gradient(to bottom,rgba(10,9,8,.16),rgba(10,9,8,.08) 28%,rgba(10,9,8,.9))}.activity-content{position:absolute;z-index:1;inset:0;display:flex;padding:24rpx;flex-direction:column;justify-content:space-between}.activity-top{display:flex;align-items:center;justify-content:space-between}.activity-top text{padding:8rpx 14rpx;border:1rpx solid rgba(255,255,255,.42);border-radius:24rpx;background:rgba(20,18,16,.28);font-size:19rpx;letter-spacing:1rpx}.activity-top text:last-child{border-color:#d7b27b;background:#a36d32;color:#fff}.activity-bottom text{display:block}.activity-title{font-family:"Songti SC","STSong",serif;font-size:37rpx;font-weight:600;line-height:1.25}.activity-summary{display:-webkit-box!important;overflow:hidden;margin-top:8rpx;color:#eee8df;font-size:21rpx;line-height:1.45;-webkit-box-orient:vertical;-webkit-line-clamp:2}.activity-date{margin-top:10rpx;color:#dad4cc;font-size:21rpx}.activity-bottom>view{display:flex;margin-top:16rpx;align-items:center;justify-content:space-between}.activity-fee{font-size:27rpx;font-weight:750}.activity-capacity{color:#d8cfc4;font-size:20rpx}@media(max-width:350px){.activity-card{height:430rpx}.activity-title{font-size:33rpx}.activity-summary{-webkit-line-clamp:1}}
