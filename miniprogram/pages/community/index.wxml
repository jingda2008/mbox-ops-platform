<view class="page community-page">
  <view class="community-hero">
    <view class="community-hero__top"><view><image src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" /><text>M-BOX LIVEHOUSE</text></view><text>× 超嗨部落</text></view>
    <view class="community-hero__stage"><image class="community-hero__logo" src="/assets/brand/superhigh-horizontal.png" mode="widthFix" /><image class="community-hero__mark" src="/assets/brand/superhigh-mark.png" mode="aspectFit" /></view>
    <view class="community-hero__copy"><text>从一场现场开始，认识一群同频的人。</text><text>LIVE · FRIENDS · CITY</text></view>
    <view class="community-hero__palette" aria-hidden="true"><text></text><text></text><text></text><text></text><text></text><text></text></view>
  </view>

  <state-panel wx:if="{{loading}}" type="loading" title="正在读取活动" />
  <block wx:else>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>
    <view wx:if="{{activities.length}}" class="activity-section-head"><view><text>部落正在发生</text><text>由 M-BOX 发布 · 报名与安排以活动详情为准</text></view><text>{{activities.length}} 场</text></view>
    <view wx:if="{{activities.length}}" class="activity-list">
      <button wx:for="{{activities}}" wx:key="publicId" class="activity-card" data-id="{{item.publicId}}" bindtap="openDetail">
        <view class="activity-art">
          <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="activity-placeholder"><text>SUPERHIGH</text><text>一起出发</text></view>
          <view class="activity-art__shade"></view>
          <view class="activity-art__top"><text>{{item.kindText}}</text><text wx:if="{{item.registrationText}}">{{item.registrationText}}</text></view>
          <image class="activity-art__mark" src="/assets/brand/superhigh-mark.png" mode="aspectFit" />
        </view>
        <view class="activity-card__body"><text class="activity-sequence">{{item.sequenceText}}</text><text class="activity-title">{{item.title}}</text><text wx:if="{{item.summary}}" class="activity-summary">{{item.summary}}</text><text class="activity-date">{{item.dateText}} · {{item.assemblyLocation}}</text><view class="activity-footer"><text class="activity-fee">{{item.feeText}}</text><view><text>{{item.availabilityText}}</text><text>查看详情 →</text></view></view></view>
        <view class="activity-card__palette" aria-hidden="true"><text></text><text></text><text></text><text></text><text></text></view>
      </button>
    </view>
    <state-panel wx:else type="empty" title="下一场正在准备" message="通过发布审批的活动会第一时间出现在这里" />
  </block>
</view>
