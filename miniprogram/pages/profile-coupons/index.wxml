<view class="page coupons-page">
  <view class="coupons-hero"><text>M-BOX · 优惠券</text><text>我的优惠券</text><text>查看待生效、可用与历史权益。时间均为北京时间。</text></view>
  <navigator url="/pages/profile-cards/index" class="coupon-nav">我的专属卡 <text>发现同好 ›</text></navigator>
  <state-panel wx:if="{{loading}}" type="loading" title="正在读取优惠券" />
  <block wx:else>
    <view wx:if="{{error}}" class="error-banner">{{error}}<button class="secondary-button" bindtap="load">重新读取优惠券</button></view>
    <block wx:elif="{{coupons.length}}">
      <view class="coupon-list">
        <view wx:for="{{coupons}}" wx:key="id" class="coupon-card">
          <view class="coupon-card__head"><text>{{item.typeText}}</text><text>{{item.stateText}}</text></view>
          <text class="coupon-title">{{item.title}}</text>
          <text class="coupon-copy">{{item.description}}</text>
          <text class="coupon-copy">{{item.quantityText}}</text>
          <text wx:if="{{item.calendarText}}" class="coupon-copy">{{item.calendarText}}</text>
          <text wx:if="{{item.calendarNextText}}" class="coupon-copy">{{item.calendarNextText}}</text>
          <text wx:if="{{item.calendarLimitText}}" class="coupon-copy">{{item.calendarLimitText}}</text>
          <view class="coupon-foot"><text wx:if="{{item.valueText}}">{{item.valueText}}</text><text>{{item.validText}}</text></view>
        </view>
      </view>
      <view wx:if="{{moreError}}" class="error-banner">{{moreError}}</view>
      <button wx:if="{{nextCursor}}" class="secondary-button coupon-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">{{moreError ? '重试加载更多' : '加载更多权益'}}</button>
    </block>
    <state-panel wx:else type="empty" title="暂无优惠券" message="门店发放后会出现在这里；也可在会员卡查看权益。" />
  </block>
</view>
