<view class="tab-bar">
  <block wx:for="{{tabs}}" wx:key="path">
    <button wx:if="{{index === 2 && needsPhone}}" class="tab-item {{selected === index ? 'is-selected' : ''}}" open-type="getPhoneNumber" bindgetphonenumber="authorizeAndOrder" disabled="{{busy}}" aria-label="点单，授权手机号后进入，也可拒绝继续">
      <image src="/assets/tabbar/{{item.icon}}{{selected === index ? '-active' : ''}}.png" /><text>{{item.text}}</text>
    </button>
    <button wx:else class="tab-item {{selected === index ? 'is-selected' : ''}}" data-index="{{index}}" bindtap="switchTab" disabled="{{busy}}" aria-label="{{item.text}}">
      <image src="/assets/tabbar/{{item.icon}}{{selected === index ? '-active' : ''}}.png" /><text>{{item.text}}</text>
    </button>
  </block>
</view>
