/* Match the existing profile service entries and soft-actions brand palette. */
.custody-page { --custody-brand: #315d46; min-height:100vh; padding:30rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); background:#f7f4ef; color:#26372d; overflow-wrap:anywhere; }
.custody-heading { padding:12rpx 4rpx 24rpx; }
.custody-eyebrow { display:block; font-size:21rpx; font-weight:600; letter-spacing:2rpx; color:var(--custody-brand); }
.custody-title { display:block; margin:16rpx 0 10rpx; font-size:42rpx; font-weight:700; line-height:1.35; }
.custody-copy { font-size:23rpx; color:#79776d; line-height:1.65; }
.custody-heading>.custody-copy,.custody-hero>.custody-copy { display:block; }
.custody-note { margin:0 0 24rpx; padding:20rpx 24rpx; border-radius:18rpx; background:#edf2ec; color:#52645b; font-size:23rpx; line-height:1.7; }
.custody-card { display:block; width:100%; margin:0 0 22rpx; padding:28rpx; border:1rpx solid #e5e4db; border-radius:24rpx; background:#fffdfa; box-shadow:0 6rpx 20rpx rgba(49,93,70,.035); }
.custody-list-card { text-align:left; line-height:1.5; font-weight:400; white-space:normal; }
.custody-list-card::after,.custody-button::after,.custody-photo-button::after,.custody-link::after { border:0; }
.custody-card--hover { background:#f1f4ed; }
.custody-row,.custody-section-head { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12rpx; }
.custody-category { font-size:23rpx; color:var(--custody-brand); }
.custody-status { display:inline-block; padding:6rpx 14rpx; border-radius:999rpx; font-size:21rpx; line-height:1.5; background:#edf2ec; color:var(--custody-brand); }
.custody-status.warning { margin:0; border:0; background:#faf0df; color:#8a652e; }
.custody-status.muted { background:#efeee8; color:#79776d; }
.custody-item-name { display:block; margin:20rpx 0; font-size:32rpx; font-weight:650; line-height:1.5; }
.custody-quantity { display:flex; flex-wrap:wrap; align-items:baseline; gap:12rpx; margin:18rpx 0; }
.custody-number { color:var(--custody-brand); font-size:54rpx; font-weight:700; line-height:1.2; }
.custody-unit { color:var(--custody-brand); font-size:25rpx; }
.custody-original { margin-left:auto; color:#79776d; font-size:23rpx; }
.custody-divider { height:1rpx; margin:24rpx 0 20rpx; background:#eeeae2; }
.custody-arrow { font-size:23rpx; color:var(--custody-brand); }
.custody-reference { display:block; margin-top:12rpx; color:#8a8278; font-size:20rpx; }
.custody-section-title { display:block; font-size:29rpx; font-weight:650; line-height:1.5; }
.custody-section-head { margin:30rpx 0 18rpx; }
.custody-empty { display:flex; flex-direction:column; align-items:center; padding:54rpx 24rpx; gap:18rpx; text-align:center; color:#79776d; font-size:25rpx; }
.custody-empty-logo { width:100rpx; height:100rpx; opacity:.75; }
.custody-button,.custody-link { display:flex; width:100%; min-height:44px; align-items:center; justify-content:center; margin:18rpx 0 0; padding:18rpx 24rpx; border-radius:18rpx; font-size:25rpx; line-height:1.5; white-space:normal; background:#edf2ec; color:var(--custody-brand); }
.custody-link { background:transparent; }
.custody-end { display:block; padding:18rpx; text-align:center; font-size:22rpx; color:#8a8278; }
.custody-error { margin-bottom:24rpx; padding:24rpx; border-radius:20rpx; background:#faeeeb; color:#7c3930; font-size:25rpx; line-height:1.65; }
.custody-hero { padding:30rpx; margin-bottom:24rpx; border:1rpx solid #d5dfd4; border-radius:26rpx; background:linear-gradient(135deg,#edf4ee,#f7f8f1); }
.custody-hero .custody-title { font-size:38rpx; }
.custody-hero-expiry { display:block; padding-top:20rpx; border-top:1rpx solid #d5dfd4; color:var(--custody-brand); font-size:24rpx; }
.custody-field { display:flex; justify-content:space-between; align-items:flex-start; gap:24rpx; margin-top:22rpx; font-size:24rpx; line-height:1.65; }
.custody-field>text:first-child { flex:0 0 140rpx; color:#79776d; }
.custody-field>text:last-child { min-width:0; flex:1; text-align:right; white-space:pre-wrap; }
.custody-footnote { display:block; margin-top:14rpx; font-size:20rpx; line-height:1.6; color:#8a8278; }
.custody-deposit-quantity { font-size:25rpx; font-weight:600; }
.custody-photo-button { width:100%; margin:22rpx 0 0; padding:0; overflow:hidden; border-radius:18rpx; background:#edf2ec; line-height:1; }
.custody-photo { display:block; width:100%; }
.custody-photo-placeholder { display:flex; min-height:240rpx; align-items:center; justify-content:center; padding:26rpx; color:var(--custody-brand); font-size:25rpx; line-height:1.7; }
.custody-collection { margin-top:24rpx; padding-top:20rpx; border-top:1rpx solid #eeeae2; font-size:25rpx; }
.custody-collection>.custody-copy { display:block; margin-top:10rpx; }
.custody-timeline { display:flex; gap:18rpx; padding-top:26rpx; font-size:25rpx; }
.custody-dot { flex:0 0 12rpx; height:12rpx; margin-top:12rpx; border-radius:50%; background:var(--custody-brand); }
.custody-timeline-content { flex:1; min-width:0; padding-bottom:24rpx; border-bottom:1rpx solid #eeeae2; }
.custody-timeline:last-child .custody-timeline-content { padding-bottom:0; border:0; }
.custody-record-note { display:block; margin-top:10rpx; color:#52645b; font-size:23rpx; line-height:1.7; white-space:pre-wrap; }
@media(max-width:360px) { .custody-page { padding-left:20rpx; padding-right:20rpx; } .custody-card,.custody-hero { padding:24rpx; } .custody-field { gap:16rpx; } }
