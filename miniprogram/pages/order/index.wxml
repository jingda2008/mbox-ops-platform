<view class="page order-page">
  <scroll-view scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{menuScrollTarget}}" class="order-scroll">
    <view class="order-scroll__content">
  <state-panel wx:if="{{loading}}" type="loading" title="正在确认桌次与菜单" />

  <view wx:elif="{{connectionState === 'needs_scan' || connectionState === 'waiting' || connectionState === 'upgrade_required'}}" class="gate-wrap">
    <view wx:if="{{connectionState === 'waiting'}}" class="browse-intro">
      <view class="waiting-pulse"><view></view></view>
      <view class="browse-intro__copy">
        <text class="gate-kicker">{{table.displayName}}</text><text class="gate-title">请联系服务人员开台</text>
        <text class="gate-copy">{{connectionMessage}}</text>
      </view>
      <button class="secondary-button gate-button" bindtap="retryTable">刷新开台状态</button>
      <text class="gate-note">等待期间可以先查看今晚真实菜单</text>
    </view>
    <view wx:elif="{{connectionState === 'upgrade_required'}}" class="browse-intro">
      <view class="browse-intro__copy">
        <text class="gate-kicker">{{table.displayName}}</text><text class="gate-title">本桌正在完成旧版点单</text>
        <text class="gate-copy">{{connectionMessage}}</text>
      </view>
      <button class="secondary-button gate-button" bindtap="retryTable">结台后重新扫码</button>
      <text class="gate-note">你可以先查看今晚菜单</text>
    </view>
    <view wx:else class="browse-intro browse-intro--compact">
      <view class="browse-intro__copy"><text class="scan-strip-title">今晚菜单</text><text class="scan-strip-copy">可先浏览，扫码后下单</text></view>
      <button class="primary-button gate-button" bindtap="scanTable">到店扫码点单</button>
    </view>
    <view wx:if="{{error}}" class="error-banner gate-error">{{error}}</view>

    <view class="browse-menu">
      <view class="browse-menu__heading"><view><text>今晚菜单</text><text>价格透明 · {{connectionState === 'waiting' ? '开台后即可下单' : '到店后即可下单'}}</text></view><text>{{visibleProducts.length}} 款</text></view>
      <view id="browse-menu-anchor"></view>
<view class="menu-tools menu-tools--browse">
      <view class="category-grid">
        <button wx:for="{{categoryPreview}}" wx:key="code" class="category-chip {{selectedCategory === item.code ? 'is-active' : ''}}" data-code="{{item.code}}" bindtap="selectCategory">{{item.name}}</button>
        <button wx:if="{{categories.length > 8}}" class="category-chip category-more" bindtap="toggleCategories">{{categoriesExpanded ? '收起分类' : '全部分类 ⌄'}}</button>
      </view>
      <scroll-view wx:if="{{categoriesExpanded}}" scroll-y class="category-options"><view class="category-grid">
        <button wx:for="{{categories}}" wx:key="code" class="category-chip {{selectedCategory === item.code ? 'is-active' : ''}}" data-code="{{item.code}}" bindtap="selectCategory">{{item.name}}</button>
      </view></scroll-view>
      <view class="menu-filter-line">
        <button wx:if="{{subcategories.length}}" class="subcategory-trigger {{subcategoriesExpanded ? 'is-active' : ''}}" hover-class="menu-filter-pressed" bindtap="toggleSubcategories"><view class="menu-filter-surface">{{selectedSubcategory === 'all' ? '细分类' : selectedSubcategoryName}} {{subcategoriesExpanded ? '⌃' : '⌄'}}</view></button>
        <text wx:else class="menu-result-count">{{selectedCategory === 'recommendation' ? '按本桌情况精选' : visibleProducts.length + ' 款'}}</text>
        <button class="menu-search-trigger {{searchExpanded || searchText ? 'is-active' : ''}}" hover-class="menu-filter-pressed" aria-label="搜索菜单" bindtap="toggleMenuSearch"><view class="menu-filter-surface">⌕ 搜索{{searchText ? ' ·' : ''}}</view></button>
      </view>
      <scroll-view wx:if="{{subcategoriesExpanded}}" scroll-y class="category-options"><view class="category-grid">
        <button wx:for="{{subcategories}}" wx:key="code" class="category-chip {{selectedSubcategory === item.code ? 'is-active' : ''}}" data-code="{{item.code}}" bindtap="selectSubcategory">{{item.name}}</button>
      </view></scroll-view>
      <view wx:if="{{searchExpanded || searchText}}" class="search-box"><text>⌕</text><input value="{{searchText}}" placeholder="搜索酒水、套餐或口味" bindinput="onSearchInput" /><button class="menu-search-clear" bindtap="clearMenuSearch">清除</button></view>
    </view>
      <view wx:if="{{visibleProducts.length}}" class="product-list product-list--browse">
        <view wx:for="{{visibleProducts}}" wx:key="productId" class="product-row {{item.available ? '' : 'is-unavailable'}}" data-id="{{item.productId}}" role="button" aria-label="查看{{item.name}}大图和详情" hover-class="product-row--pressed" bindtap="openProductDetail">
          <view class="product-media">
            <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
            <view wx:else class="product-media__placeholder"><text>M-BOX</text></view>
            <text wx:if="{{item.discountVisible}}" class="product-media__saving">{{item.savingsText}}</text>
            <text class="product-media__detail-hint">查看详情</text>
          </view>
          <view class="product-main"><text class="product-kind">{{item.productKind === 'bundle' ? (item.bundleSelectionText ? '套餐组合 · 需选款' : '套餐组合 · 固定搭配') : item.categoryName}}</text><text class="product-name">{{item.name}}</text><view wx:if="{{item.tasteLabels.length}}" class="product-tastes"><text wx:for="{{item.tasteLabels}}" wx:for-item="taste" wx:key="*this">{{taste}}</text></view><text class="product-copy">{{(item.productKind === 'bundle' ? (item.includedText || item.description) : item.description) || '查看详情了解内容'}}</text><text wx:if="{{item.discountVisible}}" class="product-saving">单点合计 {{item.separatePriceText}}</text></view>
          <view class="product-action"><view class="product-action__meta"><text class="product-price">{{item.priceText}}</text><text class="product-availability {{item.available ? 'is-available' : 'is-unavailable'}}">{{item.availabilityText}}</text><text class="product-availability-copy">{{item.available ? (connectionState === 'waiting' ? '服务人员开台后可下单' : '到店扫码后可下单') : item.availabilityDetail}}</text></view></view>
        </view>
      </view>
      <state-panel wx:else type="empty" title="没有找到符合条件的商品" message="可清空搜索或切换分类" />
    </view>
  </view>

  <block wx:else>
    <view wx:if="{{error && !checkoutLocked}}" class="error-banner">{{error}}</view>
    <view wx:if="{{success}}" class="success-banner">{{success}}</view>
    <view wx:if="{{cartWritesFrozen}}" class="status-banner status-banner--waiting">本桌点单正在确认，当前选择已保留，稍后即可继续调整。</view>

    <view class="table-strip">
      <view class="table-strip__table"><text class="table-strip__label">本桌</text><text class="table-strip__value">{{table.displayName}}</text></view>
      <view class="table-strip__content">
        <view wx:if="{{performance}}" class="show-brief"><text>{{performance.state}}</text><text>{{performance.name}} · {{performance.time}}</text></view>
        <button wx:elif="{{performanceError}}" class="show-brief show-brief--retry" bindtap="retryPerformance"><text>演出待更新</text><text>点此重试</text></button>
        <view wx:else class="show-brief show-brief--quiet"><text>今晚现场</text><text>演出安排更新后显示</text></view>
        <button class="table-strip__service" bindtap="openStatus"><text class="table-strip__service-value">{{serviceSummary.label}}</text><text class="table-strip__service-link">查看进展 ›</text></button>
      </view>
    </view>
    <view class="quick-service" aria-label="本桌快捷服务">
      <button data-code="call" disabled="{{quickServiceBusy}}" bindtap="requestQuickService"><view class="quick-service__surface"><text class="quick-service__dot"></text><text>{{quickServiceBusy === 'call' ? '正在通知' : '呼叫服务员'}}</text></view></button>
      <button data-code="celebration" aria-label="生日或个性化需求" disabled="{{quickServiceBusy}}" bindtap="requestQuickService"><view class="quick-service__surface"><text class="quick-service__dot"></text><text>{{quickServiceBusy === 'celebration' ? '正在安排' : '生日/需求'}}</text></view></button>
      <button data-code="complaint" disabled="{{quickServiceBusy}}" bindtap="requestQuickService"><view class="quick-service__surface"><text class="quick-service__dot"></text><text>{{quickServiceBusy === 'complaint' ? '正在通知' : '投诉/不满意'}}</text></view></button>
    </view>

    <view wx:if="{{membershipInviteVisible}}" class="membership-invite">
      <view class="membership-invite__copy"><text>加入 M-BOX 会员</text><text>{{membershipTerms.summary}}</text></view>
      <view class="membership-invite__actions"><button bindtap="enrollFromMenu" loading="{{membershipBusy}}">加入会员</button><button bindtap="dismissMembershipInvite">稍后再说</button></view>
      <button class="membership-invite__recovery" bindtap="openMembershipRecovery">我已是会员</button>
      <button class="membership-invite__privacy" bindtap="showMembershipTerms">查看会员权益说明</button>
    </view>


    <view id="connected-menu-anchor"></view>
<view class="menu-tools">
      <view class="category-grid">
        <button wx:for="{{categoryPreview}}" wx:key="code" class="category-chip {{selectedCategory === item.code ? 'is-active' : ''}}" data-code="{{item.code}}" bindtap="selectCategory">{{item.name}}</button>
        <button wx:if="{{categories.length > 8}}" class="category-chip category-more" bindtap="toggleCategories">{{categoriesExpanded ? '收起分类' : '全部分类 ⌄'}}</button>
      </view>
      <scroll-view wx:if="{{categoriesExpanded}}" scroll-y class="category-options"><view class="category-grid">
        <button wx:for="{{categories}}" wx:key="code" class="category-chip {{selectedCategory === item.code ? 'is-active' : ''}}" data-code="{{item.code}}" bindtap="selectCategory">{{item.name}}</button>
      </view></scroll-view>
      <view class="menu-filter-line">
        <button wx:if="{{subcategories.length}}" class="subcategory-trigger {{subcategoriesExpanded ? 'is-active' : ''}}" hover-class="menu-filter-pressed" bindtap="toggleSubcategories"><view class="menu-filter-surface">{{selectedSubcategory === 'all' ? '细分类' : selectedSubcategoryName}} {{subcategoriesExpanded ? '⌃' : '⌄'}}</view></button>
        <text wx:else class="menu-result-count">{{selectedCategory === 'recommendation' ? '按本桌情况精选' : visibleProducts.length + ' 款'}}</text>
        <button class="menu-search-trigger {{searchExpanded || searchText ? 'is-active' : ''}}" hover-class="menu-filter-pressed" aria-label="搜索菜单" bindtap="toggleMenuSearch"><view class="menu-filter-surface">⌕ 搜索{{searchText ? ' ·' : ''}}</view></button>
      </view>
      <scroll-view wx:if="{{subcategoriesExpanded}}" scroll-y class="category-options"><view class="category-grid">
        <button wx:for="{{subcategories}}" wx:key="code" class="category-chip {{selectedSubcategory === item.code ? 'is-active' : ''}}" data-code="{{item.code}}" bindtap="selectSubcategory">{{item.name}}</button>
      </view></scroll-view>
      <view wx:if="{{searchExpanded || searchText}}" class="search-box"><text>⌕</text><input value="{{searchText}}" placeholder="搜索酒水、套餐或口味" bindinput="onSearchInput" /><button class="menu-search-clear" bindtap="clearMenuSearch">清除</button></view>
    </view>

    <view class="menu-filter-line" aria-label="选购帮助">
      <button class="menu-search-trigger" data-code="recommendation" bindtap="selectCategory"><view class="menu-filter-surface">帮我选</view></button>
      <button class="menu-search-trigger" bindtap="openAllBundles"><view class="menu-filter-surface">查看全部套餐</view></button>
    </view>
    <view wx:if="{{selectedCategory === 'recommendation'}}" class="recommend-entry {{recommendationEmpty && !recommendations.length ? 'recommend-entry--compact' : ''}}">
      <view class="recommend-entry__head"><view><text>不知道怎么选？</text><text>这里是精选推荐，不是全部套餐</text></view></view>
      <scroll-view wx:if="{{recommendations.length}}" scroll-x enhanced show-scrollbar="{{false}}" class="recommend-scroll"><view class="recommend-row">
        <view wx:for="{{recommendations}}" wx:key="productId" class="recommend-card {{index === 0 ? 'recommend-card--priority' : ''}}">
          <image wx:if="{{item.imageUrl}}" class="recommend-card__image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="recommend-body"><view class="recommend-labels"><text class="recommend-tier">{{item.tierText}}</text></view><text class="recommend-name">{{item.name}}</text><text class="recommend-reason">{{item.reason}}</text><view wx:if="{{item.savingsText || item.separatePriceText}}" class="recommend-value"><text wx:if="{{item.separatePriceText}}">单点约 {{item.separatePriceText}}</text><text wx:if="{{item.savingsText}}" class="saving">{{item.savingsText}}</text></view><view class="recommend-foot"><text class="recommend-price">{{item.priceText}}</text><view class="recommend-actions"><button class="recommend-reject" data-id="{{item.productId}}" bindtap="rejectRecommendation" loading="{{item.rejecting}}" disabled="{{item.rejecting}}">不合适</button><button class="recommend-select" data-id="{{item.productId}}" data-source="recommendation" bindtap="addProduct">{{item.selectionActionText}}</button></view></view></view>
        </view>
      </view></scroll-view>
      <view wx:elif="{{recommendationBusy}}" class="recommend-loading"><text>正在为这桌挑选</text><text>稍等片刻</text></view>
      <view wx:elif="{{recommendationEmpty}}" class="recommend-empty"><text>暂时没有合适的推荐组合</text><text>可以直接浏览全部套餐，不必等待推荐</text></view>
      <view class="recommend-entry__actions" aria-label="智能推荐">
        <button bindtap="onRecommend" loading="{{recommendationBusy}}"><view class="recommend-entry__action-icon recommend-entry__action-icon--guided" aria-hidden="true"><view class="pick-glass"></view><view class="pick-spark">✧</view></view><view><text>帮我选</text><text>发现合你口味的</text></view></button>
        <button class="shake-recommendation" bindtap="onShakeRecommendation" loading="{{recommendationBusy}}" disabled="{{shakeArmed}}"><view class="recommend-entry__action-icon recommend-entry__action-icon--shake" aria-hidden="true"><view class="dice dice--one"><view></view></view><view class="dice dice--two"><view></view><view></view></view><view class="dice dice--three"><view></view><view></view><view></view></view></view><view><text>{{shakeArmed ? '请摇动手机' : '摇一摇'}}</text><text>摇出今夜灵感</text></view></button>
      </view>
    </view>
    <view wx:if="{{selectedCategory !== 'recommendation'}}" class="section product-section">
      <view class="section-title"><text>菜单</text><text wx:if="{{benefitCount}}" class="section-link" bindtap="openBenefits">{{benefitCount}}项权益可用</text></view>
      <view wx:if="{{visibleProducts.length}}" class="product-list">
        <view wx:for="{{visibleProducts}}" wx:key="productId" class="product-row {{item.available ? '' : 'is-unavailable'}}" data-id="{{item.productId}}" role="button" aria-label="查看{{item.name}}大图和详情" hover-class="product-row--pressed" bindtap="openProductDetail">
          <view class="product-media">
            <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
            <view wx:else class="product-media__placeholder"><text>M-BOX</text></view>
            <text wx:if="{{item.discountVisible}}" class="product-media__saving">{{item.savingsText}}</text>
            <text class="product-media__detail-hint">查看详情</text>
          </view>
          <view class="product-main"><text class="product-kind">{{item.productKind === 'bundle' ? (item.bundleSelectionText ? '套餐组合 · 需选款' : '套餐组合 · 固定搭配') : item.categoryName}}</text><text class="product-name">{{item.name}}</text><view wx:if="{{item.tasteLabels.length}}" class="product-tastes"><text wx:for="{{item.tasteLabels}}" wx:for-item="taste" wx:key="*this">{{taste}}</text></view><text class="product-copy">{{(item.productKind === 'bundle' ? (item.includedText || item.description) : item.description) || '查看详情了解内容'}}</text><text wx:if="{{item.discountVisible}}" class="product-saving">单点合计 {{item.separatePriceText}}</text></view>
          <view class="product-action"><view class="product-action__meta"><text class="product-price">{{item.priceText}}</text><text class="product-availability {{item.available ? 'is-available' : 'is-unavailable'}}">{{item.availabilityText}}</text></view><button wx:if="{{item.available}}" aria-label="{{item.selectionActionText}}：{{item.name}}" data-id="{{item.productId}}" catchtap="addProduct">＋</button><button wx:else class="product-unavailable" disabled="{{true}}">{{item.availabilityDetail}}</button></view>
        </view>
      </view>
      <state-panel wx:else type="empty" title="没有找到符合条件的商品" message="可清空搜索或切换分类" />
    </view>
    <view wx:if="{{!cart.length}}" class="shared-cart-empty">
      <text>本桌共享购物车</text><text>还没有商品；同桌每位顾客加入的商品都会在这里同步显示。</text>
    </view>
  </block>
    </view>
  </scroll-view>

  <view wx:if="{{recommendationQuestionVisible && recommendationQuestion}}" class="recommend-question sheet-mask">
    <scroll-view scroll-y="true" class="recommend-question__sheet">
      <button class="recommend-question__close compact-text-action" aria-label="关闭帮我选" bindtap="closeRecommendationQuestions">取消</button>
      <view class="recommend-question__head"><text>帮我选</text><text>{{recommendationQuestion.title}}</text></view>
      <view class="recommend-question__progress"><text wx:for="{{recommendationConfiguration.questions}}" wx:key="code" class="{{index <= recommendationQuestionIndex ? 'is-active' : ''}}"></text></view>
      <view class="recommend-question__options"><button wx:for="{{recommendationQuestion.options}}" wx:key="value" data-value="{{item.value}}" bindtap="selectRecommendationAnswer">{{item.label}}</button></view>
    </scroll-view>
  </view>

  <view wx:if="{{detailProduct}}" class="product-detail-mask sheet-mask" bindtap="closeProductDetail">
    <view class="product-detail-sheet {{detailProduct.productKind === 'bundle' ? 'is-bundle' : ''}}" catchtap="keepProductDetailOpen">
      <button class="product-detail-close compact-icon-action" aria-label="关闭商品详情" catchtap="closeProductDetail">×</button>
      <scroll-view scroll-y class="product-detail-scroll">
        <view wx:if="{{!detailProduct.selectionSource || !detailProduct.bundleChoiceGroups.length || detailInformationExpanded}}" class="product-detail-hero" catchtap="previewProductImage">
          <image wx:if="{{detailProduct.imageUrl}}" src="{{detailProduct.imageUrl}}" mode="aspectFill" />
          <view wx:else class="product-detail-placeholder"><text>M-BOX</text></view>
          <text wx:if="{{detailProduct.imageUrl}}" class="product-detail-preview-hint">点击查看全屏大图</text>
        </view>
        <view class="product-detail-content">
          <text class="product-detail-kind">{{detailProduct.productKind === 'bundle' ? '套餐组合' : detailProduct.categoryName}}</text>
          <text class="product-detail-name">{{detailProduct.name}}</text><view wx:if="{{detailProduct.tasteLabels.length}}" class="product-tastes product-tastes--detail"><text wx:for="{{detailProduct.tasteLabels}}" wx:for-item="taste" wx:key="*this">{{taste}}</text></view>
          <text wx:if="{{detailProduct.specification}}" class="product-detail-specification">规格：{{detailProduct.specification}}</text>
          <button wx:if="{{detailProduct.selectionSource && detailProduct.bundleChoiceGroups.length}}" class="detail-info-toggle" bindtap="toggleDetailInformation">{{detailInformationExpanded ? '收起介绍，选择酒水' : '查看套餐图片与固定组成'}}</button>
          <text wx:if="{{!detailProduct.selectionSource || !detailProduct.bundleChoiceGroups.length || detailInformationExpanded}}" class="product-detail-description">{{detailProduct.description || '详情以当晚正式菜单为准'}}</text>
          <view wx:if="{{detailProduct.productKind === 'bundle' && detailProduct.bundleComponents.length && (!detailProduct.selectionSource || !detailProduct.bundleChoiceGroups.length || detailInformationExpanded)}}" class="product-detail-components">
            <text class="product-detail-section-title">组合内容</text>
            <view wx:for="{{detailProduct.bundleComponents}}" wx:key="productId" class="product-detail-component"><text>{{item.name}}</text><text>× {{item.quantity}}</text></view>
          </view>
          <view wx:for="{{detailProduct.bundleChoiceGroups}}" wx:key="id" class="product-detail-choice-group">
            <view class="product-detail-choice-head"><text>{{item.name}}</text><text>请选择 {{item.selectionCount}} 款</text></view>
            <view class="product-detail-choice-options"><button wx:for="{{item.options}}" wx:for-item="option" wx:key="productId"
                class="product-detail-choice {{option.selected ? 'is-selected' : ''}}"
                data-group="{{item.id}}" data-product="{{option.productId}}"
                disabled="{{option.available === false}}" catchtap="selectBundleChoice">
                <view><text>{{option.name}}</text><text>{{option.available === false ? (option.unavailableReason || '当前不可选') : (option.quantity > 1 ? '每份 × ' + option.quantity : '包含 1 份')}}</text></view>
                <text>{{option.selected ? '已选' : '选择'}}</text>
              </button></view>
          </view>
          <view wx:if="{{detailProduct.discountVisible}}" class="product-detail-saving">
            <view><text>单点合计</text><text>{{detailProduct.separatePriceText}}</text></view>
            <text>{{detailProduct.savingsText}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="product-detail-footer">
        <view><text>当前售价</text><text>{{detailProduct.priceText}}</text></view>
        <button wx:if="{{connectionState === 'active' && detailProduct.available && detailProduct.productKind === 'bundle'}}"
          disabled="{{!detailSelectionsComplete}}" catchtap="confirmBundleProduct">{{detailProduct.bundleChoiceGroups.length ? (detailSelectionsComplete ? (detailEditUnitIndex >= 0 ? '保存第' + (detailEditUnitIndex + 1) + '份' : '确认选择并加入') : '请先完成选择') : '确认套餐并加入'}}</button>
        <button wx:elif="{{connectionState === 'active' && detailProduct.available}}" data-id="{{detailProduct.productId}}" catchtap="addProduct">加入购物车</button>
        <button wx:elif="{{connectionState === 'active'}}" class="product-detail-unavailable" disabled="{{true}}">{{detailProduct.availabilityDetail}}</button>
        <text wx:else class="product-detail-browse-note">{{connectionState === 'waiting' ? '服务人员开台后可下单' : '到店扫码后可下单'}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{connectionState === 'active' && cart.length}}" class="cart-dock">
    <view class="cart-summary"><button class="cart-overview" aria-label="查看本桌购物车，已选{{cartCount}}件商品" hover-class="cart-overview--pressed" bindtap="openCartDetails"><view class="cart-overview__mark"><view class="cart-overview__mark-icon"></view><text class="cart-overview__badge">{{cartCount}}</text></view><view class="cart-overview__copy"><text>购物车 · {{cartCount}} 件</text><text>{{cartWritesFrozen ? '当前选择已保留' : checkoutLocked ? '上次提交待确认，可继续确认或查看桌账' : cartSyncing ? '正在同步同桌选择' : '点击查看商品与金额'}}</text></view></button><button class="checkout-button" bindtap="openCheckout" loading="{{busy}}" disabled="{{cartSyncing || cartWritesFrozen}}">{{checkoutLocked ? '继续确认' : '提交订单'}}</button></view>
  </view>

  <view wx:if="{{checkoutConfirmVisible}}" class="checkout-confirm sheet-mask">
    <view class="checkout-confirm__sheet"><view class="sheet-handle"></view><view class="checkout-confirm__head"><view><text class="checkout-confirm__eyebrow">本桌订单</text><text class="checkout-confirm__title">核对商品与金额</text></view><view class="checkout-confirm__close-slot"><button class="checkout-confirm__close compact-text-action" aria-label="关闭订单明细" hover-class="checkout-confirm__close--pressed" bindtap="closeCheckoutConfirm" disabled="{{busy}}">关闭</button></view></view>
      <scroll-view scroll-y class="checkout-confirm__lines"><view wx:if="{{checkoutUpgrade}}" class="checkout-upgrade"><text>将{{checkoutUpgrade.sourceLabel}}升级</text><text class="checkout-upgrade__title">加 {{checkoutUpgrade.addedText}}，换为{{checkoutUpgrade.targetName}}</text><text>{{checkoutUpgrade.fitReason}}</text><text>本次合计 {{checkoutUpgrade.totalText}} · 保留原单也可直接支付</text><picker wx:if="{{checkoutUpgradeChoicesOpen}}" mode="selector" range="{{checkoutUpgrade.variantLabels}}" value="{{checkoutUpgradeVariantIndex}}" bindchange="chooseCheckoutUpgradeVariant" disabled="{{busy}}"><view class="checkout-upgrade__choice">{{checkoutUpgradeVariantLabel}} ›</view></picker><view class="checkout-upgrade__actions"><button class="checkout-upgrade__decline" bindtap="declineCheckoutUpgrade" disabled="{{busy}}">保留原单</button><button class="checkout-upgrade__accept" bindtap="acceptCheckoutUpgrade" disabled="{{busy || cartSyncing}}">{{checkoutUpgrade.variants.length ? (checkoutUpgradeChoicesOpen ? '确认更换' : '选择具体菜品') : '更换套餐'}}</button></view></view><text wx:if="{{checkoutUpgradeMessage}}" class="checkout-upgrade__message">{{checkoutUpgradeMessage}}</text><view wx:for="{{cart}}" wx:key="productId" class="checkout-confirm__line"><view class="checkout-confirm__copy"><text>{{item.name}}</text><text>{{item.priceText}} × {{item.quantity}} · 小计 {{item.subtotalText}}</text><view wx:if="{{item.selectionUnits.length}}" class="cart-line__selection"><button wx:for="{{item.selectionUnits}}" wx:for-item="unit" wx:key="unitIndex" data-id="{{item.productId}}" data-index="{{unit.unitIndex}}" bindtap="editBundleUnitSelection" disabled="{{busy || cartSyncing || cartWritesFrozen}}">第{{unit.unitIndex + 1}}份：{{unit.label}} · 修改</button></view><view class="line-note" wx:for="{{item.noteUnits}}" wx:for-item="noteUnit" wx:key="portionId"><text>{{noteUnit.label}}</text><input value="{{noteUnit.note}}" data-portion="{{noteUnit.portionId}}" bindinput="onLineNoteInput" maxlength="300" placeholder="如少冰、不辣、酱料分开" aria-label="{{item.name}} {{noteUnit.label}}" disabled="{{busy || checkoutLocked || cartWritesFrozen}}" /></view><text wx:if="{{!item.available}}" class="cart-line__unavailable">{{item.unavailableReason}}</text></view><view class="checkout-confirm__actions"><button class="checkout-confirm__remove" aria-label="移除{{item.name}}" data-id="{{item.productId}}" bindtap="removeCartLine" disabled="{{busy || cartSyncing || cartWritesFrozen}}">移除</button><button data-id="{{item.productId}}" data-delta="-1" bindtap="changeQuantity" disabled="{{busy || cartSyncing || cartWritesFrozen}}">−</button><text>{{item.quantity}}</text><button data-id="{{item.productId}}" data-delta="1" bindtap="changeQuantity" disabled="{{busy || cartSyncing || cartWritesFrozen || !item.available}}">＋</button></view></view><view class="checkout-coupons"><button class="secondary-button" bindtap="openCheckoutCoupons" disabled="{{busy || couponLoading}}">{{couponPickerOpen ? '刷新我的优惠券' : '选择优惠券（可不选）'}}</button>
<block wx:if="{{couponPickerOpen}}"><text class="coupon-quote-copy">按具体份次选择，金额以门店报价为准。</text><view wx:for="{{couponPortions}}" wx:key="portionId" class="coupon-portion"><text>{{item.label}}</text><picker mode="selector" range="{{item.optionLabels}}" value="{{item.selectedIndex}}" data-portion="{{item.portionId}}" bindchange="chooseCheckoutCoupon" disabled="{{busy || couponLoading}}"><view>{{item.selectedLabel}} ›</view></picker></view><button wx:if="{{couponNextCursor}}" class="secondary-button" bindtap="loadMoreCheckoutCoupons" disabled="{{busy || couponLoading}}">加载更多优惠券</button><button class="primary-button" bindtap="quoteCheckoutCoupons" loading="{{couponLoading}}" disabled="{{busy || couponLoading || !couponSelections.length}}">核对用券后金额</button></block>
<text wx:if="{{couponError}}" class="coupon-quote-error">{{couponError}}</text><text wx:if="{{couponQuote}}" class="coupon-quote-copy">用券后应付 {{couponQuoteTotal}}，提交时再次校验。</text><button wx:if="{{couponPickerOpen || couponNeedsReview || couponQuote}}" class="secondary-button" bindtap="skipCheckoutCoupons" disabled="{{busy}}">不用券，恢复原价 {{cartTotal}}</button></view></scroll-view>
      <view class="checkout-note"><text>整单备注</text><input value="{{checkoutNote}}" bindinput="onCheckoutNoteInput" maxlength="500" placeholder="可不填，如一起上齐" aria-label="整单备注" disabled="{{busy || checkoutLocked}}" /></view><view class="checkout-confirm__total"><view><text class="checkout-confirm__total-label">本次应付</text><text class="checkout-confirm__total-note">确认后调起微信支付</text></view><text class="checkout-confirm__total-price">{{couponQuote ? couponQuoteTotal : cartTotal}}</text></view>
      <view class="checkout-confirm__footer"><button class="checkout-confirm__footer-button secondary-button" bindtap="closeCheckoutConfirm" disabled="{{busy}}">继续加购</button><button class="checkout-confirm__footer-button primary-button" bindtap="confirmCheckout" loading="{{busy}}" disabled="{{busy || cartSyncing || cartWritesFrozen || checkoutLocked}}">{{checkoutLocked ? '订单确认中' : '确认支付'}}</button></view>
    </view>
  </view>

  <view wx:if="{{paymentResult}}" class="payment-result sheet-mask">
    <view class="payment-result__sheet"><button class="payment-result__close compact-text-action" aria-label="关闭付款提示" hover-class="payment-result__close--pressed" bindtap="closePaymentResult">关闭</button><view class="payment-result__mark payment-result__mark--{{paymentResult.kind}}">{{paymentResult.mark}}</view><text class="payment-result__title">{{paymentResult.title}}</text><text class="payment-result__copy">{{paymentResult.copy}}</text><view class="payment-result__actions"><button class="secondary-button" bindtap="openPaymentResultAccount">查看本桌账单</button><button wx:if="{{paymentResult.canRetry}}" class="primary-button" bindtap="retryPaymentFromResult" loading="{{busy}}">继续付款</button><button wx:else class="primary-button" bindtap="closePaymentResult">完成</button></view></view>
  </view>

</view>
