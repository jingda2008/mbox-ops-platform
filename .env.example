# Generated contract: normalized-runtime-config/v1
# Real values belong in the protected server environment file. Never commit them.
MBOX_RUNTIME_CONFIG_VERSION=normalized-runtime-config/v1
NODE_ENV=production
PORT=8787
DATABASE_URL=<postgresql-url>
MBOX_TENANT_ID=<tenant-uuid>
MBOX_STORE_ID=<store-uuid>
MBOX_NORMALIZED_SECRET=<minimum-32-byte-secret>
MBOX_CONTACT_ACTIVE_KEY_ID=contact-key-2026-01
MBOX_CONTACT_ACTIVE_KEY_BASE64=<base64-encoded-32-byte-key>
MBOX_CONTACT_LOOKUP_KEY_BASE64=<base64-encoded-stable-32-byte-lookup-key>
MBOX_CONTACT_LEGACY_PHONE_LOOKUP_KEY_BASE64=<base64-encoded-stable-legacy-phone-lookup-key>
MBOX_CONTACT_PREVIOUS_KEYS=normalized-contact-v1=<base64-key>;normalized-phone-v1=<base64-key>
MBOX_METRICS_TOKEN=<minimum-32-byte-token>
MBOX_DATABASE_POOL_MAX=12
MBOX_WORKER_DATABASE_POOL_MAX=4
MBOX_TRUST_PROXY_HOPS=1
MBOX_GUEST_ORDER_DUPLICATE_WINDOW_SECONDS=45
MBOX_GUEST_ORDER_CUSTOMER_LIMIT_PER_MINUTE=5
MBOX_GUEST_ORDER_TABLE_LIMIT_PER_MINUTE=20

# Optional Alipay mini-program phone decrypt. Both required together.
# The AES key stays on the server only. Never commit the real value.
# MBOX_ALIPAY_APP_ID=2021006196615276
# MBOX_ALIPAY_AES_KEY=<16-byte-utf8-or-canonical-base64>

# validation | production
MBOX_DEPLOYMENT_TIER=validation

# disabled | test | uat | production
MBOX_PAYMENT_MODE=disabled
MBOX_AI_MODE=disabled
MBOX_PRINT_MODE=disabled
MBOX_HEADSET_MODE=disabled

# Validation can simulate checkout and audit inventory. Production rejects both.
MBOX_GUEST_PAYMENT_MODE=simulation
MBOX_INVENTORY_ENFORCEMENT_MODE=audit_only

# Disabled integrations must not retain partial provider fields.
# When payment is enabled, provide the entire POSTAR_* group.
# MBOX_PAYMENT_PROVIDER=postar
# POSTAR_AGENCY_ID=
# POSTAR_MERCHANT_ID=
# POSTAR_PUBLIC_KEY=
# POSTAR_CALLBACK_URL=https://pay.example.com/api/payments/providers/postar/callback
# POSTAR_HTTP_TIMEOUT_MS=10000
# POSTAR_WECHAT_APP_ID=
# POSTAR_WECHAT_TRADE_TYPE=5

# When AI is enabled, provide the entire MBOX_AI_* group.
# MBOX_AI_PROVIDER=qwen
# MBOX_AI_ENDPOINT=https://example.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
# MBOX_AI_MODEL=qwen-plus
# MBOX_AI_API_KEY=

# MBOX_PRINT_ENDPOINT=https://print-gateway.example.com/events
# MBOX_HEADSET_ENDPOINT=https://headset-gateway.example.com/events

MBOX_START_WORKERS=false
# MBOX_WORKER_ID=mbox-validation-1
# MBOX_WORKER_INTERVAL_MS=2000
# MBOX_WORKER_ADAPTER_MODULE=/app/dist-normalized/server/worker-adapter.js
