.launch-popup-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:1000; display:flex; align-items:center; justify-content:center; padding:24rpx; box-sizing:border-box; background:rgba(0,0,0,.66); }
.launch-popup-shell { display:flex; flex-direction:column; align-items:center; width:620rpx; max-width:480px; max-height:100%; min-width:0; }
.launch-popup-swiper { flex:0 0 auto; width:100%; height:60vh; overflow:hidden; border-radius:26rpx; background:#faf8f2; }
.launch-popup-poster { width:100%; height:100%; overflow:hidden; background:#faf8f2; }
.launch-popup-hero { position:relative; width:100%; height:45vh; overflow:hidden; background:#152119; }
.launch-popup-image { display:block; width:100%; height:100%; }
.launch-popup-placeholder { display:flex; align-items:center; justify-content:center; width:100%; height:100%; color:#cad0c7; font-size:26rpx; }
.launch-popup-heading { position:absolute; top:0; right:0; left:0; padding:28rpx 26rpx 42rpx; background:linear-gradient(180deg,rgba(0,0,0,.62),transparent); pointer-events:none; }
.launch-popup-title { display:block; color:#fffdf5; font-size:38rpx; font-weight:650; line-height:1.35; text-shadow:0 2rpx 10rpx rgba(0,0,0,.3); overflow:hidden; max-height:2.7em; }
.launch-popup-caption { height:15vh; box-sizing:border-box; padding:22rpx 26rpx; }
.launch-popup-product-line { display:flex; align-items:flex-start; justify-content:space-between; gap:18rpx; }
.launch-popup-product-name { display:block; flex:1 1 auto; min-width:0; color:#29382d; font-size:29rpx; font-weight:600; line-height:1.45; word-break:break-all; }
.launch-popup-product-price { display:block; flex:0 0 auto; color:#294e3a; font-size:34rpx; font-weight:700; line-height:1.3; }
.launch-popup-copy { display:block; margin-top:12rpx; color:#7b8177; font-size:23rpx; line-height:1.6; white-space:pre-wrap; word-break:break-all; }
.launch-popup-status { display:block; margin-top:8rpx; color:#83786a; font-size:22rpx; }
.launch-popup-pagination { display:flex; flex:0 0 auto; align-items:center; justify-content:center; gap:10rpx; height:30rpx; margin-top:10rpx; }
.launch-popup-dot { width:8rpx; height:8rpx; border-radius:8rpx; background:rgba(255,255,255,.35); }
.launch-popup-dot.is-current { width:24rpx; background:#fff; }
.launch-popup-shell .launch-popup-close { position:relative; display:block; flex:0 0 auto; box-sizing:border-box; width:44px; min-width:44px; height:44px; min-height:44px; margin:14rpx 0 0; padding:0; border:0; border-radius:22px; background:transparent; }
.launch-popup-close::after { border:0; }
.launch-popup-close-ring { position:absolute; top:0; left:0; box-sizing:border-box; width:44px; height:44px; border:1px solid rgba(255,255,255,.85); border-radius:22px; pointer-events:none; }
.launch-popup-close-line { position:absolute; top:20px; left:10px; width:22px; height:1px; background:#fff; pointer-events:none; }
.launch-popup-close-line--first { transform:rotate(45deg); }
.launch-popup-close-line--second { transform:rotate(-45deg); }
.launch-popup-close--pressed { background:rgba(255,255,255,.16); }
.launch-popup-empty { box-sizing:border-box; width:100%; padding:36rpx; border-radius:26rpx; background:#faf8f2; }
.launch-popup-empty-title { display:block; color:#29382d; font-size:36rpx; font-weight:600; line-height:1.4; }
.launch-popup-empty-copy { max-height:35vh; height:25vh; }
.launch-popup-menu { min-height:44px; margin-top:24rpx; border:0; border-radius:16rpx; background:#294e3a; color:#fff; font-size:28rpx; }
.launch-popup-menu::after { border:0; }
