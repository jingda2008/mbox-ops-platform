.member-center-page { padding-top: 0; }
.member-center-head { margin: 0 -28rpx 26rpx; padding: 38rpx 28rpx 42rpx; background: radial-gradient(circle at 88% 8%, rgba(198, 163, 105, .26), transparent 34%), linear-gradient(145deg, #0d1712, #234031 66%, #101512); color: #fff; }
.member-center-head text { display: block; }
.member-center-title { margin-top: 22rpx; font-family: "Songti SC", "STSong", serif; font-size: 46rpx; font-weight: 600; }
.member-center-head text:last-child { margin-top: 12rpx; color: #d2cec8; font-size: 22rpx; line-height: 1.55; }
.member-card { position: relative; min-height: 220rpx; padding: 21rpx 24rpx 17rpx; box-sizing: border-box; overflow: hidden; isolation: isolate; border-radius: 22rpx; background: radial-gradient(circle at 40% 105%, rgba(200, 217, 170, .23), transparent 39%), linear-gradient(135deg, #244b37 0%, #153729 56%, #10291f 100%); color: #fff; box-shadow: 0 18rpx 42rpx rgba(22, 43, 31, .18); }
.member-card--silver { border: 1rpx solid rgba(220, 225, 220, .76); }
.member-card--gold { border: 2rpx solid #d7ae62; box-shadow: 0 18rpx 42rpx rgba(117, 82, 28, .22); }
.member-card__glow, .member-card__corner { position: absolute; pointer-events: none; z-index: -1; }
.member-card__glow { width: 270rpx; height: 270rpx; right: 45rpx; top: -210rpx; border: 1rpx solid rgba(235, 227, 184, .12); border-radius: 50%; }
.member-card__corner { width: 300rpx; height: 300rpx; right: -184rpx; bottom: -210rpx; transform: rotate(45deg); background: linear-gradient(145deg, rgba(255,255,255,.08), rgba(5, 25, 18, .25)); }
.member-card--silver .member-card__corner { right: -136rpx; bottom: -208rpx; background: linear-gradient(145deg, #f5f5f1 0%, #c8cbc7 24%, #888d8b 55%, #ecece8 77%, #9b9f9d 100%); box-shadow: 0 -2rpx 8rpx rgba(255,255,255,.75); }
.member-card--gold .member-card__corner { right: -136rpx; bottom: -208rpx; background: linear-gradient(145deg, #ffedb2 0%, #d5a346 26%, #f7df94 56%, #b7802b 82%, #f7d77d 100%); box-shadow: 0 -2rpx 8rpx rgba(255,240,185,.75); }
.member-card__top, .member-card__foot { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.member-card__top image { width: 70rpx; height: 70rpx; flex: 0 0 70rpx; border-radius: 50%; }
.member-card__identity { min-width: 0; flex: 1; }
.member-card text { display: block; }
.member-card__identity text:first-child { overflow: hidden; color: #fff; font-size: 29rpx; font-weight: 750; line-height: 1.15; text-overflow: ellipsis; white-space: nowrap; }
.member-card__identity text:nth-child(2) { margin-top: 5rpx; overflow: hidden; color: rgba(238, 244, 239, .82); font-size: 17rpx; letter-spacing: 1.6rpx; text-overflow: ellipsis; white-space: nowrap; }
.member-card__identity text:last-child { margin-top: 4rpx; overflow: hidden; color: rgba(255,255,255,.78); font-size: 18rpx; letter-spacing: 1rpx; text-overflow: ellipsis; white-space: nowrap; }
.member-card__brand { flex: 0 0 auto; align-self: flex-start; margin-top: 4rpx; color: rgba(255,255,255,.68); font-size: 18rpx; font-weight: 700; letter-spacing: 1rpx; }
.member-card--gold .member-card__identity text:first-child, .member-card--gold .member-card__progress-copy text:last-child, .member-card--gold .member-card__foot > text { color: #f5d991; }
.member-card__progress { position: relative; z-index: 1; display: grid; gap: 9rpx; margin-top: 14rpx; }
.member-card__progress-copy { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 20rpx; }
.member-card__progress-copy text { overflow: hidden; color: rgba(235, 243, 237, .86); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.member-card__progress-copy text:last-child { color: #dce6c2; font-weight: 650; text-align: right; }
.member-card__track { height: 10rpx; overflow: hidden; border-radius: 999rpx; background: rgba(232, 238, 226, .26); }
.member-card__track view { height: 100%; min-width: 4rpx; border-radius: inherit; background: linear-gradient(90deg, #b6cf98, #e6d5a1); }
.member-card--silver .member-card__track view { background: linear-gradient(90deg, #d8ddd9, #fafaf6); }
.member-card--gold .member-card__track view { background: linear-gradient(90deg, #f8df8f, #c78e33); }
.member-card__foot { min-height: 26rpx; }
.member-card__foot > view { display: flex; min-width: 0; flex: 1; justify-content: space-between; gap: 12rpx; }
.member-card__foot > view text { color: rgba(238, 243, 235, .76); font-size: 18rpx; }
.member-card__foot > view text:last-child { text-align: right; }
.member-card__foot > text { flex: 0 0 auto; color: #e4d3a2; font-size: 18rpx; }
.member-status { display: grid; gap: 9rpx; margin-top: 18rpx; padding: 21rpx 22rpx; border: 1rpx solid #e3ddd3; border-radius: 19rpx; background: #fffdfa; }
.member-status text { color: #605950; font-size: 21rpx; line-height: 1.48; }
.member-status__title { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.member-status__title text:first-child { color: #244b37; font-size: 24rpx; font-weight: 750; }
.member-status__title text:last-child { color: #8a8178; font-size: 18rpx; font-weight: 400; text-align: right; }
.member-status > text:nth-child(3) { color: #315d46; font-weight: 650; }
.qualification-progress { display: grid; gap: 8rpx; margin-top: 2rpx; }
.qualification-progress > view { height: 10rpx; overflow: hidden; border-radius: 999rpx; background: #e4ece6; }
.qualification-progress > view view { height: 100%; min-width: 4rpx; border-radius: inherit; background: #315d46; }
.qualification-progress text { color: #69746c; font-size: 18rpx; }
.member-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 18rpx; }
.member-actions button { min-height: 124rpx; margin: 0; padding: 18rpx; text-align: left; border: 1rpx solid #e3ddd3; border-radius: 19rpx; background: #fff; }
.member-actions button::after { border: 0; }
.member-actions text { display: block; }
.member-actions text:first-child { color: #332e28; font-size: 24rpx; font-weight: 700; }
.member-actions text:last-child { margin-top: 10rpx; color: #315d46; font-size: 20rpx; }
.member-code-panel { display: flex; margin-top: 18rpx; padding: 22rpx; align-items: center; justify-content: space-between; gap: 22rpx; border: 1rpx solid #d9e6dd; border-radius: 19rpx; background: #f8fbf8; }
.member-code-panel > view { min-width: 0; flex: 1; }
.member-code-panel text { display: block; color: #6a756d; font-size: 19rpx; line-height: 1.5; }
.member-code-panel > view text:first-child { margin-bottom: 8rpx; color: #244b37; font-size: 25rpx; font-weight: 750; }
.member-code-qr { width: 190rpx; height: 190rpx; flex: 0 0 190rpx; border-radius: 12rpx; background: #fff; }
.member-code-unavailable { max-width: 230rpx; color: #8a8178 !important; text-align: right; }
.rights-section, .annual-section, .ledger-section { margin-top: 24rpx; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; }
.section-head > text:first-child, .section-head > view text:first-child { display: block; color: #29251f; font-size: 30rpx; font-family: "Songti SC", "STSong", serif; font-weight: 650; }
.section-head > text:last-child, .section-head > view text:last-child { color: #898178; font-size: 20rpx; }
.section-head button { width: auto; min-height: 48rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #315d46; font-size: 20rpx; line-height: 48rpx; }
.section-head button::after { border: 0; }
.rights-list, .calendar-list, .ledger-list, .processing-list { display: grid; gap: 14rpx; margin-top: 16rpx; }
.right-row, .calendar-row { display: flex; padding: 20rpx 22rpx; align-items: center; justify-content: space-between; gap: 18rpx; border: 1rpx solid #e5dfd7; border-radius: 18rpx; background: #fff; }
.right-row > view, .calendar-row > view { min-width: 0; }
.right-row > view:first-child, .calendar-row > view:first-child { flex: 1; }
.right-row > view:last-child, .calendar-row > view:last-child { max-width: 250rpx; text-align: right; }
.right-row text, .calendar-row text { display: block; }
.right-row > view:first-child text:first-child, .calendar-row > view:first-child text:first-child { color: #302b25; font-size: 24rpx; font-weight: 700; }
.right-row > view:first-child text:last-child, .calendar-row > view:first-child text:last-child { margin-top: 6rpx; color: #716960; font-size: 20rpx; line-height: 1.45; }
.right-row > view:last-child text, .calendar-row > view:last-child text { color: #315d46; font-size: 20rpx; line-height: 1.45; }
.right-row > view:last-child text:not(:first-child), .calendar-row > view:last-child text:last-child { margin-top: 6rpx; color: #8b837a; font-size: 18rpx; }
.annual-section { padding: 22rpx; border: 1rpx solid #d9e6dd; border-radius: 20rpx; background: #f8fbf8; }
.annual-section .section-head { align-items: flex-start; }
.calendar-filter { min-width: 136rpx; padding: 12rpx 14rpx; border: 1rpx solid #c6d8cd; border-radius: 999rpx; color: #315d46; font-size: 19rpx; text-align: center; }
.annual-note { display: block; margin-top: 14rpx; color: #6a756d; font-size: 20rpx; line-height: 1.55; }
.daily-snack-code { margin-top: 18rpx; padding: 22rpx; border: 1rpx solid #d7ae62; border-radius: 20rpx; background: #fffdf5; text-align: center; }
.daily-snack-code .section-head { text-align: left; }
.daily-snack-code .section-head > view text { display: block; }
.daily-snack-code .section-head > view text:last-child { margin-top: 5rpx; color: #7c725f; font-size: 19rpx; }
.daily-snack-code > image { display: block; width: 330rpx; height: 330rpx; margin: 20rpx auto 8rpx; border-radius: 14rpx; background: #fff; }
.daily-snack-code > text { display: block; color: #756b5d; font-size: 19rpx; line-height: 1.5; }
.daily-snack-code__value { color: #244b37 !important; font-size: 24rpx !important; font-weight: 750; letter-spacing: 1rpx; }
.ledger-section { padding: 22rpx; border: 1rpx solid #e4ded5; border-radius: 20rpx; background: #fff; }
.ledger-list, .processing-list { gap: 0; }
.ledger-row, .processing-row { display: flex; min-height: 82rpx; padding: 12rpx 0; align-items: center; justify-content: space-between; gap: 16rpx; border-top: 1rpx solid #eee8df; }
.ledger-row:first-child, .processing-row:first-child { border-top: 0; }
.ledger-row view, .processing-row view { min-width: 0; flex: 1; }
.ledger-row text, .processing-row text { display: block; }
.ledger-row view text:first-child, .processing-row view text:first-child { color: #403a33; font-size: 22rpx; }
.ledger-row view text:last-child, .processing-row view text:last-child { margin-top: 5rpx; color: #8a8278; font-size: 18rpx; line-height: 1.4; }
.ledger-row > text { color: #8a6a3d; font-size: 22rpx; font-weight: 700; text-align: right; }
.ledger-row > text.positive, .processing-row > text { color: #315d46; }
.processing-row > text { flex: 0 0 auto; font-size: 19rpx; }
@media (max-width: 390px) { .member-card__bottom { margin-top: 45rpx; } .member-actions { gap: 10rpx; } .member-actions button { padding: 16rpx; } .member-code-panel { align-items: flex-start; } .member-code-qr { width: 164rpx; height: 164rpx; flex-basis: 164rpx; } .right-row, .calendar-row { align-items: flex-start; } .calendar-filter { min-width: 116rpx; } }
