.profile-band{padding-bottom:42rpx}.profile-greeting{display:block;margin-top:42rpx;font-size:43rpx;font-weight:750}.member-card{padding:30rpx;border-radius:8rpx;background:#202329;color:#fff}.member-card>view:first-child{display:flex;justify-content:space-between;color:#cfd3da;font-size:21rpx}.points-number{display:block;margin-top:32rpx;font-size:62rpx;font-weight:750}.member-card>text:nth-child(3){color:#b9bec6;font-size:21rpx}.member-stats{display:flex;margin-top:28rpx;padding-top:20rpx;justify-content:space-between;border-top:1rpx solid #45494f;font-size:22rpx}.join-band{padding:30rpx;border:1rpx solid #dcdfe4;border-top:6rpx solid #d84736;border-radius:8rpx;background:#fff}.join-band text{display:block}.join-band text:first-child{font-size:31rpx;font-weight:750}.join-band text:nth-child(2){margin:12rpx 0 24rpx;color:#6b727c;font-size:23rpx}.join-band button{margin:0;background:#202329;color:#fff}.point-row{display:flex;padding:20rpx 0;align-items:center;justify-content:space-between;border-bottom:1rpx solid #e7e9ed}.point-row view text{display:block}.point-row view text:first-child{font-size:25rpx}.point-row view text:last-child{margin-top:5rpx;color:#818791;font-size:19rpx}.point-row>text{font-size:28rpx;font-weight:700}.positive{color:#26724f}.empty-copy{display:block;padding:30rpx 0;color:#7a818b;text-align:center}
