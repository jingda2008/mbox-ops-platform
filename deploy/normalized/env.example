# Copy this file outside the repository, restrict it to the deployment operator,
# and replace every placeholder. Do not commit the resulting environment file.
NODE_ENV=production
MBOX_DEPLOYMENT_TIER=production
PORT=8787
DATABASE_URL=<new-empty-normalized-database-url>
MBOX_TENANT_ID=<tenant-uuid>
MBOX_STORE_ID=<store-uuid>
MBOX_NORMALIZED_SECRET=<at-least-32-byte-secret>
MBOX_METRICS_TOKEN=<at-least-32-byte-private-metrics-token>
MBOX_DATABASE_POOL_MAX=12
MBOX_WORKER_DATABASE_POOL_MAX=4
MBOX_GUEST_PAYMENT_MODE=<wechat_jsapi-or-wechat_native_qr>
MBOX_TRUST_PROXY_HOPS=1
MBOX_INVENTORY_ENFORCEMENT_MODE=strict
MBOX_GUEST_ORDER_DUPLICATE_WINDOW_SECONDS=45
MBOX_GUEST_ORDER_CUSTOMER_LIMIT_PER_MINUTE=5
MBOX_GUEST_ORDER_TABLE_LIMIT_PER_MINUTE=20
MBOX_PAYMENT_PROVIDER=postar
POSTAR_ENVIRONMENT=<uat-or-production>
POSTAR_AGENCY_ID=<agency-id>
POSTAR_MERCHANT_ID=<merchant-id>
POSTAR_PUBLIC_KEY=<provider-public-key>
POSTAR_CALLBACK_URL=https://pay.shmbox.com/api/payments/providers/postar/callback
POSTAR_HTTP_TIMEOUT_MS=10000
# Configure both values only after a trusted official-account or mini-program
# identity exchange is live. Never accept an openid from browser request data.
POSTAR_WECHAT_APP_ID=
POSTAR_WECHAT_TRADE_TYPE=
MBOX_START_WORKERS=true
MBOX_WORKER_ID=<unique-worker-id>
MBOX_WORKER_ADAPTER_MODULE=<absolute-path-to-commercial-worker-adapter>
