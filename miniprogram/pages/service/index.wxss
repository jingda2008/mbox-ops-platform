.service-table { display: block; color: #ffffff; font-size: 48rpx; font-weight: 750; }
.service-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.service-item { min-height: 154rpx; margin: 0; padding: 26rpx 22rpx; border: 1rpx solid #dfe2e7; border-radius: 8rpx; background: #ffffff; color: #202329; text-align: left; line-height: 1.2; }
.service-item::after { border: 0; }
.service-item[disabled] { background: #eef0f2; color: #8a9099; }
.service-item__name { display: block; font-size: 28rpx; font-weight: 700; }
.service-item__meta { display: block; margin-top: 14rpx; color: #777f8a; font-size: 21rpx; line-height: 1.4; }
.note-field { margin-top: 30rpx; }
.custom-request-row { display: grid; grid-template-columns: minmax(0, 1fr) 168rpx; gap: 14rpx; }
.custom-request-button { height: 82rpx; margin: 0; padding: 0; border-radius: 8rpx; background: #202328; color: #ffffff; font-size: 26rpx; font-weight: 700; line-height: 82rpx; }
.custom-request-button::after { border: 0; }
.custom-request-button[disabled] { background: #a8adb5; color: #f4f5f7; }
.status-link { display: block; margin-top: 18rpx; text-align: center; }
