.performances-page{padding-top:0}.performance-hero{margin:0 -28rpx 24rpx;padding:42rpx 28rpx 38rpx;background:radial-gradient(circle at 88% 7%,rgba(202,164,103,.25),transparent 34%),linear-gradient(145deg,#111a15,#254332);color:#fff}.performance-hero__eyebrow,.performance-hero__title,.performance-hero__description{display:block}.performance-hero__eyebrow{color:#d6b177;font-size:19rpx;font-weight:700;letter-spacing:4rpx}.performance-hero__title{margin-top:12rpx;font-family:"Songti SC","STSong",serif;font-size:44rpx;font-weight:600}.performance-hero__description{margin-top:12rpx;color:#d3dcd5;font-size:22rpx}.date-picker-card{padding:20rpx 22rpx;border:1rpx solid #ddd7cf;border-radius:18rpx;background:#fff}.date-picker-card__label{display:block;color:#857b71;font-size:19rpx}.date-picker-card__value{display:flex;min-height:60rpx;align-items:end;justify-content:space-between;font-size:28rpx;font-weight:700}.date-picker-card__action{color:#315d46;font-size:20rpx;font-weight:500}.schedule-list{display:grid;margin-top:18rpx;gap:12rpx}.schedule-card{display:grid;min-height:146rpx;padding:14rpx;grid-template-columns:118rpx minmax(0,1fr);align-items:center;border:1rpx solid #ddd7cf;border-radius:18rpx;background:#fff;gap:18rpx}.schedule-card__image,.schedule-avatar{width:118rpx;height:118rpx;border-radius:14rpx;background:#214635}.schedule-avatar{display:flex;align-items:center;justify-content:center;color:#d8b37a;font-size:20rpx;font-weight:700;letter-spacing:2rpx}.schedule-card__time,.schedule-card__performer,.schedule-card__description{display:block}.schedule-card__time{color:#8f6b40;font-size:19rpx;font-weight:700}.schedule-card__performer{margin-top:9rpx;font-family:"Songti SC","STSong",serif;font-size:30rpx;font-weight:600}.schedule-card__description{margin-top:8rpx;color:#7b736a;font-size:19rpx;line-height:1.4}.schedule-note{display:block;margin:22rpx 4rpx;color:#8b837a;font-size:18rpx;line-height:1.5}@media(max-width:390px){.performances-page{padding-right:22rpx;padding-left:22rpx}.performance-hero{margin-right:-22rpx;margin-left:-22rpx;padding-right:22rpx;padding-left:22rpx}}

.day-pager{display:flex;margin-top:16rpx;align-items:center;gap:8rpx}.day-pager__nav{display:flex;flex:0 0 88rpx;width:88rpx;min-height:112rpx;margin:0;padding:0;align-items:center;justify-content:center;border:0;border-radius:16rpx;background:transparent;color:#315d46;font-size:48rpx;font-weight:400;line-height:1}.day-pager__nav-label{display:block;margin-top:-6rpx}.day-pager__nav.is-disabled{color:#c9c3ba}.day-pager__nav.is-next{color:#315d46}.day-window{display:flex;min-width:0;flex:1;gap:8rpx}.day-chip{display:flex;min-width:0;min-height:112rpx;margin:0;padding:11rpx 0 9rpx;flex:1;flex-direction:column;align-items:center;justify-content:center;border:1rpx solid #ddd7cf;border-radius:14rpx;background:#fffdfa;color:#5a524a;line-height:1;box-shadow:0 2rpx 5rpx rgba(42,36,29,.04);transition:transform .12s ease,background .12s ease,border-color .12s ease,box-shadow .12s ease}.day-chip__weekday,.day-chip__date,.day-chip__marker{display:block;text-align:center}.day-chip__weekday{color:#8b837a;font-size:17rpx;line-height:1.1}.day-chip__date{margin-top:6rpx;color:#3d3731;font-size:30rpx;font-weight:700;line-height:1}.day-chip__marker{min-height:16rpx;margin-top:6rpx;color:#8f6b40;font-size:15rpx;font-weight:600;line-height:1}.day-chip__marker.is-empty{color:transparent}.day-chip.is-today{border-color:#b7cabc;background:#f4f8f4}.day-chip.is-today .day-chip__weekday,.day-chip.is-today .day-chip__date{color:#315d46}.day-chip.is-on{border-color:#315d46;background:#315d46;color:#fff;box-shadow:0 5rpx 12rpx rgba(49,93,70,.2)}.day-chip.is-on .day-chip__weekday,.day-chip.is-on .day-chip__date{color:#fff}.day-chip.is-on .day-chip__marker{color:#d8b37a}.day-chip--pressed{transform:scale(.96);border-color:#315d46;background:#e1eee5;box-shadow:0 0 0 5rpx rgba(49,93,70,.1)}.day-chip.is-on.day-chip--pressed{background:#244a35}
