.order-page {
  width: 100%;
  overflow-x: hidden;
  padding-top: 0;
  padding-bottom: 230rpx;
}
.order-head {
  display: flex;
  margin: 0 -28rpx 24rpx;
  padding: 34rpx 28rpx 30rpx;
  align-items: center;
  justify-content: space-between;
  background:
    radial-gradient(circle at 88% 0, rgba(198, 163, 105, .28), transparent 32%),
    radial-gradient(circle at 18% 96%, rgba(69, 123, 92, .28), transparent 42%),
    linear-gradient(145deg, #0d1712, #234031 68%, #101512);
  color: #fff;
}
.order-title {
  display: block;
  font-family: "Songti SC", "STSong", serif;
  font-size: 44rpx;
  font-weight: 600;
}
.service-entry {
  min-width: 160rpx;
  min-height: 88rpx;
  margin: 0;
  border: 1rpx solid #7e6a4f;
  border-radius: 44rpx;
  background: transparent;
  color: #dfc18f;
  font-size: 23rpx;
  line-height: 86rpx;
}
.gate-wrap {
  display: block;
  padding: 0 0 48rpx;
  text-align: left;
}
.browse-intro {
  position: relative;
  overflow: hidden;
  margin: 0 -4rpx;
  padding: 38rpx 30rpx 32rpx;
  border: 1rpx solid rgba(202, 170, 119, 0.38);
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 88% 10%, rgba(198, 163, 105, .28), transparent 32%),
    radial-gradient(circle at 18% 96%, rgba(69, 123, 92, .28), transparent 42%),
    linear-gradient(145deg, #0d1712, #234031 68%, #101512);
  color: #fff;
  box-shadow: 0 20rpx 54rpx rgba(25, 21, 17, 0.16);
}
.browse-intro::after {
  position: absolute;
  right: -110rpx;
  bottom: -175rpx;
  width: 330rpx;
  height: 330rpx;
  border: 1rpx solid rgba(218, 184, 130, 0.2);
  border-radius: 50%;
  content: "";
}
.browse-intro__copy {
  position: relative;
  z-index: 1;
}
.gate-logo {
  position: absolute;
  z-index: 1;
  top: 24rpx;
  right: 24rpx;
  display: block;
  width: 84rpx;
  height: 84rpx;
  border: 1rpx solid rgba(206, 169, 110, 0.42);
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.18);
}
.gate-art {
  position: absolute;
  z-index: 1;
  top: 26rpx;
  right: 26rpx;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  opacity: 0.9;
}
.gate-ring {
  position: absolute;
  inset: 0;
  border: 1rpx solid #a8885a;
  border-radius: 50%;
}
.gate-ring::before,
.gate-ring::after {
  position: absolute;
  border: 1rpx solid rgba(222, 208, 184, 0.45);
  border-radius: 50%;
  content: "";
}
.gate-ring::before {
  inset: 12rpx;
}
.gate-ring::after {
  inset: 24rpx;
}
.gate-mark {
  position: relative;
  z-index: 1;
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #c5a46f;
  border-radius: 10rpx;
  color: #f4eadb;
  font-family: "Songti SC", serif;
  font-size: 25rpx;
}
.gate-kicker,
.gate-title,
.gate-copy,
.gate-note {
  display: block;
}
.gate-kicker {
  padding-right: 110rpx;
  color: #caaa77;
  font-size: 19rpx;
  letter-spacing: 3rpx;
}
.gate-title {
  max-width: 470rpx;
  margin-top: 18rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.3;
}
.gate-copy {
  max-width: 560rpx;
  margin-top: 16rpx;
  color: #cbc4ba;
  font-size: 23rpx;
  line-height: 1.7;
}
.gate-button {
  position: relative;
  z-index: 1;
  width: 100%;
  margin-top: 30rpx;
  background: #f3eee6;
  color: #211e1a;
}
.gate-note {
  position: relative;
  z-index: 1;
  margin-top: 17rpx;
  color: #9e978f;
  font-size: 19rpx;
  text-align: center;
}
.gate-error {
  width: 100%;
  margin-top: 18rpx;
  text-align: left;
}
.browse-menu {
  margin-top: 38rpx;
}
.browse-menu__heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.browse-menu__heading view text {
  display: block;
}
.browse-menu__heading view text:first-child {
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 600;
}
.browse-menu__heading view text:last-child {
  margin-top: 7rpx;
  color: #837b72;
  font-size: 20rpx;
}
.browse-menu__heading > text {
  color: #927049;
  font-size: 21rpx;
}
.menu-tools--browse {
  position: static;
  margin: 24rpx 0 0;
  padding: 0;
  border: 0;
  background: transparent;
}
.preview-product-grid {
  display: grid;
  margin-top: 24rpx;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.preview-product-card {
  overflow: hidden;
  min-width: 0;
  border: 1rpx solid #dfd8ce;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #fff, #f8f4ed);
  box-shadow: 0 14rpx 34rpx rgba(30, 54, 40, .075);
}
.preview-product-card__visual {
  position: relative;
  height: 220rpx;
  background:
    radial-gradient(circle at 78% 12%, rgba(198, 163, 105, .22), transparent 32%),
    linear-gradient(145deg, #284536, #101713);
}
.preview-product-card__visual image {
  width: 100%;
  height: 100%;
}
.preview-product-card__placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  color: #d9c29d;
}
.preview-product-card__placeholder text:first-child {
  font-family: "Songti SC", serif;
  font-size: 52rpx;
}
.preview-product-card__placeholder text:last-child {
  margin-top: 8rpx;
  color: #8f806e;
  font-size: 16rpx;
  letter-spacing: 3rpx;
}
.preview-product-card__kind {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(18, 16, 14, 0.76);
  color: #ead6b5;
  font-size: 17rpx;
}
.preview-product-card__body {
  padding: 20rpx;
}
.preview-product-card__name,
.preview-product-card__copy {
  display: block;
}
.preview-product-card__name {
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.preview-product-card__copy {
  display: -webkit-box;
  min-height: 58rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #7a736a;
  font-size: 19rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.preview-product-card__body > view {
  display: flex;
  margin-top: 16rpx;
  align-items: center;
  justify-content: space-between;
}
.preview-product-card__body > view text:first-child {
  font-size: 27rpx;
  font-weight: 750;
}
.preview-product-card__body > view text:last-child {
  color: #87745d;
  font-size: 18rpx;
}
.preview-product-card__body > view text.is-unavailable {
  color: #9a8175;
}
.waiting-pulse {
  display: flex;
  width: 150rpx;
  height: 150rpx;
  margin-bottom: 40rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d2b682;
  border-radius: 50%;
  animation: pulse 1.8s ease-in-out infinite;
}
.waiting-pulse view {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #332d27;
}
.table-strip {
  display: flex;
  min-height: 112rpx;
  padding: 18rpx 22rpx;
  align-items: center;
  border: 1rpx solid #ddd7cf;
  border-radius: 18rpx;
  background: #fff;
  gap: 18rpx;
}
.table-strip > view:first-child {
  flex: 0 0 auto;
}
.table-strip__label,
.table-strip__value,
.show-brief text {
  display: block;
}
.table-strip__label {
  color: #91877c;
  font-size: 19rpx;
}
.table-strip__value {
  margin-top: 5rpx;
  font-size: 27rpx;
  font-weight: 750;
}
.show-brief {
  min-width: 0;
  padding-left: 18rpx;
  flex: 1;
  border-left: 1rpx solid #e2ddd6;
}
.show-brief text:first-child {
  color: #9d6c32;
  font-size: 19rpx;
}
.show-brief text:last-child {
  margin-top: 5rpx;
  overflow: hidden;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.table-strip > button {
  width: 96rpx;
  min-height: 72rpx;
  margin: 0;
  border: 0;
  border-radius: 36rpx;
  background: #eee8df;
  color: #604a31;
  font-size: 22rpx;
  line-height: 72rpx;
}
.payment-recovery,
.checkout-recovery {
  display: grid;
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #d6b06f;
  border-radius: 18rpx;
  background: #fffaf0;
  grid-template-columns: 1fr auto auto;
  align-items: center;
  gap: 12rpx;
}
.payment-recovery view text,
.checkout-recovery view text {
  display: block;
}
.payment-recovery view text:first-child,
.checkout-recovery view text:first-child {
  font-size: 24rpx;
  font-weight: 700;
}
.payment-recovery view text:last-child,
.checkout-recovery view text:last-child {
  margin-top: 6rpx;
  color: #806f58;
  font-size: 19rpx;
}
.payment-recovery button,
.checkout-recovery button {
  min-width: 120rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 36rpx;
  background: #315d46;
  color: #fff;
  font-size: 21rpx;
  line-height: 72rpx;
}
.payment-recovery button:last-child,
.checkout-recovery button:last-child {
  border: 1rpx solid #b9a47f;
  background: transparent;
  color: #604c31;
}
.recommend-entry {
  margin-top: 24rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #284536, #101713);
  color: #fff;
}
.recommend-entry__copy text {
  display: block;
}
.recommend-entry__copy text:first-child {
  font-family: "Songti SC", "STSong", serif;
  font-size: 31rpx;
}
.recommend-entry__copy text:last-child {
  margin-top: 8rpx;
  color: #c9c2b8;
  font-size: 21rpx;
  line-height: 1.5;
}
.decision-row {
  display: grid;
  margin-top: 22rpx;
  grid-template-columns: 1fr 1fr auto;
  gap: 10rpx;
}
.decision-row picker > view {
  height: 88rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #4f6a5c;
  border-radius: 14rpx;
  background: #17271f;
}
.decision-row picker text {
  display: block;
}
.decision-row picker text:first-child {
  color: #a89d90;
  font-size: 18rpx;
}
.decision-row picker text:last-child {
  margin-top: 5rpx;
  font-size: 22rpx;
  font-weight: 700;
}
.decision-row button {
  width: 118rpx;
  min-height: 88rpx;
  margin: 0;
  border-radius: 14rpx;
  background: #c59b5e;
  color: #201b16;
  font-size: 23rpx;
  line-height: 88rpx;
}
.recommend-scroll {
  width: 100%;
}
.recommend-row {
  display: flex;
  padding-bottom: 6rpx;
  gap: 16rpx;
}
.recommend-card {
  overflow: hidden;
  width: 440rpx;
  min-height: 430rpx;
  flex: 0 0 auto;
  border: 1rpx solid #ddd7cf;
  border-radius: 20rpx;
  background: #fff;
}
.recommend-card > image {
  width: 100%;
  height: 180rpx;
  background: #29251f;
}
.recommend-body {
  display: flex;
  min-height: 250rpx;
  padding: 24rpx;
  flex-direction: column;
}
.recommend-tier {
  color: #9b6b34;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.recommend-name {
  display: block;
  margin-top: 8rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 600;
}
.recommend-reason {
  display: block;
  margin-top: 10rpx;
  color: #706960;
  font-size: 21rpx;
  line-height: 1.5;
}
.saving {
  display: block;
  margin-top: 8rpx;
  color: #28704d;
  font-size: 20rpx;
}
.recommend-foot {
  display: flex;
  margin-top: auto;
  align-items: center;
  justify-content: space-between;
}
.recommend-price {
  font-size: 31rpx;
  font-weight: 750;
}
.recommend-foot button {
  width: 100rpx;
  min-height: 72rpx;
  margin: 0;
  border-radius: 36rpx;
  background: #315d46;
  color: #fff;
  font-size: 22rpx;
  line-height: 72rpx;
}
.menu-tools {
  position: sticky;
  z-index: 6;
  top: 0;
  margin: 30rpx -28rpx 0;
  padding: 18rpx 28rpx 12rpx;
  border-bottom: 1rpx solid #e0dbd4;
  background: rgba(247, 245, 241, 0.96);
}
.search-box {
  display: flex;
  height: 88rpx;
  padding: 0 22rpx;
  align-items: center;
  border: 1rpx solid #d6d0c7;
  border-radius: 44rpx;
  background: #fff;
  gap: 12rpx;
}
.search-box > text {
  color: #8d7d68;
  font-size: 30rpx;
}
.search-box input {
  min-width: 0;
  flex: 1;
  font-size: 24rpx;
}
.category-scroll {
  width: 100%;
  margin-top: 14rpx;
}
.category-row {
  display: flex;
  gap: 10rpx;
}
.category-row button {
  width: auto;
  min-width: 112rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  flex: 0 0 auto;
  border: 1rpx solid #d5cfc6;
  border-radius: 36rpx;
  background: #fff;
  color: #6f675f;
  font-size: 22rpx;
  line-height: 70rpx;
}
.category-row button.is-active {
  border-color: #315d46;
  background: #315d46;
  color: #fff;
}
.product-section {
  margin-top: 24rpx;
}
.product-list {
  display: grid;
  gap: 14rpx;
}
.product-row {
  display: flex;
  min-height: 174rpx;
  padding: 20rpx;
  align-items: center;
  border: 1rpx solid #ded7cd;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(42, 34, 26, 0.045);
  gap: 20rpx;
}
.product-media {
  display: flex;
  width: 134rpx;
  height: 134rpx;
  overflow: hidden;
  align-items: center;
  flex: 0 0 auto;
  justify-content: center;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #284536, #101713);
}
.product-media image {
  width: 100%;
  height: 100%;
}
.product-media__placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  color: #d7bd93;
  font-family: "Songti SC", serif;
  font-size: 42rpx;
}
.product-main {
  min-width: 0;
  flex: 1;
}
.product-main text {
  display: block;
}
.product-kind {
  color: #9b6a31;
  font-size: 18rpx;
  font-weight: 700;
}
.product-name {
  margin-top: 6rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 29rpx;
  font-weight: 650;
}
.product-copy {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #7a736b;
  font-size: 20rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.product-action {
  flex: 0 0 auto;
  text-align: right;
}
.product-price {
  display: block;
  font-size: 27rpx;
  font-weight: 750;
}
.product-action button {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  margin: 14rpx 0 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #315d46;
  border-radius: 44rpx;
  background:
    linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,0) 44%),
    linear-gradient(145deg, #315d46, #214635);
  color: #fff;
  font-size: 34rpx;
  line-height: 88rpx;
}
.cart-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #d8d2c9;
  background: rgba(248, 247, 242, 0.98);
  box-shadow: 0 -14rpx 38rpx rgba(24, 20, 17, 0.12);
}
.cart-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.cart-summary > view {
  min-width: 0;
  flex: 1;
}
.cart-summary text {
  display: block;
}
.cart-summary text:first-child {
  font-size: 29rpx;
  font-weight: 750;
}
.cart-summary text:last-child {
  margin-top: 4rpx;
  color: #8a8279;
  font-size: 18rpx;
}
.checkout-button {
  width: 270rpx;
  min-height: 92rpx;
  margin: 0;
  border-radius: 46rpx;
  background:
    linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,0) 44%),
    linear-gradient(145deg, #315d46, #214635);
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 92rpx;
  box-shadow: 0 10rpx 24rpx rgba(35, 78, 58, 0.2);
}
.cart-lines {
  max-height: 150rpx;
  margin-top: 10rpx;
}
.cart-lines > view {
  display: flex;
  min-height: 70rpx;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #eeeae4;
  font-size: 21rpx;
}
.cart-lines > view > text {
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-lines button {
  width: 72rpx;
  height: 64rpx;
  margin: 0 10rpx;
  padding: 0;
  border: 0;
  border-radius: 32rpx;
  background: #eee9e2;
  line-height: 64rpx;
}
.sheet-mask {
  position: fixed;
  z-index: 50;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(8, 7, 6, 0.62);
}
.upgrade-sheet {
  width: 100%;
  max-height: 88vh;
  overflow: auto;
  padding: 18rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #f9f7f3;
}
.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 4rpx;
  background: #d1cbc2;
}
.upgrade-title,
.upgrade-copy {
  display: block;
}
.upgrade-title {
  margin-top: 8rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 39rpx;
  font-weight: 600;
}
.upgrade-copy {
  margin-top: 12rpx;
  color: #69625b;
  font-size: 23rpx;
  line-height: 1.6;
}
.upgrade-price {
  display: grid;
  margin: 24rpx 0;
  padding: 22rpx;
  border-left: 6rpx solid #a77a40;
  border-radius: 0 14rpx 14rpx 0;
  background: #eee8df;
  gap: 7rpx;
}
.upgrade-add {
  font-size: 33rpx;
  font-weight: 750;
}
.included-list {
  display: grid;
  gap: 10rpx;
}
.included-list > view {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 23rpx;
}
.included-list > view > text:first-child {
  color: #8d6738;
}
.rule-copy {
  display: block;
  margin: 20rpx 0;
  color: #777067;
  font-size: 20rpx;
  line-height: 1.5;
}
.upgrade-sheet .secondary-button {
  margin-top: 12rpx;
}
@keyframes pulse {
  0%,
  100% {
    transform: scale(0.94);
    opacity: 0.68;
  }
  50% {
    transform: scale(1);
    opacity: 1;
  }
}
@media (max-width: 350px) {
  .order-head {
    margin-right: -22rpx;
    margin-left: -22rpx;
    padding-right: 22rpx;
    padding-left: 22rpx;
  }
  .menu-tools {
    margin-right: -22rpx;
    margin-left: -22rpx;
    padding-right: 22rpx;
    padding-left: 22rpx;
  }
  .decision-row {
    grid-template-columns: 1fr 1fr;
  }
  .decision-row button {
    width: 100%;
    grid-column: 1/3;
  }
  .payment-recovery,
  .checkout-recovery {
    grid-template-columns: 1fr 1fr;
  }
  .payment-recovery view,
  .checkout-recovery view {
    grid-column: 1/3;
  }
  .recommend-card {
    width: 390rpx;
  }
  .product-media {
    width: 100rpx;
    height: 100rpx;
  }
  .checkout-button {
    width: 220rpx;
  }
}
.membership-invite {
  display: grid;
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #d8c7aa;
  border-radius: 18rpx;
  background: #f8f3e9;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: 12rpx 18rpx;
}
.membership-invite__copy text {
  display: block;
}
.membership-invite__copy text:first-child {
  font-family: "Songti SC", "STSong", serif;
  font-size: 27rpx;
  font-weight: 600;
}
.membership-invite__copy text:nth-child(2) {
  margin-top: 6rpx;
  color: #766d62;
  font-size: 20rpx;
  line-height: 1.5;
}
.membership-invite__copy text:last-child {
  margin-top: 5rpx;
  color: #948876;
  font-size: 18rpx;
  line-height: 1.4;
}
.membership-invite__actions {
  display: flex;
  gap: 8rpx;
}
.membership-invite__actions button {
  width: auto;
  min-width: 120rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 36rpx;
  background: #2d2925;
  color: #fff;
  font-size: 21rpx;
  line-height: 72rpx;
}
.membership-invite__actions button:last-child {
  border: 1rpx solid #b9a98e;
  background: transparent;
  color: #655844;
}
.membership-invite__recovery {
  width: auto;
  min-height: 58rpx;
  margin: 0;
  padding: 0;
  grid-column: 1/3;
  border: 0;
  background: transparent;
  color: #7b5c31;
  font-size: 20rpx;
  line-height: 58rpx;
  text-align: left;
}
.membership-invite__privacy {
  width: auto;
  min-height: 58rpx;
  margin: 0;
  padding: 0;
  grid-column: 1/3;
  border: 0;
  background: transparent;
  color: #6f675f;
  font-size: 19rpx;
  line-height: 58rpx;
  text-align: left;
}
@media (max-width: 350px) {
  .membership-invite {
    grid-template-columns: 1fr 1fr;
  }
  .membership-invite__copy,
  .membership-invite__actions {
    grid-column: 1/3;
  }
  .membership-invite__actions button {
    flex: 1;
  }
}
