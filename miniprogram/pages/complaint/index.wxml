<view class="page">
  <view class="top-band complaint-band">
    <view class="brand-row"><view><text class="eyebrow">{{tableCode}} · 独立处理通道</text><text class="complaint-title">投诉由领班接管</text></view><text wx:if="{{isDevelopment}}" class="dev-badge">开发模式</text></view>
    <text class="complaint-subtitle">当前服务员会收到知会，但不能自行关闭投诉。</text>
  </view>
  <state-panel wx:if="{{loading}}" type="loading" title="正在连接投诉通道" />
  <block wx:else>
    <view wx:if="{{warning}}" class="warning">{{warning}}</view>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>
    <view wx:if="{{success}}" class="success-banner">{{success}}</view>
    <view class="panel complaint-form">
      <label class="field">
        <text class="field__label">问题类型</text>
        <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="picker-field">{{categories[categoryIndex]}}<text>选择</text></view>
        </picker>
      </label>
      <label class="field">
        <text class="field__label">发生了什么</text>
        <textarea class="field__textarea" maxlength="300" value="{{details}}" placeholder="请描述事实和您希望如何解决" bindinput="onDetailsInput" />
      </label>
      <button class="danger-button" disabled="{{submitting || !complaintServiceId || isFallback}}" bindtap="submitComplaint">{{submitting ? '正在提交' : '提交给领班'}}</button>
    </view>
    <view class="complaint-policy"><text>处理原则</text><text>提交后可持续查看进度；选择“仍未解决”会自动升级值班经理。</text></view>
    <navigator class="secondary-button status-link" url="/pages/status/index">查看投诉进度</navigator>
  </block>
</view>
