.detail-page {
  padding-top: 0;
  padding-bottom: 200rpx;
}

.detail-hero {
  position: relative;
  height: 520rpx;
  margin: 0 -28rpx 28rpx;
  overflow: hidden;
  background: #241f1b;
  color: #fff;
}

.detail-hero > image,
.detail-placeholder,
.detail-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.detail-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #54352a, #181514);
  color: rgba(255, 255, 255, .12);
  font-family: serif;
  font-size: 90rpx;
}

.detail-shade { background: linear-gradient(to bottom, rgba(8, 7, 6, .05), rgba(8, 7, 6, .82)); }
.detail-title { position: absolute; z-index: 1; right: 28rpx; bottom: 34rpx; left: 28rpx; }
.detail-title text { display: block; }
.detail-title text:first-child { color: #d8b782; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.detail-title text:nth-child(2) { margin-top: 10rpx; font-family: "Songti SC", "STSong", serif; font-size: 45rpx; font-weight: 600; line-height: 1.25; }
.detail-title text:last-child { margin-top: 12rpx; color: #d8d0c6; font-size: 22rpx; }
.detail-share { position: absolute; z-index: 2; top: 14rpx; right: 20rpx; min-width: 132rpx; min-height: 88rpx; margin: 0; padding: 0 22rpx; border: 1rpx solid rgba(255, 255, 255, .62); border-radius: 999rpx; background: rgba(19, 25, 20, .32); color: #fff; font-size: 21rpx; line-height: 86rpx; }
.detail-share::after { border: 0; }

.detail-facts {
  display: grid;
  padding: 22rpx 0;
  border-top: 1rpx solid #ddd7cf;
  border-bottom: 1rpx solid #ddd7cf;
  grid-template-columns: repeat(2, 1fr);
}
.detail-facts > view { text-align: center; border-right: 1rpx solid #e0dad2; }
.detail-facts > view:last-child { border: 0; }
.detail-facts text { display: block; }
.detail-facts text:first-child { font-size: 26rpx; font-weight: 750; }
.detail-facts text:last-child { margin-top: 6rpx; color: #8a8279; font-size: 18rpx; }
.detail-preview-note { display: grid; margin-top: 20rpx; padding: 18rpx 20rpx; border-left: 5rpx solid #5a806a; border-radius: 0 14rpx 14rpx 0; background: #f2f8f4; gap: 6rpx; }
.detail-preview-note text:first-child { color: #315d46; font-size: 21rpx; font-weight: 700; }
.detail-preview-note text:last-child { color: #5d6b61; font-size: 19rpx; line-height: 1.5; }

.detail-section { padding-bottom: 28rpx; border-bottom: 1rpx solid #ddd7cf; }
.detail-heading { display: block; font-family: "Songti SC", "STSong", serif; font-size: 31rpx; font-weight: 600; }
.detail-summary { display: block; margin-top: 14rpx; color: #655f58; font-size: 23rpx; line-height: 1.75; white-space: pre-wrap; }
.info-list { display: grid; margin-top: 12rpx; }
.info-list > view { display: flex; min-height: 76rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #ebe7e1; gap: 24rpx; }
.info-list > view text:first-child { color: #8a8178; font-size: 20rpx; }
.info-list > view text:last-child { text-align: right; font-size: 22rpx; }

.payment-rule-grid {
  display: grid;
  margin-top: 16rpx;
  overflow: hidden;
  border: 1rpx solid #dfd6ca;
  border-radius: 18rpx;
  background: #fffdfa;
}
.payment-rule-grid > view { display: grid; padding: 18rpx 20rpx; border-bottom: 1rpx solid #ebe5dc; grid-template-columns: 126rpx 1fr; gap: 18rpx; }
.payment-rule-grid > view:last-child { border-bottom: 0; }
.payment-rule-grid > view > text:first-child { color: #8a8178; font-size: 20rpx; }
.payment-rule-grid > view > text:last-child { color: #4e4740; font-size: 21rpx; line-height: 1.55; }
.rule-card { display: grid; margin-top: 16rpx; padding: 20rpx; border-left: 5rpx solid #9c7442; border-radius: 0 14rpx 14rpx 0; background: #f5eee3; gap: 14rpx; }
.rule-card text { color: #66543d; font-size: 21rpx; line-height: 1.55; }
.blocked-copy { color: #8b3f34 !important; font-weight: 600; }
.loyalty-benefits__note { display: block; margin-top: 8rpx; color: #867968; font-size: 19rpx; line-height: 1.55; }
.loyalty-benefit-card { display: grid; margin-top: 14rpx; padding: 20rpx; border: 1rpx solid #d8c8ad; border-radius: 18rpx; background: linear-gradient(145deg, #fffaf0, #f4ead8); grid-template-columns: 94rpx 1fr; gap: 18rpx; }
.loyalty-benefit-card > view:first-child { display: grid; place-content: center; text-align: center; border-right: 1rpx solid #dccdb5; }
.loyalty-benefit-card > view:first-child text:first-child { color: #8a542c; font-size: 34rpx; font-weight: 800; }
.loyalty-benefit-card > view:first-child text:last-child { color: #9b8060; font-size: 18rpx; }
.loyalty-benefit-card > view:last-child { display: grid; align-content: center; gap: 6rpx; }
.loyalty-benefit-card > view:last-child > text:first-child { color: #3f3226; font-size: 23rpx; font-weight: 750; }
.loyalty-benefit-card > view:last-child > text { color: #766653; font-size: 19rpx; line-height: 1.45; }

.activity-package { display: flex; margin-top: 16rpx; padding: 18rpx; align-items: center; border: 1rpx solid #dfd8cf; border-radius: 18rpx; background: #fff; gap: 16rpx; }
.activity-package--selected { border-color: #315d46; background: #f2f8f4; box-shadow: inset 0 0 0 1rpx rgba(49, 93, 70, .12); }
.activity-package--disabled { opacity: .58; }
.activity-package > view:first-child:not(.activity-package__main) { display: grid; flex: 1; gap: 5rpx; }
.activity-package > view:first-child:not(.activity-package__main) text:first-child, .activity-package__main > view text:first-child { color: #2e3f34; font-size: 24rpx; font-weight: 750; }
.activity-package > view:first-child:not(.activity-package__main) text:last-child, .activity-package__main > view text:last-child { color: #86613a; font-size: 20rpx; }
.activity-package > text:last-child { flex: 0 0 auto; color: #315d46; font-size: 20rpx; font-weight: 700; }
.activity-package__image { width: 104rpx; height: 104rpx; flex: 0 0 auto; border-radius: 12rpx; background: #e8e2d8; }
.activity-package__main { display: grid; min-width: 0; flex: 1; gap: 5rpx; }
.activity-package__main > view { display: flex; justify-content: space-between; gap: 10rpx; }
.activity-package__main > text { overflow: hidden; color: #776f66; font-size: 19rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }

.registration-panel { margin-top: 30rpx; padding: 26rpx; border: 1rpx solid #d8d1c8; border-radius: 22rpx; background: #fff; }
.party-row { display: flex; margin-bottom: 24rpx; align-items: center; justify-content: space-between; gap: 20rpx; }
.party-row > view:first-child { min-width: 0; flex: 1; }
.party-row > view:first-child text { display: block; }
.party-row > view:first-child text:first-child { font-size: 25rpx; font-weight: 700; }
.party-row > view:first-child text:last-child { margin-top: 5rpx; color: #8b837b; font-size: 19rpx; }
.stepper { display: flex; flex: 0 0 auto; align-items: center; overflow: hidden; border: 1rpx solid #d4cdc4; border-radius: 999rpx; }
.stepper button { width: 44px; min-width: 44px; height: 44px; margin: 0; padding: 0; border: 0; background: #fff; font-size: 28rpx; line-height: 44px; }
.stepper button::after { border: 0; }
.stepper text { width: 54rpx; text-align: center; font-size: 24rpx; }
.preview-party-size { display: grid; flex: 0 0 auto; color: #315d46; text-align: right; gap: 4rpx; }
.preview-party-size text:first-child { font-size: 24rpx; font-weight: 700; }
.preview-party-size text:last-child { color: #8a8178; font-size: 18rpx; }
.registration-panel .field__input { min-height: 44px; }
.registration-contact { display: block; margin-top: 4rpx; padding: 16rpx; border: 1rpx solid transparent; border-radius: 16rpx; transition: background .2s ease, border-color .2s ease; }
.registration-contact--attention { border-color: #b67a42; background: #fff8ef; box-shadow: 0 0 0 4rpx rgba(182, 122, 66, .12); }
.registration-contact__note, .registration-contact__hint { display: block; }
.registration-contact__note { margin-top: 9rpx; color: #8a8178; font-size: 19rpx; line-height: 1.45; }
.registration-contact__hint { margin-top: 8rpx; color: #8a4b25; font-size: 20rpx; font-weight: 650; }
.ack-row { display: flex; min-height: 44px; padding: 12rpx 0; align-items: center; gap: 14rpx; }
.ack-row checkbox { flex: 0 0 auto; }
.ack-row text { color: #605a53; font-size: 21rpx; line-height: 1.55; }
.ack-row--attention { margin-top: 12rpx; padding: 16rpx; border: 1rpx solid #b67a42; border-radius: 16rpx; background: #fff8ef; box-shadow: 0 0 0 4rpx rgba(182, 122, 66, .12); }

.registration-status { display: grid; margin-top: 28rpx; padding: 24rpx; border-left: 6rpx solid #8b693e; border-radius: 0 16rpx 16rpx 0; background: #f5eee3; gap: 10rpx; }
.registration-status__head { display: flex; align-items: baseline; justify-content: space-between; gap: 18rpx; }
.registration-status__head text:first-child { color: #3d342b; font-size: 25rpx; font-weight: 700; }
.registration-status__head text:last-child { color: #7c5b35; font-size: 21rpx; font-weight: 650; text-align: right; }
.registration-status > text { color: #786951; font-size: 20rpx; line-height: 1.55; }
.registration-status .registration-state-guide { color: #365f4a; font-weight: 650; }
.registration-status .refund-state { color: #79502f; font-weight: 650; }
.status-secondary { min-height: 44px; margin: 10rpx 0 0; border: 1rpx solid #b9a98f; border-radius: 999rpx; background: transparent; color: #694f34; font-size: 22rpx; line-height: 44px; }
.status-secondary::after { border: 0; }

.detail-bottom-space { height: 40rpx; }
.detail-dock {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  align-items: center;
  border-top: 1rpx solid #d7d1c8;
  background: #fff;
  box-shadow: 0 -10rpx 30rpx rgba(20, 17, 14, .1);
  gap: 18rpx;
}
.detail-dock > view { min-width: 0; flex: 1; }
.detail-dock > view text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.detail-dock > view text:first-child { font-size: 27rpx; font-weight: 750; }
.detail-dock > view text:last-child { margin-top: 4rpx; color: #827a71; font-size: 19rpx; }
.detail-dock > button { width: 280rpx; min-height: 44px; margin: 0; padding: 0 20rpx; border-radius: 999rpx; background: #873e30; color: #fff; font-size: 25rpx; line-height: 44px; }
.detail-dock > button.payment-button { background: linear-gradient(145deg, #315d46, #214635); box-shadow: 0 10rpx 24rpx rgba(35, 78, 58, .2); }
.detail-dock > button::after { border: 0; }
.detail-dock > button.cancel-button { border: 1rpx solid #b8a58c; background: #fff; color: #664d31; }

.detail-member-mask { position: fixed; z-index: 100; inset: 0; display: flex; padding: 0; align-items: flex-end; background: rgba(9, 19, 13, .66); backdrop-filter: blur(8rpx); }
.detail-member-sheet { position: relative; width: 100%; max-height: calc(100vh - env(safe-area-inset-bottom)); padding: 46rpx 42rpx calc(34rpx + env(safe-area-inset-bottom)); overflow-y: auto; border-radius: 32rpx 32rpx 0 0; background: #fffefb; box-shadow: 0 -18rpx 56rpx rgba(0, 0, 0, .22); box-sizing: border-box; text-align: center; }
.detail-member-close { position: absolute; z-index: 1; top: 20rpx; right: 24rpx; width: 96rpx; min-width: 96rpx; height: 96rpx; min-height: 96rpx; margin: 0; padding: 0; border: 0; border-radius: 50%; background: rgba(43, 39, 34, .06); color: #79716a; font-size: 38rpx; line-height: 94rpx; }
.detail-member-close::after, .detail-member-authorize::after { border: 0; }
.detail-member-kicker, .detail-member-title, .detail-member-copy, .detail-member-note { display: block; }
.detail-member-kicker { color: #5a806a; font-size: 17rpx; font-weight: 700; letter-spacing: 3.5rpx; }
.detail-member-title { margin-top: 14rpx; color: #1e3829; font-family: "Songti SC", "STSong", serif; font-size: 42rpx; font-weight: 600; }
.detail-member-copy { margin-top: 14rpx; color: #706860; font-size: 22rpx; line-height: 1.6; }
.detail-member-logo { display: block; width: 108rpx; height: 108rpx; margin: 26rpx auto 20rpx; border: 1rpx solid rgba(49, 93, 70, .2); border-radius: 50%; background: #000; }
.detail-member-agreement { display: flex; min-height: 62rpx; align-items: flex-start; color: #675f57; font-size: 21rpx; line-height: 1.55; text-align: left; gap: 10rpx; }
.detail-member-agreement checkbox { flex: 0 0 auto; margin-top: 1rpx; transform: scale(.86); }
.detail-member-agreement .wx-checkbox-input { width: 34rpx; height: 34rpx; border: 1rpx solid #bdb5ac; border-radius: 50%; }
.detail-member-agreement .wx-checkbox-input.wx-checkbox-input-checked { border-color: #315d46; background: #315d46; }
.detail-member-agreement view { flex: 1; min-width: 0; }
.detail-member-terms { display: block; color: #315d46; }
.detail-member-authorize { width: 100%; min-height: 88rpx; margin: 24rpx 0 0; border: 1rpx solid #315d46; border-radius: 44rpx; background: #315d46; color: #fff; font-size: 24rpx; font-weight: 700; line-height: 88rpx; }
.detail-member-authorize--disabled { border-color: #c5c1ba; background: #c5c1ba; }
.detail-member-note { margin-top: 16rpx; color: #90877e; font-size: 18rpx; line-height: 1.55; }

@media (max-width: 390px) {
  .detail-hero { height: 450rpx; margin-right: -22rpx; margin-left: -22rpx; }
  .detail-title { right: 22rpx; left: 22rpx; }
  .detail-title text:nth-child(2) { font-size: 40rpx; }
  .payment-rule-grid > view { grid-template-columns: 108rpx 1fr; }
  .registration-panel { padding: 22rpx; }
  .detail-dock { padding-right: 18rpx; padding-left: 18rpx; gap: 12rpx; }
  .detail-dock > button { width: 230rpx; font-size: 23rpx; }
  .detail-member-sheet { padding-right: 22rpx; padding-left: 22rpx; }
}
@media (max-width: 360px) { .detail-hero { margin-right: -18rpx; margin-left: -18rpx; } .detail-title { right: 18rpx; left: 18rpx; } .detail-member-sheet { max-height: calc(100vh - 4px); padding-right: 18rpx; padding-left: 18rpx; } .detail-member-close { top: 14rpx; right: 18rpx; } }
