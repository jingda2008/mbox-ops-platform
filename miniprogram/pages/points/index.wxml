<view class="page points-page">
  <view class="points-head">
    <text class="eyebrow">M-BOX 会员</text>
    <text class="points-title">积分与成长值</text>
    <text class="points-copy">积分只兑换指定商品或权益，不抵现金；成长值仅用于会员等级。</text>
  </view>

  <state-panel wx:if="{{loading}}" type="loading" title="正在读取明细" />
  <view wx:elif="{{error}}" class="error-banner"><text>{{error}}</text><button bindtap="load">重新读取</button></view>
  <block wx:else>
    <view wx:if="{{membership}}" class="balance-card">
      <view><text>{{membership.pointsBalance}}</text><text>可用积分</text></view>
      <view><text>{{membership.growthValue}}</text><text>成长值</text></view>
      <text>{{membership.expiryText}}</text>
      <text wx:if="{{membership.debtText}}" class="balance-debt">{{membership.debtText}}</text>
    </view>
    <view wx:else class="empty-member"><text>当前身份还没有会员账户</text><button bindtap="openMembership">返回“我的”查看入会说明</button></view>

    <view wx:if="{{membership && processing.length}}" class="progress-card">
      <view class="progress-head"><text>处理进度</text><text>仅显示本人订单</text></view>
      <view wx:for="{{processing}}" wx:key="key" class="progress-row">
        <view class="progress-marker {{item.active ? 'is-active' : ''}}"></view>
        <view><text>{{item.title}}</text><text>{{item.message}}</text><text wx:if="{{item.referenceText}}">{{item.referenceText}} · {{item.updatedAt}}</text><text wx:else>{{item.updatedAt}}</text></view>
      </view>
    </view>

    <view wx:if="{{membership}}" class="ledger-tabs">
      <button class="{{tab === 'points' ? 'is-active' : ''}}" data-tab="points" bindtap="switchTab">积分明细</button>
      <button class="{{tab === 'growth' ? 'is-active' : ''}}" data-tab="growth" bindtap="switchTab">成长值明细</button>
    </view>

    <view wx:if="{{membership && tab === 'points'}}" class="ledger-list">
      <view wx:for="{{points}}" wx:key="id" class="ledger-row"><view><text>{{item.title}}</text><text>{{item.description}}</text><text wx:if="{{item.metaText}}">{{item.metaText}}</text><text>{{item.occurredAt}}</text></view><view><text class="{{item.positive ? 'positive' : 'negative'}}">{{item.amountText}}</text><text>{{item.balanceText}}</text></view></view>
      <state-panel wx:if="{{!points.length}}" type="empty" title="还没有积分记录" message="完成符合规则的付款后，积分会在这里显示" />
    </view>

    <view wx:if="{{membership && tab === 'growth'}}" class="ledger-list">
      <view wx:for="{{growth}}" wx:key="id" class="ledger-row"><view><text>{{item.title}}</text><text>{{item.description}}</text><text wx:if="{{item.metaText}}">{{item.metaText}}</text><text>{{item.occurredAt}}</text></view><view><text class="{{item.positive ? 'positive' : 'negative'}}">{{item.amountText}}</text><text>{{item.balanceText}}</text></view></view>
      <state-panel wx:if="{{!growth.length}}" type="empty" title="还没有成长值记录" message="成长值与可用积分分开计算" />
    </view>

    <view class="ledger-note"><text>记录说明</text><text>退款冲回、积分到期、审核补发、人工调整和兑换返还会使用不同名称，不会混成“消费积分”。如发现异常，请由店长发起核对，顾客不能自行填写补分金额。</text></view>
  </block>
</view>
