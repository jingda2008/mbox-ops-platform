<view class="page community-page">
  <view class="community-hero">
    <image class="community-hero__watermark" src="/assets/brand/superhigh-mark.png" mode="aspectFit" aria-hidden="true" />
    <view class="community-hero__brand">
      <image class="community-hero__badge" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" aria-label="M-BOX 标志" />
      <text>M-BOX</text>
    </view>
    <view class="community-hero__content">
      <image class="community-hero__logo" src="/assets/brand/superhigh-horizontal-clear.png" mode="widthFix" aria-label="超嗨" />
      <text class="community-hero__kicker">现场 · 朋友 · 城市</text>
      <text class="community-hero__title">超嗨部落</text>
      <text class="community-hero__copy">现场、朋友与城市活动，都在这里集合。</text>
    </view>
  </view>

  <state-panel wx:if="{{loading}}" type="loading" title="正在读取活动" />
  <block wx:else>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>
    <view wx:if="{{activities.length}}" class="activity-section-head">
      <view><text>本期活动</text></view>
    </view>
    <view wx:if="{{activities.length}}" class="activity-list">
      <view wx:for="{{activities}}" wx:key="publicId" class="activity-card" data-id="{{item.publicId}}" bindtap="openDetail" hover-class="activity-card--hover" role="button" aria-role="button">
        <view class="activity-art">
          <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="activity-placeholder">
            <image src="/assets/brand/superhigh-mark.png" mode="aspectFit" />
            <text>{{item.title}}</text>
          </view>
          <view class="activity-art__shade"></view>
          <view class="activity-art__top">
            <text>{{item.kindText}}</text>
            <text wx:if="{{item.registrationText}}">{{item.registrationText}}</text>
          </view>
        </view>
        <view class="activity-card__body">
          <text wx:if="{{item.sequenceText}}" class="activity-sequence">{{item.sequenceText}}</text>
          <text class="activity-title">{{item.title}}</text>
          <text wx:if="{{item.summary}}" class="activity-summary">{{item.summary}}</text>
          <text class="activity-date">{{item.dateText}} · {{item.assemblyLocation}}</text>
          <view class="activity-footer">
            <text wx:if="{{item.paymentStateText}}" class="activity-payment-state">{{item.paymentStateText}}</text>
            <text class="activity-fee">{{item.feeText}}</text>
            <text>详情 →</text>
          </view>
        </view>
      </view>
    </view>
    <state-panel wx:else type="empty" title="下一场正在准备" message="新活动会第一时间出现在这里" />
  </block>

  <view wx:if="{{membershipInviteVisible}}" class="community-member-mask">
    <scroll-view scroll-y="true" class="community-member-sheet">
      <button class="community-member-close compact-icon-action" aria-label="关闭会员邀请" bindtap="dismissMembershipInvite">×</button>
      <text class="community-member-kicker">M-BOX 会员</text>
      <text class="community-member-title">加入会员，解锁超嗨活动</text>
      <text class="community-member-copy">加入会员后即可查看活动详情并报名。</text>
      <image class="community-member-logo" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" aria-label="M-BOX 标志" />
      <checkbox-group bindchange="onMembershipInviteAgreementChange">
        <label class="community-member-agreement">
          <checkbox value="agree" checked="{{membershipInviteAgreed}}" color="#315d46" />
          <view><text>我已阅读并同意</text><text class="community-member-terms" catchtap="showMembershipTerms">《{{membershipTerms.title}}》</text></view>
        </label>
      </checkbox-group>
      <button wx:if="{{membershipInviteAgreed}}" class="community-member-authorize wx-phone-button" open-type="getPhoneNumber" bindgetphonenumber="acceptMembershipInvite" loading="{{membershipInviteBusy}}">授权手机号并加入</button>
      <button wx:else class="community-member-authorize community-member-authorize--disabled" bindtap="remindMembershipInviteAgreement">授权手机号并加入</button>
      <text class="community-member-note">授权仅用于建立会员身份和活动服务联系。</text>
    </scroll-view>
  </view>
</view>
