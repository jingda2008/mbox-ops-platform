<view class="page order-page">
  <view class="order-head">
    <view><text class="eyebrow">M-BOX · 今晚点单</text><text class="order-title">今晚点单</text></view>
    <button wx:if="{{connectionState === 'active'}}" class="service-entry" bindtap="openService">需要服务</button>
  </view>

  <state-panel wx:if="{{loading}}" type="loading" title="正在确认桌次与菜单" />

  <view wx:elif="{{connectionState === 'needs_scan' || connectionState === 'waiting' || connectionState === 'upgrade_required'}}" class="gate-wrap">
    <view wx:if="{{connectionState === 'waiting'}}" class="browse-intro">
      <view class="waiting-pulse"><view></view></view>
      <view class="browse-intro__copy">
        <text class="gate-kicker">{{table.displayName}}</text><text class="gate-title">请联系服务人员开台</text>
        <text class="gate-copy">{{connectionMessage}}</text>
      </view>
      <button class="secondary-button gate-button" bindtap="retryTable">刷新开台状态</button>
      <text class="gate-note">等待期间可以先查看今晚真实菜单</text>
    </view>
    <view wx:elif="{{connectionState === 'upgrade_required'}}" class="browse-intro">
      <view class="browse-intro__copy">
        <text class="gate-kicker">{{table.displayName}}</text><text class="gate-title">本桌正在完成旧版点单</text>
        <text class="gate-copy">{{connectionMessage}}</text>
      </view>
      <button class="secondary-button gate-button" bindtap="retryTable">结台后重新扫码</button>
      <text class="gate-note">你可以先查看今晚菜单</text>
    </view>
    <view wx:else class="browse-intro">
      <image class="gate-logo" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" aria-label="M-BOX 标志" />
      <view class="browse-intro__copy">
        <text class="gate-kicker">M-BOX · 今晚菜单</text><text class="gate-title">先看今晚，再决定怎么喝</text>
        <text class="gate-copy">先慢慢看；到店扫码后就能下单付款。</text>
      </view>
      <button class="primary-button gate-button" bindtap="scanTable">到店扫码点单</button>
      <text class="gate-note">随便看看也完全可以</text>
    </view>
    <view wx:if="{{error}}" class="error-banner gate-error">{{error}}</view>

    <view class="browse-menu">
      <view class="browse-menu__heading"><view><text>今晚菜单</text><text>价格透明 · {{connectionState === 'waiting' ? '开台后按实时库存下单' : '到店后按实时库存下单'}}</text></view><text>{{visibleProducts.length}} 款</text></view>
      <view class="menu-tools menu-tools--browse">
        <view class="search-box"><text>⌕</text><input value="{{searchText}}" placeholder="搜索酒水、套餐或口味" bindinput="onSearchInput" /></view>
        <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="category-scroll"><view class="category-row"><button wx:for="{{categories}}" wx:key="code" class="{{selectedCategory === item.code ? 'is-active' : ''}}" data-code="{{item.code}}" bindtap="selectCategory">{{item.name}}</button></view></scroll-view>
      </view>
      <view wx:if="{{visibleProducts.length}}" class="product-list product-list--browse">
        <view wx:for="{{visibleProducts}}" wx:key="productId" class="product-row {{item.available ? '' : 'is-unavailable'}}">
          <view class="product-media">
            <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
            <view wx:else class="product-media__placeholder"><text>M-BOX</text></view>
          </view>
          <view class="product-main"><text class="product-kind">{{item.productKind === 'bundle' ? '体验组合' : item.categoryName}}</text><text class="product-name">{{item.name}}</text><text class="product-copy">{{item.description || item.includedText || '详情以当晚正式菜单为准'}}</text></view>
          <view class="product-action"><text class="product-price">{{item.priceText}}</text><text class="product-availability {{item.available ? 'is-available' : 'is-unavailable'}}">{{item.availabilityText}}</text><text class="product-availability-copy">{{item.available ? (connectionState === 'waiting' ? '服务人员开台后可下单' : '到店扫码后可下单') : item.availabilityDetail}}</text></view>
        </view>
      </view>
      <state-panel wx:else type="empty" title="没有找到符合条件的商品" message="可清空搜索或切换分类" />
    </view>
  </view>

  <block wx:else>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>
    <view wx:if="{{success}}" class="success-banner">{{success}}</view>
    <view wx:if="{{cartWritesFrozen}}" class="error-banner">服务人员正在核对本桌点单，暂时只能查看；完成后会恢复修改。</view>

    <view class="table-strip">
      <view><text class="table-strip__label">当前桌位</text><text class="table-strip__value">{{table.displayName}}</text></view>
      <view class="service-name"><text>本桌服务</text><text>{{serviceStaffName}}</text></view>
      <view wx:if="{{performance}}" class="show-brief"><text>{{performance.state}}</text><text>{{performance.name}} · {{performance.time}}</text></view>
      <button bindtap="openStatus">进度</button>
    </view>

    <view wx:if="{{pendingPayment}}" class="payment-recovery">
      <view><text>{{pendingPayment.statusText}}</text><text>应付 {{pendingPayment.amountText}}</text></view>
      <button wx:if="{{pendingPayment.canContinue}}" bindtap="continuePayment" loading="{{busy}}">继续付款</button>
      <button bindtap="openAccount">查看本桌账单</button>
    </view>

    <view wx:if="{{checkoutLocked && !pendingPayment}}" class="checkout-recovery">
      <view><text>正在确认你的选择</text><text>稍等片刻，或再试一次</text></view>
      <button bindtap="retryCheckout" loading="{{busy}}">再试一次</button>
      <button bindtap="openAccount">先看账单</button>
    </view>

    <view wx:if="{{membershipInviteVisible}}" class="membership-invite">
      <view class="membership-invite__copy"><text>加入 M-BOX 会员</text><text>{{membershipTerms.summary}}</text></view>
      <view class="membership-invite__actions"><button bindtap="enrollFromMenu" loading="{{membershipBusy}}">加入会员</button><button bindtap="dismissMembershipInvite">稍后再说</button></view>
      <button class="membership-invite__recovery" bindtap="openMembershipRecovery">我已是会员</button>
      <button class="membership-invite__privacy" bindtap="showMembershipTerms">查看会员权益说明</button>
    </view>

    <view class="recommend-entry">
      <view class="recommend-entry__copy"><text>需要一点灵感？</text><text>选个场景，给你几组适合今晚的搭配。</text></view>
      <view class="decision-row">
        <picker mode="selector" range="{{occasionOptions}}" range-key="name" value="{{occasionIndex}}" bindchange="onOccasionChange"><view><text>今晚</text><text>{{occasionOptions[occasionIndex].name}}</text></view></picker>
        <picker mode="selector" range="{{alcoholOptions}}" range-key="name" value="{{alcoholIndex}}" bindchange="onAlcoholChange"><view><text>偏好</text><text>{{alcoholOptions[alcoholIndex].name}}</text></view></picker>
        <button bindtap="recommend" loading="{{busy}}">帮我选</button>
      </view>
    </view>

    <view wx:if="{{recommendations.length}}" class="section recommendation-section">
      <view class="section-title"><text>今晚推荐</text><text class="section-link">按你的选择</text></view>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="recommend-scroll"><view class="recommend-row">
        <view wx:for="{{recommendations}}" wx:key="productId" class="recommend-card">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="recommend-body"><text class="recommend-tier">{{item.tierText}}</text><text class="recommend-name">{{item.name}}</text><text class="recommend-reason">{{item.reason}}</text><text wx:if="{{item.savingsText}}" class="saving">{{item.savingsText}}</text><view class="recommend-foot"><text class="recommend-price">{{item.priceText}}</text><view class="recommend-actions" style="display:flex;align-items:center;gap:8rpx"><button class="recommend-reject" style="display:flex;width:auto;min-width:112rpx;min-height:88rpx;margin:0;padding:0 14rpx;align-items:center;justify-content:center;border:1rpx solid #d2cbc1;border-radius:44rpx;background:transparent;color:#756d64;font-size:21rpx;line-height:1" data-id="{{item.productId}}" bindtap="rejectRecommendation" loading="{{item.rejecting}}" disabled="{{item.rejecting}}">不合适</button><button class="recommend-select" style="display:flex;width:auto;min-width:100rpx;min-height:88rpx;margin:0;padding:0 16rpx;align-items:center;justify-content:center;border-radius:44rpx;background:#315d46;color:#fff;font-size:21rpx;line-height:1" data-id="{{item.productId}}" data-source="recommendation" bindtap="addProduct">选择</button></view></view></view>
        </view>
      </view></scroll-view>
    </view>

    <view class="menu-tools">
      <view class="search-box"><text>⌕</text><input value="{{searchText}}" placeholder="搜索酒水、套餐或口味" bindinput="onSearchInput" /></view>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="category-scroll"><view class="category-row"><button wx:for="{{categories}}" wx:key="code" class="{{selectedCategory === item.code ? 'is-active' : ''}}" data-code="{{item.code}}" bindtap="selectCategory">{{item.name}}</button></view></scroll-view>
    </view>

    <view class="section product-section">
      <view class="section-title"><text>菜单</text><text wx:if="{{benefitCount}}" class="section-link" bindtap="openBenefits">{{benefitCount}}项权益可用</text></view>
      <view wx:if="{{visibleProducts.length}}" class="product-list">
        <view wx:for="{{visibleProducts}}" wx:key="productId" class="product-row {{item.available ? '' : 'is-unavailable'}}">
          <view class="product-media">
            <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
            <view wx:else class="product-media__placeholder"><text>M-BOX</text></view>
          </view>
          <view class="product-main"><text class="product-kind">{{item.productKind === 'bundle' ? '体验组合' : item.categoryName}}</text><text class="product-name">{{item.name}}</text><text class="product-copy">{{item.description || item.includedText || '详情以当晚正式菜单为准'}}</text></view>
          <view class="product-action"><text class="product-price">{{item.priceText}}</text><text class="product-availability {{item.available ? 'is-available' : 'is-unavailable'}}">{{item.availabilityText}}</text><button wx:if="{{item.available}}" aria-label="添加{{item.name}}" data-id="{{item.productId}}" bindtap="addProduct">＋</button><button wx:else class="product-unavailable" disabled="{{true}}">{{item.availabilityDetail}}</button></view>
        </view>
      </view>
      <state-panel wx:else type="empty" title="没有找到符合条件的商品" message="可清空搜索或切换分类" />
    </view>
    <view wx:if="{{!cart.length}}" class="shared-cart-empty">
      <text>本桌共享购物车</text><text>还没有商品；同桌每位顾客加入的商品都会在这里同步显示。</text>
    </view>
  </block>

  <view wx:if="{{connectionState === 'active' && cart.length}}" class="cart-dock">
      <view class="cart-summary"><view><text>本桌共享购物车 · {{cartCount}}件 · {{cartTotal}}</text><text>{{cartWritesFrozen ? '服务人员核对中 · 当前只读' : cartSyncing ? '正在同步同桌选择' : '同桌顾客可共同查看和调整'}}</text></view><view class="cart-summary__actions"><button class="cart-clear" bindtap="clearCart" loading="{{clearingCart}}" disabled="{{cartSyncing || checkoutLocked || pendingPayment || cartWritesFrozen}}">清空</button><button class="checkout-button" bindtap="openCheckout" loading="{{busy}}" disabled="{{cartSyncing || cartWritesFrozen}}">确认并付款</button></view></view>
    <scroll-view scroll-y class="cart-lines"><view wx:for="{{cart}}" wx:key="productId"><view><text>{{item.name}}</text><text>{{item.priceText}} × {{item.quantity}} · 小计 {{item.subtotalText}}</text><text wx:if="{{!item.available}}" class="cart-line__unavailable">{{item.unavailableReason}}</text></view><view><button aria-label="移除{{item.name}}" data-id="{{item.productId}}" bindtap="removeCartLine" disabled="{{cartSyncing || cartWritesFrozen}}">移除</button><button data-id="{{item.productId}}" data-delta="-1" bindtap="changeQuantity" disabled="{{cartSyncing || cartWritesFrozen}}">−</button><text>{{item.quantity}}</text><button data-id="{{item.productId}}" data-delta="1" bindtap="changeQuantity" disabled="{{cartSyncing || cartWritesFrozen || !item.available}}">＋</button></view></view></scroll-view>
  </view>

  <view wx:if="{{upgradeOffer}}" class="sheet-mask"><view class="upgrade-sheet">
    <view class="sheet-handle"></view><text class="eyebrow">付款前选择 · 可跳过</text><text class="upgrade-title">{{upgradeOffer.prompt.title}}</text><text class="upgrade-copy">{{upgradeOffer.prompt.body}}</text>
    <view class="upgrade-price"><text>当前 {{upgradeOffer.sourceProduct.name}}</text><text class="upgrade-add">再加 {{upgradeAdd}}</text><text>升级后总价 {{targetTotal}}</text></view>
    <view class="included-list"><view wx:for="{{upgradeOffer.targetExperience.included}}" wx:key="*this"><text>✓</text><text>{{item}}</text></view></view>
    <button class="primary-button" bindtap="acceptUpgrade">{{upgradeOffer.prompt.callToAction}}</button><button class="secondary-button" bindtap="declineUpgrade">保持现在这样</button>
  </view></view>
</view>
