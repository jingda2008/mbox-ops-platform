<view class="page status-page">
  <view class="status-head"><text class="eyebrow">{{tableCode}} · SERVICE STATUS</text><text class="status-title">处理进度</text><text class="status-copy">{{live ? '接单、到桌和完成状态会自动更新' : '当前展示本机最近记录'}}</text></view>
  <state-panel wx:if="{{loading}}" type="loading" title="正在同步最新状态" />
  <block wx:else>
    <view wx:if="{{error}}" class="warning">{{error}}</view><view wx:if="{{success}}" class="success-banner">{{success}}</view>
    <view wx:if="{{tasks.length}}" class="status-list">
      <view wx:for="{{tasks}}" wx:key="publicId" class="status-card">
        <view class="status-card__head"><view><text class="status-card__name">{{item.name}}</text><text class="status-card__time">{{item.createdAtText}}</text></view><text class="status-chip status-chip--{{item.status}}">{{item.statusText}}</text></view>
        <text wx:if="{{item.detail}}" class="status-detail">{{item.detail}}</text><text class="status-owner">{{item.ownerText}}</text><text wx:if="{{item.requestCountText}}" class="status-owner">{{item.requestCountText}}</text>
        <view wx:if="{{live && (item.canConfirm || item.canEscalate)}}" class="feedback-actions" style="grid-template-columns:1fr"><button wx:if="{{item.canConfirm}}" data-id="{{item.publicId}}" data-action="confirm" disabled="{{feedbackTaskId}}" bindtap="submitFeedback">已经解决</button><button wx:if="{{item.canEscalate}}" data-id="{{item.publicId}}" data-action="escalate" disabled="{{feedbackTaskId}}" bindtap="submitFeedback">仍未解决，催办</button></view>
      </view>
    </view>
    <state-panel wx:else type="empty" title="暂无服务记录" message="提交桌边服务后，处理状态会出现在这里" />
    <button class="primary-button new-service" bindtap="openService">发起桌边服务</button>
  </block>
</view>
