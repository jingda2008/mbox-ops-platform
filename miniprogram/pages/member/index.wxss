.member-band { margin-bottom: 0; }
.member-card { display: flex; margin-top: -2rpx; align-items: center; gap: 20rpx; border-top-left-radius: 0; border-top-right-radius: 0; }
.member-avatar { display: flex; width: 78rpx; height: 78rpx; align-items: center; justify-content: center; border-radius: 50%; background: #202328; color: #ffffff; font-size: 31rpx; font-weight: 700; }
.member-main { min-width: 0; flex: 1; }
.member-main text { display: block; }
.member-main text:first-child { color: #9a7130; font-size: 21rpx; font-weight: 700; }
.member-main text:nth-child(2) { margin-top: 5rpx; font-size: 31rpx; font-weight: 750; }
.member-main text:last-child { margin-top: 4rpx; color: #737b86; font-size: 22rpx; }
.member-count { color: #1e513c; font-size: 31rpx; font-weight: 750; text-align: right; }
.member-count text { display: block; margin-top: 3rpx; color: #737b86; font-size: 19rpx; font-weight: 400; }
.member-binding { display: grid; margin-top: 18rpx; grid-template-columns: 1fr 1fr; border: 1rpx solid #dfe2e7; border-radius: 8rpx; background: #ffffff; }
.member-binding view { padding: 20rpx; text-align: center; border-right: 1rpx solid #e7e9ed; }
.member-binding view:last-child { border-right: 0; }
.member-binding text { display: block; }
.member-binding text:first-child { color: #25282e; font-size: 25rpx; font-weight: 700; }
.member-binding text:last-child { margin-top: 5rpx; color: #737b86; font-size: 20rpx; }
.benefit-kind { display: flex; width: 58rpx; height: 58rpx; flex: 0 0 auto; align-items: center; justify-content: center; border-radius: 6rpx; background: #f3ead7; color: #835f22; font-size: 23rpx; font-weight: 700; }
.benefit-date { display: block; margin-top: 9rpx; color: #1e6245; font-size: 21rpx; }
.benefit-quantity { font-size: 27rpx; font-weight: 750; }
.member-boundary { margin-top: 26rpx; }
