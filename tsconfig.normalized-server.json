{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.normalized-server.tsbuildinfo",
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-normalized",
    "rootDir": ".",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": [
    "server/normalized-server.ts",
    "server/migrate-normalized.ts",
    "server/provision-normalized-store.ts",
    "server/provision-normalized-catalog.ts",
    "server/provision-normalized-release.ts",
    "server/verify-normalized-commercial-readiness.ts",
    "server/verify-normalized-runtime-config.ts",
    "server/verify-normalized-migration-compatibility.ts",
    "server/normalized/generate-table-qrs.ts"
  ]
}
