.profile-contact-page {
  min-height: 100vh;
  padding: 0 28rpx 52rpx;
  background: #f7f4ef;
  box-sizing: border-box;
}
.contact-hero {
  display: flex;
  margin: 0 -28rpx 30rpx;
  padding: 36rpx 28rpx 40rpx;
  flex-direction: column;
  gap: 10rpx;
  background:
    radial-gradient(circle at 90% 5%, rgba(198, 163, 105, 0.26), transparent 34%),
    linear-gradient(145deg, #0d1712, #234031 66%, #101512);
  color: #fff;
}
.contact-hero text:first-child {
  color: #c8a675;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.contact-hero text:nth-child(2) {
  margin-top: 8rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.contact-hero text:last-child {
  margin-top: 6rpx;
  color: #d2cec8;
  font-size: 24rpx;
  line-height: 1.55;
}

.contact-actions {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
  gap: 16rpx;
}
.contact-action {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  max-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 44rpx;
  background: #315d46;
  color: #fffdf8;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
}
.contact-action::after { border: 0; }
.contact-action--hover { opacity: 0.88; }

.contact-phone-hint {
  display: block;
  margin: 0 0 24rpx;
  color: #748077;
  font-size: 22rpx;
  text-align: center;
  letter-spacing: 0.5rpx;
}

.wecom-card {
  display: flex;
  margin-bottom: 20rpx;
  padding: 30rpx;
  align-items: center;
  gap: 24rpx;
  border: 1rpx solid #ddd6cb;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(33, 27, 22, 0.06);
}
.wecom-card image {
  width: 174rpx;
  height: 174rpx;
  padding: 8rpx;
  border: 1rpx solid #e3e8e2;
  border-radius: 16rpx;
  background: #fff;
}
.wecom-card view { flex: 1; }
.wecom-card text { display: block; }
.wecom-card text:first-child {
  color: #211e1a;
  font-size: 28rpx;
  font-weight: 700;
}
.wecom-card text:last-child {
  margin-top: 10rpx;
  color: #748077;
  font-size: 22rpx;
  line-height: 1.55;
}
.contact-boundary {
  display: block;
  padding: 8rpx 12rpx;
  color: #879087;
  font-size: 20rpx;
  line-height: 1.6;
}
.error-banner {
  margin: 0 0 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #fdeeee;
  color: #a14545;
  font-size: 22rpx;
}
@media (max-width: 360px) {
  .profile-contact-page { padding-right: 18rpx; padding-left: 18rpx; }
  .contact-hero { margin-right: -18rpx; margin-left: -18rpx; padding-right: 18rpx; padding-left: 18rpx; }
  .contact-hero text:nth-child(2) { font-size: 40rpx; }
  .contact-action { height: 44px; min-height: 44px; max-height: 44px; font-size: 25rpx; line-height: 44px; }
  .wecom-card { padding: 20rpx; gap: 18rpx; }
  .wecom-card image { width: 148rpx; height: 148rpx; }
  .wecom-card text:first-child { font-size: 25rpx; }
}
