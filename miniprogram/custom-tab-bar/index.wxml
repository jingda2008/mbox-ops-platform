<view class="tab-bar" style="padding-bottom: {{safeBottom}}px">
  <block wx:for="{{tabs}}" wx:key="path">
    <button class="tab-item {{selected === index ? 'is-selected' : ''}}" data-index="{{index}}" bindtap="switchTab" aria-label="{{item.text}}">
      <image src="/assets/tabbar/{{item.icon}}{{selected === index ? '-active' : ''}}.png" /><text>{{item.text}}</text>
    </button>
  </block>
</view>
