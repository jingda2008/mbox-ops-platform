<view class="page home-page">
  <view class="home-hero">
    <view class="brand-row">
      <view class="brand"><image class="brand-logo" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" aria-label="M-BOX Logo" /><text>M-BOX</text></view>
      <text wx:if="{{isDevelopment}}" class="dev-badge">开发模式</text>
    </view>
    <view class="hero-content">
      <text class="hero-kicker">LIVE MUSIC · SOCIAL NIGHT</text>
      <text class="hero-title">{{visitState === 'active' ? table.displayName : visitState === 'waiting' ? table.displayName : '今晚，刚刚好'}}</text>
      <text class="hero-copy">{{visitState === 'active' ? ('本桌已连接 · ' + serviceOwner) : visitState === 'waiting' ? '桌码已识别，开台后菜单会自动出现' : '现场音乐、精心酒水与刚好的相遇'}}</text>
    </view>
  </view>

  <state-panel wx:if="{{loading}}" type="loading" title="正在准备今晚" />
  <block wx:else>
    <view wx:if="{{warning}}" class="warning">{{warning}}</view>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>

    <view wx:if="{{visitState === 'waiting'}}" class="state-card state-card--waiting">
      <view class="state-card__icon">···</view>
      <view class="state-card__body"><text class="state-card__eyebrow">等待开台</text><text class="state-card__title">{{table.displayName}}</text><text class="state-card__copy">{{connectionMessage}}</text></view>
      <button class="state-card__action" bindtap="retryTable">刷新</button>
    </view>

    <block wx:elif="{{visitState === 'active'}}">
      <view class="onsite-summary">
        <view><text class="summary-value">{{table.displayName}}</text><text class="summary-label">当前桌位</text></view>
        <view><text class="summary-value">{{guestCountText}}</text><text class="summary-label">本桌人数</text></view>
        <view><text class="summary-value">{{serviceOwner}}</text><text class="summary-label">服务负责</text></view>
      </view>

      <button class="primary-experience" data-url="/pages/order/index" bindtap="openTab">
        <view><text class="primary-experience__kicker">今晚从这里开始</text><text class="primary-experience__title">今晚菜单与点单</text><text class="primary-experience__copy">实时库存、清晰价格与舒适选择</text></view>
        <text class="primary-experience__arrow">→</text>
      </button>

      <view class="section live-section">
        <view class="section-title"><text>今晚现场</text><text class="section-link">{{performance ? performance.stateText : '当晚动态'}}</text></view>
        <view class="performance-compact {{performance && performance.stateText === '正在演出' ? 'is-live' : ''}}" bindtap="openTonightSchedule" hover-class="button-hover" role="button" aria-role="button">
          <image wx:if="{{performance && performance.imageUrl}}" src="{{performance.imageUrl}}" mode="aspectFill" />
          <view class="performance-compact__shade"></view>
          <view class="performance-compact__content">
            <text class="performance-compact__state">{{performance ? performance.summary : 'TONIGHT'}}</text>
            <text class="performance-compact__name">{{performance && performance.hasSchedule ? performance.performer : '今晚演出安排'}}</text>
            <view class="performance-compact__footer">
              <text class="performance-compact__time">{{performance && performance.hasSchedule ? performance.timeText : '当晚暂无已发布场次'}}</text>
              <text class="performance-compact__action">整晚安排 →</text>
            </view>
          </view>
        </view>
        <view class="performance-shortcuts">
          <view class="performance-shortcut" bindtap="openPerformerProfile" hover-class="button-hover" role="button" aria-role="button">
            <text class="performance-shortcut__kicker">ARTIST</text>
            <text class="performance-shortcut__title">{{performance && performance.hasSchedule ? performance.performer : '乐队与歌手'}}</text>
            <text class="performance-shortcut__copy">{{performance && performance.tags ? performance.tags : '认识今晚舞台阵容'}}</text>
          </view>
          <view class="performance-shortcut" bindtap="openMonthlyPerformance" hover-class="button-hover" role="button" aria-role="button">
            <text class="performance-shortcut__kicker">MONTHLY</text>
            <text class="performance-shortcut__title">{{monthlyPerformanceCard.title || '当月演出'}}</text>
            <text class="performance-shortcut__copy">{{monthlyPerformanceCard.summary || '按日期查看演出场次'}}</text>
          </view>
        </view>
      </view>

      <view class="section compact-section">
        <view class="section-title"><text>本桌快捷服务</text><text class="section-link">状态实时同步</text></view>
        <view class="action-grid">
          <button data-url="/pages/service/index" bindtap="openPage"><text class="action-icon">水</text><text>桌边服务</text></button>
          <button data-url="/pages/status/index" bindtap="openPage"><text class="action-icon">进</text><text>处理进度</text></button>
          <button data-url="/pages/songs/index" bindtap="openPage"><text class="action-icon">歌</text><text>现场点歌</text></button>
          <button data-url="/pages/account/index" bindtap="openPage"><text class="action-icon">账</text><text>订单桌账</text></button>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="section live-section">
        <view class="section-title"><text>今晚现场</text><text class="section-link">{{performance ? performance.stateText : '当晚动态'}}</text></view>
        <view class="performance-compact {{performance && performance.stateText === '正在演出' ? 'is-live' : ''}}" bindtap="openTonightSchedule" hover-class="button-hover" role="button" aria-role="button">
          <image wx:if="{{performance && performance.imageUrl}}" src="{{performance.imageUrl}}" mode="aspectFill" />
          <view class="performance-compact__shade"></view>
          <view class="performance-compact__content">
            <text class="performance-compact__state">{{performance ? performance.summary : 'TONIGHT'}}</text>
            <text class="performance-compact__name">{{performance && performance.hasSchedule ? performance.performer : '今晚演出安排'}}</text>
            <view class="performance-compact__footer">
              <text class="performance-compact__time">{{performance && performance.hasSchedule ? performance.timeText : '当晚暂无已发布场次'}}</text>
              <text class="performance-compact__action">整晚安排 →</text>
            </view>
          </view>
        </view>
        <view class="performance-shortcuts">
          <view class="performance-shortcut" bindtap="openPerformerProfile" hover-class="button-hover" role="button" aria-role="button">
            <text class="performance-shortcut__kicker">ARTIST</text>
            <text class="performance-shortcut__title">{{performance && performance.hasSchedule ? performance.performer : '乐队与歌手'}}</text>
            <text class="performance-shortcut__copy">{{performance && performance.tags ? performance.tags : '认识今晚舞台阵容'}}</text>
          </view>
          <view class="performance-shortcut" bindtap="openMonthlyPerformance" hover-class="button-hover" role="button" aria-role="button">
            <text class="performance-shortcut__kicker">MONTHLY</text>
            <text class="performance-shortcut__title">{{monthlyPerformanceCard.title || '当月演出'}}</text>
            <text class="performance-shortcut__copy">{{monthlyPerformanceCard.summary || '按日期查看演出场次'}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{upcomingReservation}}" class="state-card reservation-state">
        <view class="state-card__body"><text class="state-card__eyebrow">我的预约</text><text class="state-card__title">{{upcomingReservation.title}}</text><text class="state-card__copy">{{upcomingReservation.statusText}}</text></view>
        <button class="state-card__action" data-url="/pages/reservations/index" bindtap="openTab">查看</button>
      </view>
      <view wx:else class="state-card current-state">
        <view class="state-card__icon">⌁</view>
        <view class="state-card__body"><text class="state-card__eyebrow">当前状态</text><text class="state-card__title">尚未连接桌位</text><text class="state-card__copy">到店后从“点单”页扫描桌码，即可进入实时菜单和桌边服务。</text></view>
      </view>
    </block>

    <view wx:if="{{upcomingActivity || editorialCards.length}}" class="section home-editorial-section">
      <view class="section-title"><text>发现 M-BOX</text><text class="section-link">精选内容</text></view>
      <button wx:if="{{upcomingActivity}}" class="featured-activity-card" bindtap="openFeaturedActivity">
        <image wx:if="{{upcomingActivity.coverUrl}}" src="{{upcomingActivity.coverUrl}}" mode="aspectFill" />
        <view class="featured-activity-card__shade"></view>
        <view class="featured-activity-card__copy"><text>超嗨 · 本期精选</text><text>{{upcomingActivity.title}}</text><text>{{upcomingActivity.dateText}} · {{upcomingActivity.availabilityText}}</text><text>查看活动详情 →</text></view>
      </button>
      <button wx:for="{{editorialCards}}" wx:key="code" class="editorial-story-card" data-code="{{item.code}}" bindtap="openEditorial">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
        <image wx:else src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" />
        <view><text>{{item.eyebrow}}</text><text>{{item.title}}</text><text>{{item.summary}}</text><text>{{item.ctaLabel}} →</text></view>
      </button>
    </view>
  </block>

  <view wx:if="{{performancePanel}}" class="performance-panel-mask" bindtap="closePerformancePanel" catchtouchmove="noop">
    <view class="performance-panel" catchtap="noop">
      <view class="performance-panel__handle"></view>
      <view class="performance-panel__head"><view><text>{{performancePanel === 'tonight' ? 'TONIGHT AT M-BOX' : 'ARTIST PROFILE'}}</text><text>{{performancePanel === 'tonight' ? '整晚演出安排' : performance.performer}}</text></view><button bindtap="closePerformancePanel">×</button></view>
      <view wx:if="{{performancePanel === 'tonight'}}" class="performance-panel__schedule">
        <view wx:for="{{performance.schedules}}" wx:key="id" class="performance-schedule-row {{item.stateText === '正在演出' ? 'is-current' : ''}}"><view><text>{{item.stateText}}</text><text>{{item.timeText}}</text></view><view><text>{{item.performer}}</text><text>{{item.tags || '现场演出'}}</text></view></view>
      </view>
      <view wx:else class="performance-panel__artist"><image wx:if="{{performance.imageUrl}}" src="{{performance.imageUrl}}" mode="aspectFill" /><view><text>{{performance.performer}}</text><text>{{performance.tags || 'M-BOX 当晚舞台阵容'}}</text><text>{{performance.bio || '更多介绍由门店发布后展示。'}}</text></view></view>
      <text class="performance-panel__note">演出时间与阵容以门店当日已发布安排为准。</text>
    </view>
  </view>

  <view wx:if="{{homeCampaignVisible && homeCampaign}}" class="home-campaign-mask" catchtouchmove="noop">
    <view class="home-campaign-sheet">
      <button class="home-campaign-close" aria-label="关闭活动内容" bindtap="dismissHomeCampaign">×</button>
      <image wx:if="{{homeCampaign.imageUrl}}" class="home-campaign-image" src="{{homeCampaign.imageUrl}}" mode="aspectFill" />
      <image wx:else class="home-campaign-logo" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" />
      <text class="home-campaign-kicker">M-BOX · NOW SHOWING</text><text class="home-campaign-title">{{homeCampaign.title}}</text><text class="home-campaign-copy">{{homeCampaign.summary}}</text>
      <button wx:if="{{homeCampaign.hasTarget}}" class="home-campaign-cta" bindtap="openHomeCampaign">{{homeCampaign.ctaLabel}}</button>
      <button wx:else class="home-campaign-cta home-campaign-cta--quiet" bindtap="dismissHomeCampaign">知道了</button>
      <text class="home-campaign-note">此内容由门店后台发布，可随时暂停或更新。</text>
    </view>
  </view>

  <view wx:if="{{membershipInviteVisible}}" class="member-invite-mask" catchtouchmove="noop">
    <view class="member-invite-sheet">
      <button class="member-invite-close" aria-label="关闭会员邀请" bindtap="dismissMembershipInvite">×</button>
      <text class="member-invite-kicker">M-BOX MEMBERSHIP</text>
      <text class="member-invite-title">欢迎加入 M-BOX</text>
      <text class="member-invite-copy">加入后享积分、会员权益与活动资格。</text>
      <image class="member-invite-logo" src="/assets/brand/mbox-logo-badge.png" mode="aspectFit" aria-label="M-BOX Shanghai 1999 Logo" />
      <checkbox-group bindchange="onMembershipInviteAgreementChange">
        <label class="member-invite-agreement">
          <checkbox value="agree" checked="{{membershipInviteAgreed}}" color="#315d46" />
          <view class="member-invite-agreement-copy">
            <text>我已阅读并同意</text>
            <view class="member-invite-links">
              <text catchtap="showMembershipTerms">《{{membershipTerms.title}}》</text>
              <text catchtap="openPrivacy">《隐私政策》</text>
            </view>
          </view>
        </label>
      </checkbox-group>
      <view class="member-invite-actions">
        <button class="member-invite-refuse" bindtap="declineMembershipInvite">暂不加入</button>
        <button wx:if="{{membershipInviteAgreed}}" class="member-invite-agree wx-phone-button" open-type="getPhoneNumber|agreePrivacyAuthorization" bindgetphonenumber="acceptMembershipInvite" bindagreeprivacyauthorization="onAgreePrivacyAuthorization" hover-class="none" loading="{{membershipInviteBusy}}">同意入会</button>
        <button wx:else class="member-invite-agree member-invite-agree--pending" bindtap="remindMembershipInviteAgreement" hover-class="none">同意入会</button>
      </view>
    </view>
  </view>
</view>
